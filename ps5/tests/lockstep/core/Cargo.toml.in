# PSGopher lockstep harness: one core build (run-lockstep.sh writes it as core-@NAME@/Cargo.toml).
# The dependencies are the ones Gopher64's interpreter sources use, at Gopher64's versions
# (Cargo.lock comes from the candidate tree).
[package]
name = "lockstep-core-@NAME@"
version = "0.0.0"
edition = "2024"
publish = false

[lib]
path = "src/lib.rs"

[features]
gui = []

[dependencies]
zip = "9.0"
sevenz-rust2 = "0.25"
time = { version = "0.3", features = ["local-offset"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
serde-big-array = "0.5"
sha2 = "0.11"
tokio = { version = "1.46", features = ["rt", "sync", "fs"] }
spin_sleep = "1.3"
encoding_rs = "0.8"
regex = "1.11"
rustc-hash = "2.1"
rand = { version = "0.10", features = ["serde"] }
fatfs = "0.3"
postcard = { version = "1.1", features = ["use-std"] }
