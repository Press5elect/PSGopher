+/// The cartridge interrupt line, INT1 (n64brew: the 64DD's MECHA and BM interrupts)
+pub const COP0_CAUSE_IP3: u64 = 1 << 11;
+
+const IPL_SIZE: usize = 0x400000;
+const C2S_SIZE: usize = 0x400;
+const DS_SIZE: usize = 0x100;
+const MS_SIZE: usize = 0x40;
+const DD_PAGE: usize = 0x0500;
+const IPL_PAGE: usize = 0x0600;
+
+fn ares_clocks(clocks: u64) -> u64 {
+    clocks / 2
+}
