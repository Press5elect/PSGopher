+// SPDX-License-Identifier: GPL-3.0-or-later
+// Additional term (GPL-3.0 section 7(b)): keep the attribution "PSGopher by Press5elect"; see PSGopher's NOTICE.
+//! PSGopher (PS5): the entry point the title's `main` calls, and the PS5's folders.
+//!
+//! Everything else runs as on the desktop: `psgopher_main` parses the arguments the title passes
+//! and calls `run`, which plays the game named in them. Added by PSGopher's ps5.patch.
+
+use clap::Parser;
+
+/// The title's data folder on the console, which FTP also reaches (PSGopher's D8).
+pub const DATA_ROOT: &str = "/data/psgopher";
+
+pub fn dirs() -> crate::ui::Dirs {
+    let root = std::path::Path::new(DATA_ROOT);
+    crate::ui::Dirs {
+        config_dir: root.join("config"),
+        data_dir: root.join("data"),
+        cache_dir: root.join("cache"),
+    }
+}
+
+/// First boot: every pad the console has at start goes to the port of its player, with the
+/// default profile, through Gopher64's own assignment (D7). Ports keep what the owner set later.
+fn assign_pads() {
+    crate::ui::sdl_init(sdl3_sys::init::SDL_INIT_GAMEPAD);
+    let pads = crate::ui::input::get_joysticks().len();
+    let mut config = crate::ui::config::Config::new();
+    for port in 1..=pads.min(4) {
+        if config.input.controller_assignment[port - 1].is_none() {
+            crate::ui::input::assign_controller(&mut config, (port - 1) as i32, port);
+            config.input.controller_enabled[port - 1] = true;
+        }
+    }
+    // (Config is written when it is dropped)
+}
+
+/// The controller's hotkeys (Gopher64's: the Hotkey Activator held and another button), as the
+/// title sets them before each game (PSGOPHER_HOTKEYS, from psgopher.ini): on or off, and each
+/// action's N64 button (an input profile index) or none. Gopher64's six keep its buttons by default;
+/// the actions it has only on a keyboard are added, none by default.
+pub const HOTKEY_ACTIONS: [(&str, i32, i8); 15] = [
+    ("save", 1, crate::ui::input_profile::L_TRIG as i8),
+    ("load", 2, crate::ui::input_profile::R_TRIG as i8),
+    ("exit", 3, crate::ui::input_profile::START_BUTTON as i8),
+    ("ff", 4, crate::ui::input_profile::Z_TRIG as i8),
+    ("rewind", 5, crate::ui::input_profile::L_CBUTTON as i8),
+    ("pak", 0, crate::ui::input_profile::B_BUTTON as i8),
+    ("reset", 100, -1),
+    ("pause", 101, -1),
+    ("advance", 102, -1),
+    ("voldown", 103, -1),
+    ("volup", 104, -1),
+    ("fps", 105, -1),
+    ("crop", 106, -1),
+    ("slotnext", 107, -1),
+    ("slotprev", 108, -1),
+];
+static HOTKEYS_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+static HOTKEY_BUTTONS: [std::sync::atomic::AtomicI8; 15] = [const { std::sync::atomic::AtomicI8::new(-1) }; 15];
+
+/// Reads PSGOPHER_HOTKEYS ("on=1,save=13,..."): what it does not name keeps Gopher64's default.
+pub fn load_hotkeys() {
+    use std::sync::atomic::Ordering::Relaxed;
+    for (i, (_, _, default)) in HOTKEY_ACTIONS.iter().enumerate() {
+        HOTKEY_BUTTONS[i].store(*default, Relaxed);
+    }
+    HOTKEYS_ON.store(true, Relaxed);
+    let Ok(text) = std::env::var("PSGOPHER_HOTKEYS") else { return };
+    for pair in text.split(',') {
+        let Some((name, value)) = pair.split_once('=') else { continue };
+        let Ok(value) = value.trim().parse::<i32>() else { continue };
+        if name.trim() == "on" {
+            HOTKEYS_ON.store(value != 0, Relaxed);
+        } else if let Some(i) = HOTKEY_ACTIONS.iter().position(|a| a.0 == name.trim()) {
+            let button = if (0..crate::ui::input_profile::HOTKEY as i32).contains(&value) { value as i8 } else { -1 };
+            HOTKEY_BUTTONS[i].store(button, Relaxed);
+        }
+    }
+}
+
+pub fn hotkeys_on() -> bool {
+    HOTKEYS_ON.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+fn hotkey_button(i: usize) -> i8 {
+    HOTKEY_BUTTONS[i].load(std::sync::atomic::Ordering::Relaxed)
+}
+
+/// The Hotkey Activator is held: each action whose button went down now, as Gopher64's
+/// handle_hotkeys sends its events (the pak change is the input's own, pak_hotkey_pressed).
+pub fn handle_hotkeys(keys: u32, last_key_state: u32) {
+    for (i, (_, code, _)) in HOTKEY_ACTIONS.iter().enumerate() {
+        let button = hotkey_button(i);
+        if *code == 0 || button < 0 {
+            continue;
+        }
+        let bit = 1u32 << button;
+        if keys & bit != 0 && last_key_state & bit == 0 {
+            let mut event: sdl3_sys::events::SDL_Event = Default::default();
+            event.user.r#type = u32::from(sdl3_sys::events::SDL_EVENT_USER);
+            event.user.code = *code;
+            unsafe { sdl3_sys::events::SDL_PushEvent(&mut event) };
+        }
+    }
+}
+
+pub fn pak_hotkey_pressed(keys: u32) -> bool {
+    let button = hotkey_button(5);
+    button >= 0 && keys & (1u32 << button) != 0
+}
+
+/// Gopher64's settings by name, for the title's game list (ps5/host/menu.cpp): each read is
+/// config.json as it is now, each change is written back at once (Config writes itself when it
+/// is dropped), so the list and Gopher64 always agree and every change persists. The names are
+/// the JSON's own (`video.upscale`, `input.controller_enabled.2`); booleans are 0 and 1.
+fn setting<'a>(config: &'a mut crate::ui::config::Config, name: &str) -> Option<SettingRef<'a>> {
+    let indexed = |prefix: &str| -> Option<usize> {
+        name.strip_prefix(prefix)?.parse::<usize>().ok().filter(|i| *i < 4)
+    };
+    Some(match name {
+        "video.upscale" => SettingRef::Number(&mut config.video.upscale),
+        "video.ssaa" => SettingRef::Flag(&mut config.video.ssaa),
+        "video.integer_scaling" => SettingRef::Flag(&mut config.video.integer_scaling),
+        "video.widescreen" => SettingRef::Flag(&mut config.video.widescreen),
+        "video.vsync" => SettingRef::Flag(&mut config.video.vsync),
+        "video.crt" => SettingRef::Flag(&mut config.video.crt),
+        "video.fullscreen" => SettingRef::Flag(&mut config.video.fullscreen),
+        "emulation.overclock" => SettingRef::Flag(&mut config.emulation.overclock),
+        "emulation.disable_expansion_pak" => SettingRef::Flag(&mut config.emulation.disable_expansion_pak),
+        "emulation.usb" => SettingRef::Flag(&mut config.emulation.usb),
+        "emulation.rewind" => SettingRef::Flag(&mut config.emulation.rewind),
+        "input.emulate_vru" => SettingRef::Flag(&mut config.input.emulate_vru),
+        _ => {
+            if let Some(i) = indexed("input.controller_enabled.") {
+                SettingRef::Flag(&mut config.input.controller_enabled[i])
+            } else if let Some(i) = indexed("input.transfer_pak.") {
+                SettingRef::Flag(&mut config.input.transfer_pak[i])
+            } else {
+                return None;
+            }
+        }
+    })
+}
+
+enum SettingRef<'a> {
+    Flag(&'a mut bool),
+    Number(&'a mut u32),
+}
+
+fn setting_name(name: *const std::ffi::c_char) -> Option<String> {
+    if name.is_null() {
+        return None;
+    }
+    Some(unsafe { std::ffi::CStr::from_ptr(name) }.to_string_lossy().into_owned())
+}
+
+/// The setting's value, or -1 for a name Gopher64 has not.
+///
+/// # Safety
+/// `name` is a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_setting_get(name: *const std::ffi::c_char) -> i64 {
+    let Some(name) = setting_name(name) else { return -1 };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        match setting(&mut config, &name) {
+            Some(SettingRef::Flag(v)) => *v as i64,
+            Some(SettingRef::Number(v)) => *v as i64,
+            None => -1,
+        }
+    })
+    .unwrap_or(-1)
+}
+
+/// Sets it and writes config.json; false for a name Gopher64 has not or a value it does not take
+/// (the file is then written as it was).
+/// `video.upscale` takes Gopher64's own choices only (1, 2, 4, 8).
+///
+/// # Safety
+/// `name` is a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_setting_set(name: *const std::ffi::c_char, value: i64) -> bool {
+    let Some(name) = setting_name(name) else { return false };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        match setting(&mut config, &name) {
+            Some(SettingRef::Flag(v)) => *v = value != 0,
+            Some(SettingRef::Number(v)) if [1, 2, 4, 8].contains(&value) => *v = value as u32,
+            _ => return false,
+        }
+        true
+        // (written as config drops)
+    })
+    .unwrap_or(false)
+}
+
+/// What went wrong last: Gopher64's error, or a panic's message and place, for the game list's
+/// notice (the boot log has it too, through descriptor 2).
+static LAST_ERROR: std::sync::Mutex<String> = std::sync::Mutex::new(String::new());
+
+unsafe extern "C" {
+    /// The title's logger (ps5/host/platform.c): the boot log and klog, whatever descriptor 2 is.
+    fn say(format: *const std::ffi::c_char, ...);
+}
+
+unsafe extern "C" {
+    /// The boot log's video line: the RSP's time on the emulation thread (ps5/host/bench.c)
+    fn psgopher_bench_rsp_begin();
+    fn psgopher_bench_rsp_end(cycles: u64);
+    fn psgopher_bench_limiter_begin();
+    fn psgopher_bench_limiter_end();
+    /// Where the emulation thread is, for the freeze watchdog (bench.c): the place entered returns
+    /// the one it was in
+    fn psgopher_where(place: i32) -> i32;
+    fn psgopher_where_restore(previous: i32);
+}
+
+/// The places the freeze watchdog names (the numbers are ps5/host/bench.h's `psgopher_place`).
+pub mod place {
+    pub const RSP: i32 = 1;
+    pub const LIMITER: i32 = 8;
+    pub const AUDIO: i32 = 9;
+    pub const PI_DMA: i32 = 10;
+    pub const SAVE_DATA: i32 = 11;
+    pub const SAVE_STATE: i32 = 12;
+    pub const PAUSED: i32 = 13;
+    pub const INPUT: i32 = 15;
+    pub const ACHIEVEMENTS: i32 = 16;
+}
+
+/// A region the emulation thread may block in: the place is marked until this is dropped, then the
+/// enclosing one is back. Two relaxed stores and a TSC read; only the emulation thread makes one.
+pub struct Where(i32);
+
+#[inline]
+pub fn where_in(place: i32) -> Where {
+    Where(unsafe { psgopher_where(place) })
+}
+
+impl Drop for Where {
+    #[inline]
+    fn drop(&mut self) {
+        unsafe { psgopher_where_restore(self.0) }
+    }
+}
+
+/// The RSP's and the limiter's regions are a begin and an end call apart (they nest in nothing of
+/// their own kind, so one slot each keeps the place to return to).
+static RSP_RETURN: std::sync::atomic::AtomicI32 = std::sync::atomic::AtomicI32::new(0);
+static LIMITER_RETURN: std::sync::atomic::AtomicI32 = std::sync::atomic::AtomicI32::new(0);
+
+/// An RSP task begins and ends (its time, less the RDP work started inside it, is the line's RSP).
+#[inline]
+pub fn rsp_begin() {
+    RSP_RETURN.store(unsafe { psgopher_where(place::RSP) }, std::sync::atomic::Ordering::Relaxed);
+    unsafe { psgopher_bench_rsp_begin() }
+}
+#[inline]
+pub fn rsp_end(cycles: u64) {
+    unsafe { psgopher_bench_rsp_end(cycles) };
+    unsafe { psgopher_where_restore(RSP_RETURN.load(std::sync::atomic::Ordering::Relaxed)) }
+}
+
+/// The speed limiter's sleep (benchmark analysis B1: kept apart from the emulation's work).
+#[inline]
+pub fn limiter_begin() {
+    LIMITER_RETURN.store(unsafe { psgopher_where(place::LIMITER) }, std::sync::atomic::Ordering::Relaxed);
+    unsafe { psgopher_bench_limiter_begin() }
+}
+#[inline]
+pub fn limiter_end() {
+    unsafe { psgopher_bench_limiter_end() };
+    unsafe { psgopher_where_restore(LIMITER_RETURN.load(std::sync::atomic::Ordering::Relaxed)) }
+}
+
+/// A line to the boot log through the title's logger.
+pub fn log_line(text: &str) {
+    if let Ok(line) = std::ffi::CString::new(text.replace('\0', " ")) {
+        unsafe { say(c"%s".as_ptr(), line.as_ptr()) };
+    }
+}
+
+fn keep_error(text: String) {
+    if let Ok(mut last) = LAST_ERROR.lock() {
+        *last = text;
+    }
+}
+
+/// A panic's message and place are kept, then reported as Rust reports them.
+fn keep_panics() {
+    static ONCE: std::sync::Once = std::sync::Once::new();
+    ONCE.call_once(|| {
+        let report = std::panic::take_hook();
+        std::panic::set_hook(Box::new(move |info| {
+            let message = info
+                .payload()
+                .downcast_ref::<&str>()
+                .map(|s| s.to_string())
+                .or_else(|| info.payload().downcast_ref::<String>().cloned())
+                .unwrap_or_else(|| "a panic".into());
+            let place = info.location().map(|l| format!(" ({}:{})", l.file(), l.line())).unwrap_or_default();
+            let thread = std::thread::current().name().unwrap_or("unnamed").to_string();
+            log_line(&format!("psgopher: PANIC on thread {thread}: {message}{place}"));
+            keep_error(format!("{message}{place}"));
+            report(info);
+        }));
+    });
+}
+
+/// Copies the last error into `buffer` (NUL-terminated, cut to fit); returns its length.
+///
+/// # Safety
+/// `buffer` has room for `size` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_last_error(buffer: *mut std::ffi::c_char, size: usize) -> usize {
+    if buffer.is_null() || size == 0 {
+        return 0;
+    }
+    let text = LAST_ERROR.lock().map(|t| t.clone()).unwrap_or_default();
+    let n = text.len().min(size - 1);
+    unsafe {
+        std::ptr::copy_nonoverlapping(text.as_ptr(), buffer as *mut u8, n);
+        *buffer.add(n) = 0;
+    }
+    n
+}
+
+static RUNTIME_HAS_IO: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+/// Whether the last runtime built has Tokio's I/O driver (sockets, processes).
+pub fn runtime_has_io() -> bool {
+    RUNTIME_HAS_IO.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+unsafe extern "C" {
+    fn kqueue() -> i32;
+    fn socketpair(domain: i32, kind: i32, protocol: i32, fds: *mut i32) -> i32;
+    fn close(fd: i32) -> i32;
+}
+
+/// Gopher64's Tokio runtime. The whole one (Runtime::new: scheduler, timers, I/O) when the console
+/// gives it; the first console runs refused it with EOPNOTSUPP (errno 45), so then the scheduler and
+/// timers only, which is all Gopher64 uses here: tasks, channels, tokio::fs (blocking threads),
+/// sleeps and timeouts. Without the I/O driver, sockets and processes are off: the USB cartridge's
+/// TCP link (netplay and RetroAchievements are never started, D10). What the console refused is
+/// logged once: kqueue() (mio's poller) and an AF_UNIX socketpair (Tokio's signal driver, which the
+/// "process" feature brings) are tried by themselves.
+pub fn build_runtime() -> tokio::runtime::Runtime {
+    match tokio::runtime::Runtime::new() {
+        Ok(rt) => {
+            RUNTIME_HAS_IO.store(true, std::sync::atomic::Ordering::Relaxed);
+            rt
+        }
+        Err(e) => {
+            static TOLD: std::sync::Once = std::sync::Once::new();
+            TOLD.call_once(|| {
+                let kq = unsafe { kqueue() };
+                let kq_errno = std::io::Error::last_os_error();
+                if kq >= 0 {
+                    unsafe { close(kq) };
+                }
+                let mut fds = [-1i32; 2];
+                let sp = unsafe { socketpair(1 /* AF_UNIX */, 1 /* SOCK_STREAM */, 0, fds.as_mut_ptr()) };
+                let sp_errno = std::io::Error::last_os_error();
+                for fd in fds {
+                    if fd >= 0 {
+                        unsafe { close(fd) };
+                    }
+                }
+                log_line(&format!(
+                    "psgopher: Tokio's whole runtime was refused ({e}); kqueue(): {}; socketpair(AF_UNIX): {}. \
+                     Going on with its scheduler and timers only (no sockets or processes: the USB cartridge's link is off)",
+                    if kq >= 0 { "ok".to_string() } else { kq_errno.to_string() },
+                    if sp == 0 { "ok".to_string() } else { sp_errno.to_string() },
+                ));
+            });
+            RUNTIME_HAS_IO.store(false, std::sync::atomic::Ordering::Relaxed);
+            tokio::runtime::Builder::new_multi_thread()
+                .enable_time()
+                .build()
+                .expect("Failed to build runtime (scheduler and timers only)")
+        }
+    }
+}
+
+/// The game running now, for the quick menu: its name in the ROM's header and its save states'
+/// path without the slot's digit (data/states/<name>-<hash>.state).
+static GAME: std::sync::Mutex<(String, String)> = std::sync::Mutex::new((String::new(), String::new()));
+
+pub fn set_game(name: &str, states: &std::path::Path) {
+    if let Ok(mut game) = GAME.lock() {
+        *game = (name.to_string(), states.to_string_lossy().into_owned());
+    }
+}
+
+fn copy_out(text: &str, buffer: *mut std::ffi::c_char, size: usize) -> usize {
+    if buffer.is_null() || size == 0 {
+        return 0;
+    }
+    let n = text.len().min(size - 1);
+    unsafe {
+        std::ptr::copy_nonoverlapping(text.as_ptr(), buffer as *mut u8, n);
+        *buffer.add(n) = 0;
+    }
+    n
+}
+
+/// The running game's header name and states' path stem (see set_game); their lengths.
+///
+/// # Safety
+/// Each buffer has room for its size.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_game_info(
+    name: *mut std::ffi::c_char,
+    name_size: usize,
+    states: *mut std::ffi::c_char,
+    states_size: usize,
+) -> usize {
+    let (n, st) = GAME.lock().map(|g| g.clone()).unwrap_or_default();
+    copy_out(&n, name, name_size);
+    copy_out(&st, states, states_size)
+}
+
+/// What Gopher64 makes of a cartridge, for the front end's panel: its lockout chip, its save
+/// memory and its default pak, by Gopher64's own functions (rom::ipl3_model, storage::get_save_type,
+/// pif::init's pak choice).
+#[repr(C)]
+pub struct PsgopherRomFacts {
+    /// 6101, 6102, 6103, 6105, 6106, 5167; 0 for a boot code Gopher64 does not know (it runs it as a 6102)
+    pub cic: u32,
+    /// a bit per save memory Gopher64 gives it: 1 EEPROM 4K, 2 EEPROM 16K, 4 SRAM, 8 SRAM 768K,
+    /// 16 SRAM 1M, 32 Flash (0: none; 1|4, EEPROM 4K and SRAM, is its default for a game it does not list)
+    pub save: u32,
+    /// 1 when the controllers hold a Rumble Pak by default, 0 a Controller Pak
+    pub rumble: u32,
+}
+
+/// The facts of a ROM from its first 4 KiB, in Gopher64's byte order (big-endian, .z64); false when
+/// there is too little of it.
+///
+/// # Safety
+/// `rom` holds `len` bytes; `out` is writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_rom_facts(rom: *const u8, len: usize, out: *mut PsgopherRomFacts) -> bool {
+    if rom.is_null() || out.is_null() || len < 0x1000 {
+        return false;
+    }
+    let rom = unsafe { std::slice::from_raw_parts(rom, len) };
+    let facts = std::panic::catch_unwind(|| {
+        let game_id = String::from_utf8(rom[0x3B..0x3E].to_vec()).unwrap_or_else(|_| "UNK".into());
+        use crate::ui::storage::SaveTypes;
+        let save = crate::ui::storage::get_save_type(rom, &game_id)
+            .iter()
+            .map(|t| match t {
+                SaveTypes::Eeprom4k => 1,
+                SaveTypes::Eeprom16k => 2,
+                SaveTypes::Sram => 4,
+                SaveTypes::Sram768k => 8,
+                SaveTypes::Sram1m => 16,
+                SaveTypes::Flash => 32,
+                _ => 0,
+            })
+            .fold(0u32, |a, b| a | b);
+        PsgopherRomFacts {
+            cic: crate::device::cart::rom::ipl3_model(rom),
+            save,
+            rumble: (game_id == "NCT") as u32, // as pif::init
+        }
+    });
+    match facts {
+        Ok(f) => {
+            unsafe { *out = f };
+            true
+        }
+        Err(_) => false, // (an ED64 header with a save type Gopher64 does not know panics)
+    }
+}
+
+/// Gopher64's cheat database (data/cheats.json in the core), parsed once.
+fn cheat_database() -> &'static crate::cheats::Cheat {
+    static DATABASE: std::sync::OnceLock<crate::cheats::Cheat> = std::sync::OnceLock::new();
+    DATABASE.get_or_init(|| serde_json::from_slice(include_bytes!("../data/cheats.json")).unwrap_or_default())
+}
+
+fn c_text(text: *const std::ffi::c_char) -> String {
+    if text.is_null() {
+        return String::new();
+    }
+    unsafe { std::ffi::CStr::from_ptr(text) }.to_string_lossy().into_owned()
+}
+
+/// A game's cheats, for the front end, by Gopher64's key of the game (storage::get_game_crc:
+/// "CRC1-CRC2-C:country"): a line each, "name<TAB>note<TAB>options<TAB>on<TAB>option", options
+/// separated by '|' ("" when it has none), on 1 or 0, option the one chosen ("" none). The whole
+/// text's length (what did not fit in `size` is left out at a line's end).
+///
+/// # Safety
+/// `game` is a NUL-terminated string; `buffer` has room for `size` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_cheats_of(game: *const std::ffi::c_char, buffer: *mut std::ffi::c_char, size: usize) -> usize {
+    let game = c_text(game);
+    let text = std::panic::catch_unwind(|| {
+        let Some(cheats) = cheat_database().get(&game) else {
+            return String::new();
+        };
+        // read only: Cheats writes its file when dropped, so this copy is forgotten instead
+        let settings = crate::ui::config::Cheats::new();
+        let chosen = settings.cheats.get(&game).cloned().unwrap_or_default();
+        std::mem::forget(settings);
+        let clean = |s: &str| s.replace(['\t', '\n', '\r'], " ");
+        let mut out = String::new();
+        for (name, data) in cheats {
+            let options = data.options.as_ref().map(|o| o.keys().map(|k| clean(k)).collect::<Vec<_>>().join("|")).unwrap_or_default();
+            let (on, option) = match chosen.get(name) {
+                Some(option) => (1, option.clone().unwrap_or_default()),
+                None => (0, String::new()),
+            };
+            out += &format!("{}\t{}\t{}\t{}\t{}\n", clean(name), clean(&data.note), options, on, clean(&option));
+        }
+        out
+    })
+    .unwrap_or_default();
+    // whole lines only
+    let mut cut = text.len().min(size.saturating_sub(1));
+    if cut < text.len() {
+        cut = text[..cut].rfind('\n').map(|i| i + 1).unwrap_or(0);
+    }
+    copy_out(&text[..cut], buffer, size);
+    text.len()
+}
