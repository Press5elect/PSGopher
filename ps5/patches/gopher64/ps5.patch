index 0000000..00cebab
--- /dev/null
+++ b/src/psgopher_zip.rs
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Additional term (GPL-3.0 section 7(b)): keep the attribution "PSGopher by Press5elect"; see PSGopher's NOTICE.
+//! PSGopher (PS5): a ZIP archive for the updater (ps5/host/update.cpp), through the `zip` crate
+//! Gopher64 already links. Added by PSGopher's ps5.patch.
+//!
+//! The updater lists every entry before it unpacks any (names, sizes, kinds, encryption, methods),
+//! then reads the program's own files one at a time in blocks. Nothing here touches the disk but
+//! the archive itself: the C++ side decides where a file goes.
+//!
+//! This file uses only `std` and `zip`, so the updater's host test builds it alone
+//! (ps5/tests/update_zip).
+
+use std::ffi::{c_char, c_int, CStr};
+use std::fs::File;
+use zip::read::ZipFile;
+use zip::{CompressionMethod, ZipArchive};
+
+/// An open archive.
+pub struct PsgopherZip {
+    archive: ZipArchive<File>,
+    reading: bool,
+}
+
+/// One entry being read. Borrows its archive's reader for as long as it is open (the C++ side
+/// closes it before the archive, and has one open at a time: `psgopher_zip_read_open` refuses a
+/// second).
+pub struct PsgopherZipReader {
+    // (dropped before `zip` is used again)
+    file: Option<ZipFile<'static, File>>,
+    zip: *mut PsgopherZip,
+}
+
+/// What `psgopher_zip_entry` tells about an entry (ps5/host/update_zip.h repeats it).
+#[repr(C)]
+#[derive(Default)]
+pub struct PsgopherZipEntry {
+    /// The entry's size once unpacked.
+    pub size: u64,
+    /// The Unix mode in the entry's external attributes, when the archive says it was made on Unix
+    /// (flag 1); else 0.
+    pub unix_mode: u32,
+    /// 1: `unix_mode` is the archive's; 2: encrypted; 4: packed in a way this cannot read
+    /// (anything but stored and deflated).
+    pub flags: u32,
+}
+
+const FLAG_UNIX_MODE: u32 = 1;
+const FLAG_ENCRYPTED: u32 = 2;
+const FLAG_UNREADABLE_METHOD: u32 = 4;
+
+fn put_text(text: &str, buffer: *mut c_char, size: usize) {
+    if buffer.is_null() || size == 0 {
+        return;
+    }
+    let bytes = text.as_bytes();
+    let n = bytes.len().min(size - 1);
+    // SAFETY: the caller's buffer holds `size` bytes.
+    unsafe {
+        std::ptr::copy_nonoverlapping(bytes.as_ptr(), buffer.cast::<u8>(), n);
+        *buffer.add(n) = 0;
+    }
+}
+
+/// Opens a ZIP. Null when it cannot be read; `error` (`error_size` bytes) then says why.
+///
+/// # Safety
+/// `path` is a NUL-terminated string; `error` has room for `error_size` bytes (or is null).
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_zip_open(path: *const c_char, error: *mut c_char, error_size: usize) -> *mut PsgopherZip {
+    if path.is_null() {
+        put_text("no path", error, error_size);
+        return std::ptr::null_mut();
+    }
+    // SAFETY: NUL-terminated by the caller.
+    let path = unsafe { CStr::from_ptr(path) }.to_string_lossy().into_owned();
+    let file = match File::open(&path) {
+        Ok(file) => file,
+        Err(e) => {
+            put_text(&e.to_string(), error, error_size);
+            return std::ptr::null_mut();
+        }
+    };
+    match ZipArchive::new(file) {
+        Ok(archive) => Box::into_raw(Box::new(PsgopherZip { archive, reading: false })),
+        Err(e) => {
+            put_text(&e.to_string(), error, error_size);
+            std::ptr::null_mut()
+        }
+    }
+}
+
+/// The number of entries.
+///
+/// # Safety
+/// `zip` is from `psgopher_zip_open` and not closed.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_zip_count(zip: *const PsgopherZip) -> i64 {
+    if zip.is_null() {
+        return -1;
+    }
+    unsafe { (*zip).archive.len() as i64 }
+}
+
+/// An entry's name (raw bytes, not NUL-ended; its length is returned, and `name` holds at most
+/// `name_size` of it) and facts. Negative: no such entry.
+///
+/// # Safety
+/// `zip` is open; `name` has room for `name_size` bytes; `entry` is writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_zip_entry(
+    zip: *const PsgopherZip,
+    index: u64,
+    name: *mut u8,
+    name_size: usize,
+    entry: *mut PsgopherZipEntry,
+) -> i64 {
+    if zip.is_null() || entry.is_null() {
+        return -1;
+    }
+    let zip = unsafe { &*zip };
+    let Ok(data) = zip.archive.by_index_data(index as usize) else {
+        return -1;
+    };
+    let raw = data.name_raw();
+    if !name.is_null() {
+        let n = raw.len().min(name_size);
+        unsafe { std::ptr::copy_nonoverlapping(raw.as_ptr(), name, n) };
+    }
+    let mut facts = PsgopherZipEntry { size: data.size(), ..Default::default() };
+    if data.system() == zip::System::Unix {
+        facts.flags |= FLAG_UNIX_MODE;
+        facts.unix_mode = data.external_attributes() >> 16;
+    }
+    if data.encrypted() {
+        facts.flags |= FLAG_ENCRYPTED;
+    }
+    if !matches!(data.compression(), CompressionMethod::Stored | CompressionMethod::Deflated) {
+        facts.flags |= FLAG_UNREADABLE_METHOD;
+    }
+    unsafe { *entry = facts };
+    raw.len() as i64
+}
+
+/// Starts reading an entry's contents (unpacked, its CRC checked at the end). Null: it cannot be
+/// read, or another entry of this archive is being read.
+///
+/// # Safety
+/// `zip` is open and outlives the reader.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_zip_read_open(zip: *mut PsgopherZip, index: u64) -> *mut PsgopherZipReader {
+    if zip.is_null() {
+        return std::ptr::null_mut();
+    }
+    let z = unsafe { &mut *zip };
+    if z.reading {
+        return std::ptr::null_mut();
+    }
+    let Ok(file) = z.archive.by_index(index as usize) else {
+        return std::ptr::null_mut();
+    };
+    // SAFETY: the file borrows the archive, which sits in a Box that is not moved or freed while
+    // `reading` is set (`psgopher_zip_close` refuses while it is).
+    let file: ZipFile<'static, File> = unsafe { std::mem::transmute(file) };
+    z.reading = true;
+    Box::into_raw(Box::new(PsgopherZipReader { file: Some(file), zip }))
+}
+
+/// Up to `size` bytes of the entry: how many (0 at its end), or -1 when it is damaged.
+///
+/// # Safety
+/// `reader` is open; `buffer` holds `size` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_zip_read(reader: *mut PsgopherZipReader, buffer: *mut u8, size: usize) -> i64 {
+    use std::io::Read;
+    if reader.is_null() || buffer.is_null() {
+        return -1;
+    }
+    let reader = unsafe { &mut *reader };
+    let Some(file) = reader.file.as_mut() else {
+        return -1;
+    };
+    let out = unsafe { std::slice::from_raw_parts_mut(buffer, size) };
+    loop {
+        match file.read(out) {
+            Ok(n) => return n as i64,
+            Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,
+            Err(_) => return -1,
+        }
+    }
+}
+
+/// Ends the reading of an entry.
+///
+/// # Safety
+/// `reader` is from `psgopher_zip_read_open`, closed once.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_zip_read_close(reader: *mut PsgopherZipReader) -> c_int {
+    if reader.is_null() {
+        return -1;
+    }
+    let mut reader = unsafe { Box::from_raw(reader) };
+    reader.file = None;
+    unsafe { (*reader.zip).reading = false };
+    0
+}
+
+/// Closes the archive (not while an entry of it is being read: nothing happens then, -1).
+///
+/// # Safety
+/// `zip` is from `psgopher_zip_open`, closed once.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_zip_close(zip: *mut PsgopherZip) -> c_int {
+    if zip.is_null() {
+        return -1;
+    }
+    if unsafe { (*zip).reading } {
+        return -1;
+    }
+    drop(unsafe { Box::from_raw(zip) });
+    0
+}
