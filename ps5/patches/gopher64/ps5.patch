+pub fn deserialize_events<'de, D: serde::Deserializer<'de>>(
+    deserializer: D,
+) -> Result<[Event; EVENT_TYPE_COUNT], D::Error> {
+    struct Events;
+    impl<'de> serde::de::Visitor<'de> for Events {
+        type Value = [Event; EVENT_TYPE_COUNT];
+        fn expecting(&self, formatter: &mut std::fmt::Formatter) -> std::fmt::Result {
+            write!(formatter, "{EVENT_TYPE_SAVED_COUNT} events")
+        }
+        fn visit_seq<A: serde::de::SeqAccess<'de>>(
+            self,
+            mut seq: A,
+        ) -> Result<Self::Value, A::Error> {
+            let mut events = [Event {
+                enabled: false,
+                count: u64::MAX,
+            }; EVENT_TYPE_COUNT];
+            for (i, event) in events[..EVENT_TYPE_SAVED_COUNT].iter_mut().enumerate() {
+                *event = seq
+                    .next_element()?
+                    .ok_or_else(|| serde::de::Error::invalid_length(i, &self))?;
+            }
+            Ok(events)
+        }
+    }
+    deserializer.deserialize_tuple(EVENT_TYPE_SAVED_COUNT, Events)
+}
