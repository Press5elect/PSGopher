+        let (h, t, b) = lba_to_physical(0, 0x0600, &vec![0u8; 0xE8]);
+        let index = block_index(h, t, b);
+        assert_eq!(read4(&disk, index), 0x0600u32.to_be_bytes());
+        disk.write(&mut overlay, index, 1, 0x77);
