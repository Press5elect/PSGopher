+/// GET https://host/path with rustls over a blocking socket (Tokio's sockets are refused on the
+/// console, so reqwest cannot be used; the roots are webpki-roots', the console has no store):
+/// the status (0 when the network or TLS failed) and the body.
+fn https_get(host: &str, path: &str, accept: &str, timeout: std::time::Duration) -> (u16, Vec<u8>) {
+    use std::io::{Read, Write};
+    crate::ui::install_default_crypto_provider();
+    static CONFIG: std::sync::OnceLock<std::sync::Arc<rustls::ClientConfig>> = std::sync::OnceLock::new();
+    let config = CONFIG
+        .get_or_init(|| {
+            let roots = rustls::RootCertStore { roots: webpki_roots::TLS_SERVER_ROOTS.to_vec() };
+            std::sync::Arc::new(rustls::ClientConfig::builder().with_root_certificates(roots).with_no_client_auth())
+        })
+        .clone();
+    let failed = |what: &str, why: String| {
+        log_line(&format!("web: {host}: {what}: {why}"));
+        (0u16, Vec::new())
+    };
+    let Ok(name) = rustls::pki_types::ServerName::try_from(host.to_string()) else {
+        return failed("name", "not a host name".into());
+    };
+    let address = match std::net::ToSocketAddrs::to_socket_addrs(&(host, 443)) {
+        Ok(mut list) => match list.find(|a| a.is_ipv4()) {
+            Some(a) => a,
+            None => return failed("address", "none for IPv4".into()),
+        },
+        Err(e) => return failed("address", e.to_string()),
+    };
+    let socket = match std::net::TcpStream::connect_timeout(&address, std::time::Duration::from_secs(10)) {
+        Ok(s) => s,
+        Err(e) => return failed("connect", e.to_string()),
+    };
+    let _ = socket.set_read_timeout(Some(timeout));
+    let _ = socket.set_write_timeout(Some(timeout));
+    let connection = match rustls::ClientConnection::new(config, name) {
+        Ok(c) => c,
+        Err(e) => return failed("TLS", e.to_string()),
+    };
+    let mut tls = rustls::StreamOwned::new(connection, socket);
+    let request = format!(
+        "GET {path} HTTP/1.1\r\nHost: {host}\r\nUser-Agent: PSGopher (PlayStation 5 homebrew)\r\nAccept: {accept}\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n"
+    );
+    if let Err(e) = tls.write_all(request.as_bytes()) {
+        return failed("request", e.to_string());
+    }
+    let mut data = Vec::new();
+    let mut chunk = [0u8; 16384];
+    loop {
+        match tls.read(&mut chunk) {
+            Ok(0) => break,
+            Ok(n) => {
+                data.extend_from_slice(&chunk[..n]);
+                if data.len() > 16 << 20 {
+                    return failed("answer", "longer than 16 MiB".into());
+                }
+            }
+            // (a server closing without TLS's close_notify: what came is kept, its length checked below)
+            Err(e) if e.kind() == std::io::ErrorKind::UnexpectedEof => break,
+            Err(e) => return failed("answer", e.to_string()),
+        }
+    }
+    let Some(end) = data.windows(4).position(|w| w == b"\r\n\r\n") else {
+        return failed("answer", "no HTTP head".into());
+    };
+    let head = String::from_utf8_lossy(&data[..end]).to_ascii_lowercase();
+    let status: u16 = head.split_whitespace().nth(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let raw = &data[end + 4..];
+    let body = if head.contains("\r\ntransfer-encoding: chunked") {
+        let mut plain = Vec::new();
+        let mut at = 0;
+        let mut whole = false;
+        while at < raw.len() {
+            let Some(le) = raw[at..].windows(2).position(|w| w == b"\r\n") else { break };
+            let line = String::from_utf8_lossy(&raw[at..at + le]);
+            let Ok(len) = usize::from_str_radix(line.split(';').next().unwrap_or("").trim(), 16) else { break };
+            if len == 0 {
+                whole = true;
+                break;
+            }
+            let start = at + le + 2;
+            if len > raw.len().saturating_sub(start) {
+                break;
+            }
+            plain.extend_from_slice(&raw[start..start + len]);
+            at = start + len + 2;
+        }
+        if !whole {
+            return failed("answer", "cut short".into());
+        }
+        plain
+    } else {
+        let mut body = raw.to_vec();
+        if let Some(at) = head.find("\r\ncontent-length:") {
+            let want: usize = head[at + 17..].split("\r\n").next().unwrap_or("").trim().parse().unwrap_or(0);
+            if body.len() < want {
+                return failed("answer", "cut short".into());
+            }
+            body.truncate(want);
+        }
+        body
+    };
+    (status, body)
+}
+
+fn url_encode(text: &str) -> String {
+    let mut out = String::new();
+    for b in text.bytes() {
+        if b.is_ascii_alphanumeric() || b"-_.~".contains(&b) {
+            out.push(b as char);
+        } else {
+            out.push_str(&format!("%{b:02X}"));
+        }
+    }
+    out
+}
+
+/// A game's description from Wikipedia (as OGBox finds one: the first of five search results
+/// whose description says "video game", then its summary): the status (200: "title\ntext" in
+/// `buffer`; 404: no article about the game; anything else: no answer, try later).
+///
+/// # Safety
+/// `name` is a NUL-terminated string; `buffer` has room for `size` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_about(name: *const std::ffi::c_char, buffer: *mut std::ffi::c_char, size: usize) -> i32 {
+    let name = c_text(name);
+    let timeout = std::time::Duration::from_secs(30);
+    let name = wiki_name(&name);
+    let (status, body) = https_get(
+        "en.wikipedia.org",
+        &format!("/w/rest.php/v1/search/page?q={}&limit=10", url_encode(&format!("{name} video game"))),
+        "application/json",
+        timeout,
+    );
+    if status != 200 {
+        return status as i32;
+    }
+    let Ok(found) = serde_json::from_slice::<serde_json::Value>(&body) else { return 404 };
+    let key = found["pages"].as_array().and_then(|pages| {
+        pages.iter().find_map(|page| {
+            let about = page["description"].as_str().unwrap_or("").to_ascii_lowercase();
+            let title = page["title"].as_str().unwrap_or("");
+            // a game's article, and this game's: its title is the name (the search also offers
+            // articles that merely mention it; on the console "2048" found another game's)
+            if about.contains("video game") && wiki_title_matches(&name, title) && wiki_n64_years(title, &about) {
+                page["key"].as_str().map(str::to_string)
+            } else {
+                None
+            }
+        })
+    });
+    let Some(key) = key else { return 404 };
+    let (status, body) = https_get("en.wikipedia.org", &format!("/api/rest_v1/page/summary/{}", url_encode(&key)), "application/json", timeout);
+    if status != 200 {
+        return status as i32;
+    }
+    let Ok(summary) = serde_json::from_slice::<serde_json::Value>(&body) else { return 404 };
+    let Some(text) = summary["extract"].as_str().filter(|t| !t.is_empty()) else { return 404 };
+    let title = summary["title"].as_str().unwrap_or(&key);
+    copy_out(&format!("{title}\n{text}"), buffer, size);
+    200
+}
+
+/// A No-Intro name as Wikipedia titles it: "Bug's Life, A" -> "A Bug's Life" (the article moved
+/// back to the front, before any " - " subtitle).
+fn wiki_name(name: &str) -> String {
+    let (main, rest) = match name.find(" - ") {
+        Some(at) => (&name[..at], &name[at..]),
+        None => (name, ""),
+    };
+    for article in [", The", ", A", ", An"] {
+        if let Some(stem) = main.strip_suffix(article) {
+            return format!("{} {stem}{rest}", &article[2..]);
+        }
+    }
+    name.to_string()
+}
+
+/// Letters and digits only, lower case, with the accents Wikipedia's titles use folded
+/// ("Pokémon" and "Pokemon" are the same name).
+fn wiki_compact(text: &str) -> String {
+    let mut out = String::new();
+    for c in text.chars() {
+        let c = match c {
+            'à'..='å' | 'À'..='Å' | 'ā' | 'Ā' => 'a',
+            'è'..='ë' | 'È'..='Ë' | 'ē' | 'Ē' => 'e',
+            'ì'..='ï' | 'Ì'..='Ï' | 'ī' | 'Ī' => 'i',
+            'ò'..='ö' | 'Ò'..='Ö' | 'ō' | 'Ō' | 'ø' | 'Ø' => 'o',
+            'ù'..='ü' | 'Ù'..='Ü' | 'ū' | 'Ū' => 'u',
+            'ñ' | 'Ñ' => 'n',
+            'ç' | 'Ç' => 'c',
+            c => c,
+        };
+        if c.is_ascii_alphanumeric() {
+            out.push(c.to_ascii_lowercase());
+        }
+    }
+    out
+}
+
+/// The article's title (without its " (...)" disambiguation) names the cartridge: one holds the
+/// other, and the shorter is at least 60% of the longer ("007 - The World Is Not Enough" and
+/// "The World Is Not Enough" match; "2048" and "Wipeout 2048" do not).
+fn wiki_title_matches(name: &str, title: &str) -> bool {
+    let title = title.find(" (").map_or(title, |at| &title[..at]);
+    let (a, b) = (wiki_compact(name), wiki_compact(title));
+    let (short, long) = if a.len() <= b.len() { (a, b) } else { (b, a) };
+    if !short.is_empty() && long.contains(&short) && short.len() * 10 >= long.len() * 6 {
+        return true;
+    }
+    // the same words in another order: No-Intro's "007 - GoldenEye", the article's "GoldenEye 007"
+    let words = |text: &str| {
+        let mut w: Vec<String> = text.split(|c: char| !c.is_alphanumeric()).map(wiki_compact).filter(|w| !w.is_empty()).collect();
+        w.sort();
+        w
+    };
+    let (x, y) = (words(name), words(title));
+    !x.is_empty() && x == y
+}
+
+/// The article is of the N64's years when it names one (1995-2004, in its title or description):
+/// "007 - GoldenEye" found "GoldenEye 007 (2010 video game)", the later game of the name.
+fn wiki_n64_years(title: &str, description: &str) -> bool {
+    let year = |text: &str| -> Option<u32> {
+        let b = text.as_bytes();
+        (0..b.len().saturating_sub(3)).find_map(|i| {
+            let four = &b[i..i + 4];
+            let edge = |j: usize| j >= b.len() || !b[j].is_ascii_digit();
+            let starts = i == 0 || !b[i - 1].is_ascii_digit();
+            if starts && edge(i + 4) && four.iter().all(u8::is_ascii_digit) && (four[0] == b'1' || four[0] == b'2') {
+                std::str::from_utf8(four).ok()?.parse().ok().filter(|y| (1950..2100).contains(y))
+            } else {
+                None
+            }
+        })
+    };
+    match year(title).or_else(|| year(description)) {
+        Some(y) => (1995..=2004).contains(&y),
+        None => true,
+    }
+}
+
+#[cfg(test)]
+mod wiki_tests {
+    use super::*;
+
+    #[test]
+    fn names_and_titles() {
+        assert_eq!(wiki_name("Bug's Life, A"), "A Bug's Life");
+        assert_eq!(wiki_name("Legend of Zelda, The - Ocarina of Time"), "The Legend of Zelda - Ocarina of Time");
+        assert_eq!(wiki_name("Banjo-Kazooie"), "Banjo-Kazooie");
+        assert!(wiki_title_matches("007 - The World Is Not Enough", "The World Is Not Enough (Nintendo 64 video game)"));
+        assert!(wiki_title_matches("AeroFighters Assault", "Aero Fighters Assault"));
+        assert!(wiki_title_matches("40 Winks", "40 Winks (video game)"));
+        assert!(wiki_title_matches("Pokemon Stadium", "Pokémon Stadium"));
+        assert!(wiki_title_matches("The Legend of Zelda - Ocarina of Time", "The Legend of Zelda: Ocarina of Time"));
+        assert!(wiki_title_matches("Clay Fighter 63 1-3", "ClayFighter 63⅓"));
+        assert!(!wiki_title_matches("2048", "Wipeout 2048"));
+        assert!(!wiki_title_matches("[BIOS] Nintendo 64 - PIF", "Video games in the United States"));
+        assert!(!wiki_title_matches("", "Anything"));
+        assert!(wiki_title_matches("007 - GoldenEye", "GoldenEye 007 (1997 video game)"));
+        assert!(!wiki_title_matches("Mario Kart", "Kart Mario Party"));
+        assert!(!wiki_n64_years("GoldenEye 007 (2010 video game)", "2010 video game"));
+        assert!(wiki_n64_years("GoldenEye 007", "1997 video game"));
+        assert!(wiki_n64_years("40 Winks (video game)", "video game"));
+        assert!(!wiki_n64_years("Wipeout 2048", "2012 video game"));
+        assert!(wiki_n64_years("Hydro Thunder", "1999 racing video game"));
+    }
+}
+
+/// A cartridge's box art from libretro's thumbnails (libretro-thumbnails' Nintendo 64 set, as
+/// thumbnails.libretro.com serves it, read from its GitHub repository: the server answered 404 for
+/// every N64 name when this was written), by its No-Intro name, written to `file`: the status
+/// (200 kept; 404 libretro has none; anything else: no answer, try later).
+///
+/// # Safety
+/// `name` and `file` are NUL-terminated strings.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_cover(name: *const std::ffi::c_char, file: *const std::ffi::c_char) -> i32 {
+    // libretro's names: these characters are '_' in its file names
+    let name: String = c_text(name).chars().map(|c| if "&*/:`<>?\\|\"".contains(c) { '_' } else { c }).collect();
+    let file = c_text(file);
+    let (status, body) = https_get(
+        "raw.githubusercontent.com",
+        &format!("/libretro-thumbnails/Nintendo_-_Nintendo_64/master/Named_Boxarts/{}.png", url_encode(&name)),
+        "image/png",
+        std::time::Duration::from_secs(30),
+    );
+    if status != 200 {
+        return status as i32;
+    }
+    if !body.starts_with(b"\x89PNG\r\n\x1a\n") {
+        return 404;
+    }
+    if !body.ends_with(b"IEND\xAE\x42\x60\x82") {
+        return 0; // (cut off before its end: asked again, not kept)
+    }
+    let part = format!("{file}.part");
+    if std::fs::write(&part, &body).is_err() || std::fs::rename(&part, &file).is_err() {
+        let _ = std::fs::remove_file(&part);
+        return 500;
+    }
+    200
+}
+
+/// Gopher64's settings that are text, by name (as `psgopher_setting_get`'s): `input.gb_rom_path.N`
+/// and `input.gb_ram_path.N` (the Transfer Pak's Game Boy ROM and save), `input.input_profile_binding.N`
+/// (the port's input profile) and `input.controller_assignment.N` (the controller's path,
+/// `ps5:padK`; "" none). Its length, or -1 for a name Gopher64 has not.
+///
+/// # Safety
+/// `name` is a NUL-terminated string; `buffer` holds `size` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_setting_text(name: *const std::ffi::c_char, buffer: *mut std::ffi::c_char, size: usize) -> i32 {
+    let Some(name) = setting_name(name) else { return -1 };
+    let text = std::panic::catch_unwind(|| {
+        let config = crate::ui::config::Config::new();
+        let index = |prefix: &str| name.strip_prefix(prefix)?.parse::<usize>().ok().filter(|i| *i < 4);
+        if let Some(i) = index("input.gb_rom_path.") {
+            Some(config.input.gb_rom_path[i].clone())
+        } else if let Some(i) = index("input.gb_ram_path.") {
+            Some(config.input.gb_ram_path[i].clone())
+        } else if let Some(i) = index("input.input_profile_binding.") {
+            Some(config.input.input_profile_binding[i].clone())
+        } else if let Some(i) = index("input.controller_assignment.") {
+            Some(config.input.controller_assignment[i].clone().unwrap_or_default())
+        } else {
+            None
+        }
+    })
+    .ok()
+    .flatten();
+    match text {
+        Some(text) => {
+            copy_out(&text, buffer, size);
+            text.len() as i32
+        }
+        None => -1,
+    }
+}
+
+/// Sets one (see `psgopher_setting_text`) and writes config.json; false for a name Gopher64 has not
+/// or a profile it has not.
+///
+/// # Safety
+/// `name` and `value` are NUL-terminated strings.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_setting_text_set(name: *const std::ffi::c_char, value: *const std::ffi::c_char) -> bool {
+    let (Some(name), Some(value)) = (setting_name(name), setting_name(value)) else { return false };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        let index = |prefix: &str| name.strip_prefix(prefix)?.parse::<usize>().ok().filter(|i| *i < 4);
+        if let Some(i) = index("input.gb_rom_path.") {
+            config.input.gb_rom_path[i] = value.clone();
+        } else if let Some(i) = index("input.gb_ram_path.") {
+            config.input.gb_ram_path[i] = value.clone();
+        } else if let Some(i) = index("input.input_profile_binding.") {
+            if !config.input.input_profiles.contains_key(&value) {
+                return false;
+            }
+            config.input.input_profile_binding[i] = value.clone();
+        } else if let Some(i) = index("input.controller_assignment.") {
+            config.input.controller_assignment[i] = if value.is_empty() { None } else { Some(value.clone()) };
+        } else {
+            return false;
+        }
+        true
+    })
+    .unwrap_or(false)
+}
+
+/// The input profiles' names, one a line ("default" among them).
+///
+/// # Safety
+/// `buffer` holds `size` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profiles(buffer: *mut std::ffi::c_char, size: usize) -> i32 {
+    let names = std::panic::catch_unwind(|| {
+        let config = crate::ui::config::Config::new();
+        config.input.input_profiles.keys().cloned().collect::<Vec<_>>().join("\n")
+    })
+    .unwrap_or_default();
+    copy_out(&names, buffer, size);
+    names.len() as i32
+}
+
+/// A new profile by that name, Gopher64's default bindings (false when the name is taken or empty).
+///
+/// # Safety
+/// `name` is a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profile_new(name: *const std::ffi::c_char) -> bool {
+    let Some(name) = setting_name(name) else { return false };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        if name.trim().is_empty() || config.input.input_profiles.contains_key(&name) {
+            return false;
+        }
+        config.input.input_profiles.insert(name.clone(), crate::ui::input_profile::get_default_profile());
+        true
+    })
+    .unwrap_or(false)
+}
+
+/// Takes a profile away (not "default"); the ports that had it get "default".
+///
+/// # Safety
+/// `name` is a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profile_delete(name: *const std::ffi::c_char) -> bool {
+    let Some(name) = setting_name(name) else { return false };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        if name == "default" || config.input.input_profiles.remove(&name).is_none() {
+            return false;
+        }
+        for binding in config.input.input_profile_binding.iter_mut() {
+            if *binding == name {
+                *binding = "default".to_string();
+            }
+        }
+        true
+    })
+    .unwrap_or(false)
+}
+
+/// One input of a profile (an index of Gopher64's input_profile: 0 D Right .. 17 Stick Up, 18 the
+/// Hotkey Activator), its controller binding (the second of its two; the first is the keyboard's):
+/// kind 0 none, 1 a gamepad button (id: SDL_GamepadButton), 2 a gamepad axis (id: SDL_GamepadAxis,
+/// axis: its direction, 1 or -1), 3 a joystick's button, hat or axis (DirectInput). False for a
+/// profile or index Gopher64 has not.
+///
+/// # Safety
+/// `name` is a NUL-terminated string; the outputs are valid pointers.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profile_binding(name: *const std::ffi::c_char, index: i32, kind: *mut i32, id: *mut i32, axis: *mut i32) -> bool {
+    let Some(name) = setting_name(name) else { return false };
+    let found = std::panic::catch_unwind(|| {
+        let config = crate::ui::config::Config::new();
+        let profile = config.input.input_profiles.get(&name)?;
+        let slot = profile.inputs.get(usize::try_from(index).ok()?)?;
+        Some(match &slot[1] {
+            None => (0, 0, 0),
+            Some(crate::ui::config::InputItem::ControllerButton(b)) => (1, b.id, 0),
+            Some(crate::ui::config::InputItem::ControllerAxis(a)) => (2, a.id, a.axis as i32),
+            Some(_) => (3, 0, 0),
+        })
+    })
+    .ok()
+    .flatten();
+    match found {
+        Some((k, i, a)) => {
+            unsafe {
+                *kind = k;
+                *id = i;
+                *axis = a;
+            }
+            true
+        }
+        None => false,
+    }
+}
+
+/// Binds one input of a profile to the controller (see `psgopher_profile_binding`; kind 0 clears
+/// it). The keyboard's binding stays.
+///
+/// # Safety
+/// `name` is a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profile_bind(name: *const std::ffi::c_char, index: i32, kind: i32, id: i32, axis: i32) -> bool {
+    let Some(name) = setting_name(name) else { return false };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        let Some(profile) = config.input.input_profiles.get_mut(&name) else { return false };
+        let Some(slot) = usize::try_from(index).ok().and_then(|i| profile.inputs.get_mut(i)) else { return false };
+        slot[1] = match kind {
+            0 => None,
+            1 => Some(crate::ui::config::InputItem::ControllerButton(crate::ui::config::InputKeyButton { id })),
+            2 => Some(crate::ui::config::InputItem::ControllerAxis(crate::ui::config::InputControllerAxis {
+                id,
+                axis: if axis < 0 { -1 } else { 1 },
+                initial_state: 0,
+            })),
+            _ => return false,
+        };
+        true
+    })
+    .unwrap_or(false)
+}
+
+/// A profile's number: `what` 0 its deadzone (Gopher64's units), 1 DirectInput (the pad read as a
+/// raw joystick, 0 or 1). With `set`, `value` is written first. -1 for a profile Gopher64 has not.
+///
+/// # Safety
+/// `name` is a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profile_number(name: *const std::ffi::c_char, what: i32, value: i64, set: bool) -> i64 {
+    let Some(name) = setting_name(name) else { return -1 };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        let Some(profile) = config.input.input_profiles.get_mut(&name) else { return -1 };
+        match what {
+            0 => {
+                if set {
+                    profile.deadzone = value.clamp(0, 100) as i32;
+                }
+                profile.deadzone as i64
+            }
+            1 => {
+                if set {
+                    profile.dinput = value != 0;
+                }
+                profile.dinput as i64
+            }
+            _ => -1,
+        }
+    })
+    .unwrap_or(-1)
+}
