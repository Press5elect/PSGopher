+
+    fn review_states_are_checked_body() {
+        let device = with_disk();
+        let mut snapshot = device::Device::new(false);
+        snapshot.clone_state(&device);
+        let device_bytes = postcard::to_stdvec(&snapshot).unwrap();
+        let load = || postcard::from_bytes::<Box<device::Device>>(&device_bytes).unwrap();
+        // a 64DD state into a run without one
+        let entry = state_entry(&device.dd, &snapshot).unwrap();
+        assert!(restore_entry(&Dd::default(), load(), Some(entry.clone())).is_none());
+        assert!(restore_entry(&Dd::default(), load(), None).is_some());
+        // malformed buffers and overlay blocks
+        let mut bad = snapshot.dd.state.clone();
+        bad.regs.ds.pop();
+        let entry_of = |state: DdState| {
+            postcard::to_stdvec(&StateEntry {
+                state,
+                events: snapshot.cpu.events[EVENT_TYPE_SAVED_COUNT..].to_vec(),
+            })
+            .unwrap()
+        };
+        assert!(restore_entry(&device.dd, load(), Some(entry_of(bad))).is_none());
+        let mut bad = snapshot.dd.state.clone();
+        bad.overlay.insert(0, vec![0; 10]);
+        assert!(restore_entry(&device.dd, load(), Some(entry_of(bad))).is_none());
+        let mut bad = snapshot.dd.state.clone();
+        bad.overlay.insert(disk::BLOCKS as u32, vec![0; 0x4D08]);
+        assert!(restore_entry(&device.dd, load(), Some(entry_of(bad))).is_none());
+        let mut good = snapshot.dd.state.clone();
+        good.overlay.insert(0, vec![0; 0x4D08]);
+        assert!(restore_entry(&device.dd, load(), Some(entry_of(good))).is_some());
+        assert!(restore_entry(&device.dd, load(), Some(vec![1, 2, 3])).is_none());
+    }
