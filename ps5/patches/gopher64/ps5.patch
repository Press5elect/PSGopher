+/// # Safety
+/// `argv` holds `argc` NUL-terminated strings, as C's `main` receives them.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_main(argc: i32, argv: *const *const std::ffi::c_char) -> i32 {
+    let args: Vec<String> = (0..argc.max(0) as usize)
+        .map(|i| {
+            unsafe { std::ffi::CStr::from_ptr(*argv.add(i)) }
+                .to_string_lossy()
+                .into_owned()
+        })
+        .collect();
+    // A panic must not unwind into C: it is reported, kept for the game list, and the list comes back.
+    keep_error(String::new());
+    keep_panics();
+    log_line(&format!("psgopher: Gopher64 with {:?}", args));
+    let result = std::panic::catch_unwind(move || {
+        let dirs = dirs();
+        for dir in [&dirs.config_dir, &dirs.cache_dir, &dirs.data_dir] {
+            let _ = std::fs::create_dir_all(dir);
+        }
+        assign_pads();
+        load_hotkeys();
+        let (close_tx, handle) = crate::create_runtime();
+        let _guard = handle.enter();
+        let arg_count = args.len();
+        let result = match crate::Args::try_parse_from(args) {
+            Ok(args) => crate::run(args, arg_count),
+            Err(e) => Err(std::io::Error::other(e.to_string())),
+        };
+        let _ = close_tx.send(());
+        result
+    });
+    match result {
+        Ok(Ok(())) => 0,
+        Ok(Err(e)) => {
+            log_line(&format!("psgopher: Gopher64 ended with an error: {e}"));
+            keep_error(e.to_string());
+            1
+        }
+        Err(_) => {
+            eprintln!("psgopher: the emulator panicked (above)");
+            101
+        }
+    }
+}
