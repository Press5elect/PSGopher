 pub fn lwc1(device: &mut device::Device, opcode: u32) {
+    let address = device.cpu.gpr[device::cpu_instructions::rs(opcode) as usize].wrapping_add(
+        device::cpu_instructions::se16(device::cpu_instructions::imm(opcode) as i16),
+    );
+    if cu1_enabled(device)
+        && let Some(value) = device::memory::read_hit(device, address)
+    {
+        return set_fpr_word(device, device::fpu_instructions::ft(opcode), value);
+    }
+    lwc1_generic(device, opcode)
+}
+
+#[inline(never)]
+fn lwc1_generic(device: &mut device::Device, opcode: u32) {
     if !cu1_enabled(device) {
         return unusable(device, opcode);
     }
