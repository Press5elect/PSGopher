+#ifdef PSGOPHER
+// HDR10 output (PSGopher, PSGOPHER_HDR=1 from the title's settings): on only while asked for, the
+// console's output is HDR and the driver took the framebuffers as HDR10 (Crux2's rules). The frame's
+// picture and its messages are drawn as for an SDR screen into two layers, which the packing pass
+// (ps5/shaders/psgopher_hdr.frag) makes into HDR10's pixels in the swapchain image.
+static struct {
+  bool want = false, asked = false, on = false;
+  float white = 203.0f, peak = 1000.0f;
+  Vulkan::ImageHandle picture, overlay;
+} hdr;
+
+static void psgopher_hdr_init() {
+  const char *want = getenv("PSGOPHER_HDR");
+  hdr.want = want && want[0] == '1';
+  if (const char *white = getenv("PSGOPHER_HDR_WHITE"))
+    hdr.white = std::clamp(float(atof(white)), 80.0f, 400.0f);
+  if (const char *peak = getenv("PSGOPHER_HDR_PEAK"))
+    hdr.peak = std::clamp(float(atof(peak)), 0.0f, 10000.0f);
+  hdr.asked = hdr.on = false;
+}
+
+// the layers go before the device does; HDR10 goes off with the game (the game list after it is SDR)
+static void psgopher_hdr_release() {
+  if (hdr.on && wsi_videoout_set_hdr10) {
+    if (wsi)
+      wsi->get_device().wait_idle();
+    const int rc = wsi_videoout_set_hdr10(0);
+    LOGI("psgopher: HDR output off with the game (0x%08x)\n", unsigned(rc));
+  }
+  hdr.on = hdr.asked = false;
+  hdr.picture.reset();
+  hdr.overlay.reset();
+}
+
+// Whether this frame goes out as HDR10; the driver is asked once (and again after it dropped HDR10)
+static bool psgopher_hdr_frame(Vulkan::Device &device) {
+  if (hdr.on && !wsi_videoout_hdr10()) {
+    hdr.on = false;
+    LOGI("psgopher: HDR output off: the driver's framebuffers are SDR again\n");
+  }
+  if (hdr.asked)
+    return hdr.on;
+  hdr.asked = true;
+  const bool driver = wsi_videoout_set_hdr10 && wsi_videoout_hdr10 && wsi_videoout_output_range;
+  if (hdr.want) {
+    if (!driver) {
+      LOGI("psgopher: HDR output asked for, but the graphics driver has no HDR10 framebuffers\n");
+      return false;
+    }
+    const int range = wsi_videoout_output_range();
+    if (range != 2) {
+      LOGI("psgopher: HDR output asked for, but the console's output is %s (range %d): SDR\n",
+           range == 1 ? "SDR" : "of an unknown range", range);
+      return false;
+    }
+    device.wait_idle();
+    const int rc = wsi_videoout_set_hdr10(1);
+    hdr.on = rc == 0;
+    LOGI("psgopher: HDR output %s (0x%08x): white %.0f nits, highlights %.0f nits%s\n",
+         hdr.on ? "on" : "refused by VideoOut", unsigned(rc), hdr.white, hdr.peak,
+         hdr.peak > hdr.white ? "" : " (off)");
+  } else if (driver && wsi_videoout_hdr10()) {
+    // a device made again finds the framebuffers as the last one left them
+    device.wait_idle();
+    hdr.on = wsi_videoout_set_hdr10(0) != 0;
+  }
+  return hdr.on;
+}
+
+static void psgopher_layer(Vulkan::Device &device, Vulkan::ImageHandle &image, int w, int h) {
+  if (image && int(image->get_width()) == w && int(image->get_height()) == h)
+    return;
+  auto info = Vulkan::ImageCreateInfo::render_target(w, h, VK_FORMAT_R8G8B8A8_UNORM);
+  info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+  info.initial_layout = VK_IMAGE_LAYOUT_UNDEFINED;
+  image = device.create_image(info);
+}
+
+// a layer's render pass, cleared to 0 (last frame's packing pass read it: wait for that)
+static Vulkan::RenderPassInfo psgopher_layer_pass(Vulkan::CommandBuffer &cmd, Vulkan::Image &image) {
+  cmd.image_barrier(image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                    VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, 0,
+                    VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT);
+  Vulkan::RenderPassInfo rp;
+  rp.color_attachments[0] = &image.get_view();
+  memset(&rp.clear_color[0], 0, sizeof(rp.clear_color[0]));
+  rp.num_color_attachments = 1;
+  rp.clear_attachments = 1;
+  rp.store_attachments = 1;
+  return rp;
+}
+
+// the two layers into the swapchain image, as HDR10
+static void psgopher_hdr_out(Vulkan::Device &device, Vulkan::CommandBuffer &cmd) {
+  for (auto *image : {hdr.picture.get(), hdr.overlay.get()})
+    cmd.image_barrier(*image, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                      VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
+                      VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+  Vulkan::ResourceLayout vertex_layout = {};
+  Vulkan::ResourceLayout fragment_layout = {};
+  fragment_layout.output_mask = 1 << 0;
+  fragment_layout.sets[0].sampled_image_mask = (1 << 0) | (1 << 1);
+  fragment_layout.push_constant_size = 4 * sizeof(float);
+  auto *program = device.request_program(vertex_spirv, sizeof(vertex_spirv), psgopher_hdr_fragment_spirv,
+                                         sizeof(psgopher_hdr_fragment_spirv), &vertex_layout, &fragment_layout);
+  cmd.begin_render_pass(device.get_swapchain_render_pass(Vulkan::SwapchainRenderPass::ColorOnly));
+  cmd.set_program(program);
+  cmd.set_opaque_state();
+  cmd.set_depth_test(false, false);
+  cmd.set_cull_mode(VK_CULL_MODE_NONE);
+  cmd.set_texture(0, 0, hdr.picture->get_view(), Vulkan::StockSampler::NearestClamp);
+  cmd.set_texture(0, 1, hdr.overlay->get_view(), Vulkan::StockSampler::NearestClamp);
+  const float metrics[4] = {hdr.white, hdr.peak, 0.0f, 0.0f};
+  cmd.push_constants(metrics, 0, sizeof(metrics));
+  cmd.draw(3);
+  cmd.end_render_pass();
+}
+
+// The in-game quick menu (PSGopher, ps5/host/quickmenu.cpp): the title draws it with Dear ImGui and
+// hands its triangles here, to be drawn over the game's frame with parallel-rdp's own device. It
+// runs on the emulation thread from rdp_update_screen, so the game is paused while it is up; its
+// answer becomes Gopher64's own callbacks (save and load state, reset, quit), as a hotkey's would.
+struct psgopher_overlay_vertex {
+  float x, y, u, v;
+  uint32_t rgba;
+};
+struct psgopher_overlay_command {
+  float clip[4]; // x0, y0, x1, y1 in pixels
+  uint32_t texture, first_index, index_count;
+  int32_t vertex_offset;
+};
+struct psgopher_quickmenu_answer {
+  int action; // 0 resume, 1 save state, 2 load state, 3 reset, 4 quit
+  int slot;   // for 1 and 2: the slot (0-9)
+};
+extern "C" int psgopher_quickmenu_wanted(void) __attribute__((weak));
+// the stats overlay: builds this frame's triangles (psgopher_overlay_set) and says whether it did
+extern "C" int psgopher_osd_frame(void) __attribute__((weak));
+extern "C" void psgopher_osd_release(void) __attribute__((weak));
+extern "C" psgopher_quickmenu_answer psgopher_quickmenu_run(void) __attribute__((weak));
+
+static struct {
+  std::vector<Vulkan::ImageHandle> textures; // by id (0 none)
+  const psgopher_overlay_vertex *vertices = nullptr;
+  const uint32_t *indices = nullptr;
+  const psgopher_overlay_command *commands = nullptr;
+  uint32_t vertex_count = 0, index_count = 0, command_count = 0;
+} overlay;
+
+static void psgopher_overlay_release() {
+  if (psgopher_osd_release)
+    psgopher_osd_release(); // its textures go with these
+  overlay.textures.clear();
+  overlay.vertices = nullptr;
+  overlay.command_count = 0;
+}
+
+// A texture (RGBA8, w x h) at id (from 1), made again when it changes; 0 on success.
+extern "C" int psgopher_overlay_texture(uint32_t id, int width, int height, const void *rgba) {
+  if (!wsi || id == 0 || id > 4096 || width <= 0 || height <= 0)
+    return -1;
+  auto &device = wsi->get_device();
+  auto info = Vulkan::ImageCreateInfo::immutable_2d_image(unsigned(width), unsigned(height), VK_FORMAT_R8G8B8A8_UNORM);
+  Vulkan::ImageInitialData initial = {rgba, 0, 0};
+  auto image = device.create_image(info, &initial);
+  if (!image)
+    return -1;
+  if (overlay.textures.size() <= id)
+    overlay.textures.resize(id + 1);
+  overlay.textures[id] = image;
+  return 0;
