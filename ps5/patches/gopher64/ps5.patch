+/// A cartridge's box art from libretro's thumbnails (libretro-thumbnails' Nintendo 64 set, as
+/// thumbnails.libretro.com serves it, read from its GitHub repository: the server answered 404 for
+/// every N64 name when this was written), by its No-Intro name, written to `file`: the status
+/// (200 kept; 404 libretro has none; anything else: no answer, try later).
+///
+/// # Safety
+/// `name` and `file` are NUL-terminated strings.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_cover(name: *const std::ffi::c_char, file: *const std::ffi::c_char) -> i32 {
+    // libretro's names: these characters are '_' in its file names
+    let name: String = c_text(name).chars().map(|c| if "&*/:`<>?\\|\"".contains(c) { '_' } else { c }).collect();
+    let file = c_text(file);
+    let (status, body) = https_get(
+        "raw.githubusercontent.com",
+        &format!("/libretro-thumbnails/Nintendo_-_Nintendo_64/master/Named_Boxarts/{}.png", url_encode(&name)),
+        "image/png",
+        std::time::Duration::from_secs(30),
+    );
+    if status != 200 {
+        return status as i32;
+    }
+    if !body.starts_with(b"\x89PNG\r\n\x1a\n") {
+        return 404;
+    }
+    if !body.ends_with(b"IEND\xAE\x42\x60\x82") {
+        return 0; // (cut off before its end: asked again, not kept)
+    }
+    let part = format!("{file}.part");
+    if std::fs::write(&part, &body).is_err() || std::fs::rename(&part, &file).is_err() {
+        let _ = std::fs::remove_file(&part);
+        return 500;
+    }
+    200
+}
