+static void psgopher_layer(Vulkan::Device &device, Vulkan::ImageHandle &image, int w, int h) {
+  if (image && int(image->get_width()) == w && int(image->get_height()) == h)
+    return;
+  auto info = Vulkan::ImageCreateInfo::render_target(w, h, VK_FORMAT_R8G8B8A8_UNORM);
+  info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+  info.initial_layout = VK_IMAGE_LAYOUT_UNDEFINED;
+  image = device.create_image(info);
+}
+
+// a layer's render pass, cleared to 0 (last frame's packing pass read it: wait for that)
+static Vulkan::RenderPassInfo psgopher_layer_pass(Vulkan::CommandBuffer &cmd, Vulkan::Image &image) {
+  cmd.image_barrier(image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL,
+                    VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, 0,
+                    VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT);
+  Vulkan::RenderPassInfo rp;
+  rp.color_attachments[0] = &image.get_view();
+  memset(&rp.clear_color[0], 0, sizeof(rp.clear_color[0]));
+  rp.num_color_attachments = 1;
+  rp.clear_attachments = 1;
+  rp.store_attachments = 1;
+  return rp;
+}
+
+// the two layers into the swapchain image, as HDR10
+static void psgopher_hdr_out(Vulkan::Device &device, Vulkan::CommandBuffer &cmd) {
+  for (auto *image : {hdr.picture.get(), hdr.overlay.get()})
+    cmd.image_barrier(*image, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                      VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT, VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT,
+                      VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+  Vulkan::ResourceLayout vertex_layout = {};
+  Vulkan::ResourceLayout fragment_layout = {};
+  fragment_layout.output_mask = 1 << 0;
+  fragment_layout.sets[0].sampled_image_mask = (1 << 0) | (1 << 1);
+  fragment_layout.push_constant_size = 4 * sizeof(float);
+  auto *program = device.request_program(vertex_spirv, sizeof(vertex_spirv), psgopher_hdr_fragment_spirv,
+                                         sizeof(psgopher_hdr_fragment_spirv), &vertex_layout, &fragment_layout);
