+/// Gopher64's settings that are text, by name (as `psgopher_setting_get`'s): `input.gb_rom_path.N`
+/// and `input.gb_ram_path.N` (the Transfer Pak's Game Boy ROM and save), `input.input_profile_binding.N`
+/// (the port's input profile) and `input.controller_assignment.N` (the controller's path,
+/// `ps5:padK`; "" none). Its length, or -1 for a name Gopher64 has not.
+///
+/// # Safety
+/// `name` is a NUL-terminated string; `buffer` holds `size` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_setting_text(name: *const std::ffi::c_char, buffer: *mut std::ffi::c_char, size: usize) -> i32 {
+    let Some(name) = setting_name(name) else { return -1 };
+    let text = std::panic::catch_unwind(|| {
+        let config = crate::ui::config::Config::new();
+        let index = |prefix: &str| name.strip_prefix(prefix)?.parse::<usize>().ok().filter(|i| *i < 4);
+        if let Some(i) = index("input.gb_rom_path.") {
+            Some(config.input.gb_rom_path[i].clone())
+        } else if let Some(i) = index("input.gb_ram_path.") {
+            Some(config.input.gb_ram_path[i].clone())
+        } else if let Some(i) = index("input.input_profile_binding.") {
+            Some(config.input.input_profile_binding[i].clone())
+        } else if let Some(i) = index("input.controller_assignment.") {
+            Some(config.input.controller_assignment[i].clone().unwrap_or_default())
+        } else {
+            None
+        }
+    })
+    .ok()
+    .flatten();
+    match text {
+        Some(text) => {
+            copy_out(&text, buffer, size);
+            text.len() as i32
+        }
+        None => -1,
+    }
+}
+
+/// Sets one (see `psgopher_setting_text`) and writes config.json; false for a name Gopher64 has not
+/// or a profile it has not.
+///
+/// # Safety
+/// `name` and `value` are NUL-terminated strings.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_setting_text_set(name: *const std::ffi::c_char, value: *const std::ffi::c_char) -> bool {
+    let (Some(name), Some(value)) = (setting_name(name), setting_name(value)) else { return false };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        let index = |prefix: &str| name.strip_prefix(prefix)?.parse::<usize>().ok().filter(|i| *i < 4);
+        if let Some(i) = index("input.gb_rom_path.") {
+            config.input.gb_rom_path[i] = value.clone();
+        } else if let Some(i) = index("input.gb_ram_path.") {
+            config.input.gb_ram_path[i] = value.clone();
+        } else if let Some(i) = index("input.input_profile_binding.") {
+            if !config.input.input_profiles.contains_key(&value) {
+                return false;
+            }
+            config.input.input_profile_binding[i] = value.clone();
+        } else if let Some(i) = index("input.controller_assignment.") {
+            config.input.controller_assignment[i] = if value.is_empty() { None } else { Some(value.clone()) };
+        } else {
+            return false;
+        }
+        true
+    })
+    .unwrap_or(false)
+}
+
+/// The input profiles' names, one a line ("default" among them).
+///
+/// # Safety
+/// `buffer` holds `size` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profiles(buffer: *mut std::ffi::c_char, size: usize) -> i32 {
+    let names = std::panic::catch_unwind(|| {
+        let config = crate::ui::config::Config::new();
+        config.input.input_profiles.keys().cloned().collect::<Vec<_>>().join("\n")
+    })
+    .unwrap_or_default();
+    copy_out(&names, buffer, size);
+    names.len() as i32
+}
+
+/// A new profile by that name, Gopher64's default bindings (false when the name is taken or empty).
+///
+/// # Safety
+/// `name` is a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profile_new(name: *const std::ffi::c_char) -> bool {
+    let Some(name) = setting_name(name) else { return false };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        if name.trim().is_empty() || config.input.input_profiles.contains_key(&name) {
+            return false;
+        }
+        config.input.input_profiles.insert(name.clone(), crate::ui::input_profile::get_default_profile());
+        true
+    })
+    .unwrap_or(false)
+}
+
+/// Takes a profile away (not "default"); the ports that had it get "default".
+///
+/// # Safety
+/// `name` is a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profile_delete(name: *const std::ffi::c_char) -> bool {
+    let Some(name) = setting_name(name) else { return false };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        if name == "default" || config.input.input_profiles.remove(&name).is_none() {
+            return false;
+        }
+        for binding in config.input.input_profile_binding.iter_mut() {
+            if *binding == name {
+                *binding = "default".to_string();
+            }
+        }
+        true
+    })
+    .unwrap_or(false)
+}
+
+/// One input of a profile (an index of Gopher64's input_profile: 0 D Right .. 17 Stick Up, 18 the
+/// Hotkey Activator), its controller binding (the second of its two; the first is the keyboard's):
+/// kind 0 none, 1 a gamepad button (id: SDL_GamepadButton), 2 a gamepad axis (id: SDL_GamepadAxis,
+/// axis: its direction, 1 or -1), 3 a joystick's button, hat or axis (DirectInput). False for a
+/// profile or index Gopher64 has not.
+///
+/// # Safety
+/// `name` is a NUL-terminated string; the outputs are valid pointers.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profile_binding(name: *const std::ffi::c_char, index: i32, kind: *mut i32, id: *mut i32, axis: *mut i32) -> bool {
+    let Some(name) = setting_name(name) else { return false };
+    let found = std::panic::catch_unwind(|| {
+        let config = crate::ui::config::Config::new();
+        let profile = config.input.input_profiles.get(&name)?;
+        let slot = profile.inputs.get(usize::try_from(index).ok()?)?;
+        Some(match &slot[1] {
+            None => (0, 0, 0),
+            Some(crate::ui::config::InputItem::ControllerButton(b)) => (1, b.id, 0),
+            Some(crate::ui::config::InputItem::ControllerAxis(a)) => (2, a.id, a.axis as i32),
+            Some(_) => (3, 0, 0),
+        })
+    })
+    .ok()
+    .flatten();
+    match found {
+        Some((k, i, a)) => {
+            unsafe {
+                *kind = k;
+                *id = i;
+                *axis = a;
+            }
+            true
+        }
+        None => false,
+    }
+}
+
+/// Binds one input of a profile to the controller (see `psgopher_profile_binding`; kind 0 clears
+/// it). The keyboard's binding stays.
+///
+/// # Safety
+/// `name` is a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profile_bind(name: *const std::ffi::c_char, index: i32, kind: i32, id: i32, axis: i32) -> bool {
+    let Some(name) = setting_name(name) else { return false };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        let Some(profile) = config.input.input_profiles.get_mut(&name) else { return false };
+        let Some(slot) = usize::try_from(index).ok().and_then(|i| profile.inputs.get_mut(i)) else { return false };
+        slot[1] = match kind {
+            0 => None,
+            1 => Some(crate::ui::config::InputItem::ControllerButton(crate::ui::config::InputKeyButton { id })),
+            2 => Some(crate::ui::config::InputItem::ControllerAxis(crate::ui::config::InputControllerAxis {
+                id,
+                axis: if axis < 0 { -1 } else { 1 },
+                initial_state: 0,
+            })),
+            _ => return false,
+        };
+        true
+    })
+    .unwrap_or(false)
+}
+
+/// A profile's number: `what` 0 its deadzone (Gopher64's units), 1 DirectInput (the pad read as a
+/// raw joystick, 0 or 1). With `set`, `value` is written first. -1 for a profile Gopher64 has not.
+///
+/// # Safety
+/// `name` is a NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_profile_number(name: *const std::ffi::c_char, what: i32, value: i64, set: bool) -> i64 {
+    let Some(name) = setting_name(name) else { return -1 };
+    std::panic::catch_unwind(|| {
+        let mut config = crate::ui::config::Config::new();
+        let Some(profile) = config.input.input_profiles.get_mut(&name) else { return -1 };
+        match what {
+            0 => {
+                if set {
+                    profile.deadzone = value.clamp(0, 100) as i32;
+                }
+                profile.deadzone as i64
+            }
+            1 => {
+                if set {
+                    profile.dinput = value != 0;
+                }
+                profile.dinput as i64
+            }
+            _ => -1,
+        }
+    })
+    .unwrap_or(-1)
+}
