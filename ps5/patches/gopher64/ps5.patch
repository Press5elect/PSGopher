+    #[test]
+    fn review_dma_stays_in_the_buffer_it_started_in() {
+        let mut device = with_disk();
+        device.rdram.mem = vec![0; 0x800000];
+        for i in 0..DS_SIZE {
+            device.dd.state.regs.ds[i] = i as u8;
+        }
+        device.dd.state.regs.ms[0] = 0x99;
+        // from DS 0xF8, 16 bytes: 8 from DS, then the bus keeps its last halfword (not MS's bytes)
+        let (_, to_rdram) = pi_handlers(&device, 0x0500_04F8).unwrap();
+        to_rdram(&mut device, 0x0500_04F8, 0x200, 16);
+        let got: Vec<u8> = (0..16)
+            .map(|i| device.rdram.mem[(0x200 + i) ^ device.byte_swap])
+            .collect();
+        assert_eq!(&got[..8], &[0xF8, 0xF9, 0xFA, 0xFB, 0xFC, 0xFD, 0xFE, 0xFF]);
+        assert_eq!(&got[8..], &[0xFE, 0xFF, 0xFE, 0xFF, 0xFE, 0xFF, 0xFE, 0xFF]);
+        // to C2S from 0x3FC, 8 bytes: the last 4 of C2S only, DS untouched
+        for i in 0..8 {
+            device.rdram.mem[(0x300 + i) ^ device.byte_swap] = 0x55;
+        }
+        let (from_rdram, _) = pi_handlers(&device, 0x0500_03FC).unwrap();
+        from_rdram(&mut device, 0x0500_03FC, 0x300, 8);
+        assert_eq!(&device.dd.state.regs.c2s[0x3FC..], &[0x55; 4]);
+        assert_eq!(&device.dd.state.regs.ds[..4], &[0, 1, 2, 3]);
+        // from no device: the start address's low half, as ares' bus latch
+        let (_, to_rdram) = pi_handlers(&device, 0x0500_05C0).unwrap();
+        to_rdram(&mut device, 0x0500_05C0, 0x400, 4);
+        let got: Vec<u8> = (0..4)
+            .map(|i| device.rdram.mem[(0x400 + i) ^ device.byte_swap])
+            .collect();
+        assert_eq!(got, vec![0x05, 0xC0, 0x05, 0xC0]);
+    }
