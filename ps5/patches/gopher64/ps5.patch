+/// Device::clone_state, after a restore that changed the disk's writes: the writes file follows
+/// the loaded state a second later (as after a write)
+pub fn after_restore(device: &mut device::Device) {
+    let second = device.cpu.clock_rate;
+    device::events::create_event(device, device::events::EVENT_TYPE_DD_SAVE, second);
+}
