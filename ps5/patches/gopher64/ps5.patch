+/// GET https://host/path with rustls over a blocking socket (Tokio's sockets are refused on the
+/// console, so reqwest cannot be used; the roots are webpki-roots', the console has no store):
+/// the status (0 when the network or TLS failed) and the body.
+fn https_get(host: &str, path: &str, accept: &str, timeout: std::time::Duration) -> (u16, Vec<u8>) {
+    use std::io::{Read, Write};
+    crate::ui::install_default_crypto_provider();
+    static CONFIG: std::sync::OnceLock<std::sync::Arc<rustls::ClientConfig>> = std::sync::OnceLock::new();
+    let config = CONFIG
+        .get_or_init(|| {
+            let roots = rustls::RootCertStore { roots: webpki_roots::TLS_SERVER_ROOTS.to_vec() };
+            std::sync::Arc::new(rustls::ClientConfig::builder().with_root_certificates(roots).with_no_client_auth())
+        })
+        .clone();
+    let failed = |what: &str, why: String| {
+        log_line(&format!("web: {host}: {what}: {why}"));
+        (0u16, Vec::new())
+    };
+    let Ok(name) = rustls::pki_types::ServerName::try_from(host.to_string()) else {
+        return failed("name", "not a host name".into());
+    };
+    let address = match std::net::ToSocketAddrs::to_socket_addrs(&(host, 443)) {
+        Ok(mut list) => match list.find(|a| a.is_ipv4()) {
+            Some(a) => a,
+            None => return failed("address", "none for IPv4".into()),
+        },
+        Err(e) => return failed("address", e.to_string()),
+    };
+    let socket = match std::net::TcpStream::connect_timeout(&address, std::time::Duration::from_secs(10)) {
+        Ok(s) => s,
+        Err(e) => return failed("connect", e.to_string()),
+    };
+    let _ = socket.set_read_timeout(Some(timeout));
+    let _ = socket.set_write_timeout(Some(timeout));
+    let connection = match rustls::ClientConnection::new(config, name) {
+        Ok(c) => c,
+        Err(e) => return failed("TLS", e.to_string()),
+    };
+    let mut tls = rustls::StreamOwned::new(connection, socket);
+    let request = format!(
+        "GET {path} HTTP/1.1\r\nHost: {host}\r\nUser-Agent: PSGopher (PlayStation 5 homebrew)\r\nAccept: {accept}\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n"
+    );
+    if let Err(e) = tls.write_all(request.as_bytes()) {
+        return failed("request", e.to_string());
+    }
+    let mut data = Vec::new();
+    let mut chunk = [0u8; 16384];
+    loop {
+        match tls.read(&mut chunk) {
+            Ok(0) => break,
+            Ok(n) => {
+                data.extend_from_slice(&chunk[..n]);
+                if data.len() > 16 << 20 {
+                    return failed("answer", "longer than 16 MiB".into());
+                }
+            }
+            // (a server closing without TLS's close_notify: what came is kept, its length checked below)
+            Err(e) if e.kind() == std::io::ErrorKind::UnexpectedEof => break,
+            Err(e) => return failed("answer", e.to_string()),
+        }
+    }
+    let Some(end) = data.windows(4).position(|w| w == b"\r\n\r\n") else {
+        return failed("answer", "no HTTP head".into());
+    };
+    let head = String::from_utf8_lossy(&data[..end]).to_ascii_lowercase();
+    let status: u16 = head.split_whitespace().nth(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let raw = &data[end + 4..];
+    let body = if head.contains("\r\ntransfer-encoding: chunked") {
+        let mut plain = Vec::new();
+        let mut at = 0;
+        let mut whole = false;
+        while at < raw.len() {
+            let Some(le) = raw[at..].windows(2).position(|w| w == b"\r\n") else { break };
+            let line = String::from_utf8_lossy(&raw[at..at + le]);
+            let Ok(len) = usize::from_str_radix(line.split(';').next().unwrap_or("").trim(), 16) else { break };
+            if len == 0 {
+                whole = true;
+                break;
+            }
+            let start = at + le + 2;
+            if len > raw.len().saturating_sub(start) {
+                break;
+            }
+            plain.extend_from_slice(&raw[start..start + len]);
+            at = start + len + 2;
+        }
+        if !whole {
+            return failed("answer", "cut short".into());
+        }
+        plain
+    } else {
+        let mut body = raw.to_vec();
+        if let Some(at) = head.find("\r\ncontent-length:") {
+            let want: usize = head[at + 17..].split("\r\n").next().unwrap_or("").trim().parse().unwrap_or(0);
+            if body.len() < want {
+                return failed("answer", "cut short".into());
+            }
+            body.truncate(want);
+        }
+        body
+    };
+    (status, body)
+}
+
+fn url_encode(text: &str) -> String {
+    let mut out = String::new();
+    for b in text.bytes() {
+        if b.is_ascii_alphanumeric() || b"-_.~".contains(&b) {
+            out.push(b as char);
+        } else {
+            out.push_str(&format!("%{b:02X}"));
+        }
+    }
+    out
+}
+
+/// A game's description from Wikipedia (as OGBox finds one: the first of five search results
+/// whose description says "video game", then its summary): the status (200: "title\ntext" in
+/// `buffer`; 404: no article about the game; anything else: no answer, try later).
+///
+/// # Safety
+/// `name` is a NUL-terminated string; `buffer` has room for `size` bytes.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_about(name: *const std::ffi::c_char, buffer: *mut std::ffi::c_char, size: usize) -> i32 {
+    let name = c_text(name);
+    let timeout = std::time::Duration::from_secs(30);
+    let name = wiki_name(&name);
+    let (status, body) = https_get(
+        "en.wikipedia.org",
+        &format!("/w/rest.php/v1/search/page?q={}&limit=10", url_encode(&format!("{name} video game"))),
+        "application/json",
+        timeout,
+    );
+    if status != 200 {
+        return status as i32;
+    }
+    let Ok(found) = serde_json::from_slice::<serde_json::Value>(&body) else { return 404 };
+    let key = found["pages"].as_array().and_then(|pages| {
+        pages.iter().find_map(|page| {
+            let about = page["description"].as_str().unwrap_or("").to_ascii_lowercase();
+            let title = page["title"].as_str().unwrap_or("");
+            // a game's article, and this game's: its title is the name (the search also offers
+            // articles that merely mention it; on the console "2048" found another game's)
+            if about.contains("video game") && wiki_title_matches(&name, title) && wiki_n64_years(title, &about) {
+                page["key"].as_str().map(str::to_string)
+            } else {
+                None
+            }
+        })
+    });
+    let Some(key) = key else { return 404 };
+    let (status, body) = https_get("en.wikipedia.org", &format!("/api/rest_v1/page/summary/{}", url_encode(&key)), "application/json", timeout);
+    if status != 200 {
+        return status as i32;
+    }
+    let Ok(summary) = serde_json::from_slice::<serde_json::Value>(&body) else { return 404 };
+    let Some(text) = summary["extract"].as_str().filter(|t| !t.is_empty()) else { return 404 };
+    let title = summary["title"].as_str().unwrap_or(&key);
+    copy_out(&format!("{title}\n{text}"), buffer, size);
+    200
+}
+
+/// A No-Intro name as Wikipedia titles it: "Bug's Life, A" -> "A Bug's Life" (the article moved
+/// back to the front, before any " - " subtitle).
+fn wiki_name(name: &str) -> String {
+    let (main, rest) = match name.find(" - ") {
+        Some(at) => (&name[..at], &name[at..]),
+        None => (name, ""),
+    };
+    for article in [", The", ", A", ", An"] {
+        if let Some(stem) = main.strip_suffix(article) {
+            return format!("{} {stem}{rest}", &article[2..]);
+        }
+    }
+    name.to_string()
+}
+
+/// Letters and digits only, lower case, with the accents Wikipedia's titles use folded
+/// ("Pokémon" and "Pokemon" are the same name).
+fn wiki_compact(text: &str) -> String {
+    let mut out = String::new();
+    for c in text.chars() {
+        let c = match c {
+            'à'..='å' | 'À'..='Å' | 'ā' | 'Ā' => 'a',
+            'è'..='ë' | 'È'..='Ë' | 'ē' | 'Ē' => 'e',
+            'ì'..='ï' | 'Ì'..='Ï' | 'ī' | 'Ī' => 'i',
+            'ò'..='ö' | 'Ò'..='Ö' | 'ō' | 'Ō' | 'ø' | 'Ø' => 'o',
+            'ù'..='ü' | 'Ù'..='Ü' | 'ū' | 'Ū' => 'u',
+            'ñ' | 'Ñ' => 'n',
+            'ç' | 'Ç' => 'c',
+            c => c,
+        };
+        if c.is_ascii_alphanumeric() {
+            out.push(c.to_ascii_lowercase());
+        }
+    }
+    out
+}
+
+/// The article's title (without its " (...)" disambiguation) names the cartridge: one holds the
+/// other, and the shorter is at least 60% of the longer ("007 - The World Is Not Enough" and
+/// "The World Is Not Enough" match; "2048" and "Wipeout 2048" do not).
+fn wiki_title_matches(name: &str, title: &str) -> bool {
+    let title = title.find(" (").map_or(title, |at| &title[..at]);
+    let (a, b) = (wiki_compact(name), wiki_compact(title));
+    let (short, long) = if a.len() <= b.len() { (a, b) } else { (b, a) };
+    if !short.is_empty() && long.contains(&short) && short.len() * 10 >= long.len() * 6 {
+        return true;
+    }
+    // the same words in another order: No-Intro's "007 - GoldenEye", the article's "GoldenEye 007"
+    let words = |text: &str| {
+        let mut w: Vec<String> = text.split(|c: char| !c.is_alphanumeric()).map(wiki_compact).filter(|w| !w.is_empty()).collect();
+        w.sort();
+        w
+    };
+    let (x, y) = (words(name), words(title));
+    !x.is_empty() && x == y
+}
+
+/// The article is of the N64's years when it names one (1995-2004, in its title or description):
+/// "007 - GoldenEye" found "GoldenEye 007 (2010 video game)", the later game of the name.
+fn wiki_n64_years(title: &str, description: &str) -> bool {
+    let year = |text: &str| -> Option<u32> {
+        let b = text.as_bytes();
+        (0..b.len().saturating_sub(3)).find_map(|i| {
+            let four = &b[i..i + 4];
+            let edge = |j: usize| j >= b.len() || !b[j].is_ascii_digit();
+            let starts = i == 0 || !b[i - 1].is_ascii_digit();
+            if starts && edge(i + 4) && four.iter().all(u8::is_ascii_digit) && (four[0] == b'1' || four[0] == b'2') {
+                std::str::from_utf8(four).ok()?.parse().ok().filter(|y| (1950..2100).contains(y))
+            } else {
+                None
+            }
+        })
+    };
+    match year(title).or_else(|| year(description)) {
+        Some(y) => (1995..=2004).contains(&y),
+        None => true,
+    }
+}
