+        assert_eq!(&sector[..2], &[0xA5, 0xA5]);
+        assert!(sector[2..].iter().all(|b| *b == 0), "zeros past the block");
+        let mut copy = BTreeMap::new();
+        disk.write_from(&mut copy, index, 1, &[0x77]);
+        disk.write_from(&mut copy, 7, 0, &[0x11]);
+        disk.write_from(&mut copy, index, last, &[1, 2, 3, 4]);
+        disk.write(&mut overlay, index, last, 1);
+        disk.write(&mut overlay, index, last + 1, 2);
+        assert_eq!(copy, overlay);
+
+        let file = encode_writes(&disk.hash, &overlay);
+        assert_eq!(&file[..8], WRITES_MAGIC);
+        let back = decode_writes(&file, &disk.hash).unwrap();
+        assert_eq!(back, overlay);
+        assert_eq!(disk.read(&back, index, 1), 0x77);
+        assert!(
+            decode_writes(&file, &"0".repeat(64)).is_err(),
+            "another image's writes"
+        );
+        assert!(
+            decode_writes(&file[..file.len() - 1], &disk.hash).is_err(),
+            "truncated"
+        );
+        assert!(decode_writes(b"nonsense", &disk.hash).is_err());
+    }
+}
