+// PSGopher: the loads and stores take a KSEG0 address that hits the data cache inline, without
+// the generic path (translate_address, then data_read/data_write and the cache's miss handling).
+// For such an address translate_address is the direct, cached mapping, so the result is the same:
+// the cached word, one cycle per word read (dcache_read), the word written and the line dirty
+// (dcache_write). Anything else (KUSEG/KSEG2 through the TLB, KSEG1, a miss) returns None/false and
+// the handler takes the generic path, unchanged.
+#[inline(always)]
+fn kseg0_dcache_hit(device: &device::Device, address: u64) -> Option<usize> {
+    if address & 0xE0000000 != 0x80000000 {
+        return None;
+    }
+    let line_index = device::cache::dcache_line(address);
+    device::cache::dcache_hit(device, line_index, address & 0x1FFFFFFF).then_some(line_index)
