+
+#[inline(always)]
+pub fn write_hit(device: &mut device::Device, address: u64, value: u32, mask: u32) -> bool {
+    let Some(line_index) = kseg0_dcache_hit(device, address) else {
+        return false;
+    };
+    let line = &mut device.memory.dcache[line_index];
+    masked_write_32(&mut line.words[((address >> 2) & 3) as usize], value, mask);
+    line.dirty = true;
