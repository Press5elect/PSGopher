+    const ASIC_DATA: u64 = 0x0500_0500;
+    const ASIC_CMD_STATUS: u64 = 0x0500_0508;
+    const ASIC_BM_CTL: u64 = 0x0500_0510;
+    const ASIC_HOST_SECBYTE: u64 = 0x0500_0528;
+    const ASIC_ID: u64 = 0x0500_0540;
+    const DS: u64 = 0x0500_0400;
+    const STATUS_BUSY: u32 = 1 << 7;
+    const STATUS_DISK_PRESENT: u32 = 1 << 8;
+    const STATUS_MECHA_INT: u32 = 1 << 9;
+    const STATUS_BM_INT: u32 = 1 << 10;
+
+    fn attached(
+        disk: Option<disk::Disk>,
+        writes_path: Option<std::path::PathBuf>,
+    ) -> Box<device::Device> {
+        let mut device = device::Device::new(false);
+        device.cpu.clock_rate = 93_750_000;
+        device.cart.rtc_timestamp = 1_700_000_000;
+        let mut ipl = vec![0u8; IPL_SIZE];
+        ipl[0x3B..0x3F].copy_from_slice(b"NDDJ");
+        ipl[0x40..0x44].copy_from_slice(&0x1234_5678u32.to_be_bytes());
+        let (ipl, ipl_kind, _) = identify_ipl(ipl).unwrap();
+        let disk_hash = disk.as_ref().map(|d| d.hash.clone()).unwrap_or_default();
+        device.dd = Dd {
+            attached: true,
+            cart_absent: true,
+            ipl,
+            ipl_kind,
+            disk,
+            writes_path,
+            dirty: false,
+            state: DdState {
+                disk_hash,
+                ..Default::default()
+            },
+        };
+        device::memory::init(&mut device);
+        start(&mut device);
+        device
+    }
+
+    fn with_disk() -> Box<device::Device> {
+        let image = disk::test_images::synthetic_ndd(0, b"TSTJ");
+        attached(Some(disk::Disk::parse(image).unwrap()), None)
+    }
+
+    fn read(device: &mut device::Device, address: u64) -> u32 {
+        let page = (address >> 16) as usize;
+        device.memory.memory_map_read[page](device, address, device::memory::AccessSize::Word)
+    }
+
+    fn write(device: &mut device::Device, address: u64, value: u32) {
+        let page = (address >> 16) as usize;
+        device.memory.memory_map_write[page](device, address, value, 0xFFFF_FFFF)
+    }
+
+    fn status(device: &mut device::Device) -> u32 {
+        read(device, ASIC_CMD_STATUS) >> 16
+    }
+
+    /// Run a pending 64DD event's handler (what the CPU loop does when its count comes)
+    fn run_event(device: &mut device::Device, event: usize) {
+        assert!(device.cpu.events[event].enabled, "event {event} pending");
+        device.cpu.events[event].enabled = false;
+        match event {
+            EVENT_TYPE_DD_MECHA => mecha_event(device),
+            EVENT_TYPE_DD_BM => bm_event(device),
+            EVENT_TYPE_DD_MOTOR => motor_event(device),
+            EVENT_TYPE_DD_CLOCK => clock_event(device),
+            EVENT_TYPE_DD_SAVE => save_event(device),
+            _ => unreachable!(),
+        }
+    }
+
+    fn command(device: &mut device::Device, command: u16, data: u16) {
+        write(device, ASIC_DATA, u32::from(data) << 16);
+        write(device, ASIC_CMD_STATUS, u32::from(command) << 16);
+        assert_ne!(status(device) & STATUS_BUSY, 0);
+        run_event(device, EVENT_TYPE_DD_MECHA);
+        assert_eq!(status(device) & STATUS_BUSY, 0);
+        assert_ne!(status(device) & STATUS_MECHA_INT, 0);
+        // the MECHA interrupt reset (BM_CTL bit 8)
+        write(device, ASIC_BM_CTL, 1 << 24);
+        assert_eq!(status(device) & STATUS_MECHA_INT, 0);
+    }
