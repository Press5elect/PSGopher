+        // the sector-wide accessors agree with the byte ones
+        let mut sector = [0u8; 0xE8];
+        disk.read_into(&overlay, index, 0, &mut sector);
+        assert_eq!(sector[1], 0x77);
+        assert!((0..0xE8).all(|i| sector[i] == disk.read(&overlay, index, i as u32)));
