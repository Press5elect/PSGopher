+/// Synthetic images for the tests (no real disk is used anywhere)
+#[cfg(test)]
+pub(crate) mod test_images {
+    use super::*;
+
+    pub(crate) const RETAIL_MAGIC: [u8; 4] = [0xE8, 0x48, 0xD3, 0x16];
+
+    pub(crate) fn system_sector(magic: [u8; 4], disk_type: u8, size: usize) -> Vec<u8> {
+        let mut s = vec![0u8; size];
+        s[0..4].copy_from_slice(&magic);
+        s[4] = 0x10;
+        s[5] = 0x10 + disk_type;
+        s[0x18..0x1C].copy_from_slice(&[0xFF; 4]);
+        s[0x1C] = 0x80;
+        // zone defect counts (0x08..0x18) and tracks (0x20..): none
+        s
+    }
+
+    pub(crate) fn fill_block(image: &mut [u8], offset: usize, sector: &[u8]) {
+        for n in 0..SECTORS_PER_BLOCK {
+            image[offset + n * sector.len()..offset + (n + 1) * sector.len()]
+                .copy_from_slice(sector);
+        }
+    }
+
+    /// A retail NDD: valid system area at LBA 0, 1, 8, 9, disk ID at 14, 15, and every other
+    /// logical block starting with its LBA (big-endian) followed by 0xA5
+    pub(crate) fn synthetic_ndd(disk_type: u8, id: &[u8; 4]) -> Vec<u8> {
+        let mut image = vec![0u8; NDD_SIZE];
+        let mut position = 0usize;
+        for lba in 0..LBAS {
+            let size = lba_size(disk_type as usize, lba) as usize;
+            image[position..position + 4].copy_from_slice(&lba.to_be_bytes());
+            image[position + 4..position + size].fill(0xA5);
+            position += size;
+        }
+        assert_eq!(position, NDD_SIZE);
+        let block0 = BLOCK_SIZE[0] as usize;
+        let system = system_sector(RETAIL_MAGIC, disk_type, 0xE8);
+        for &lba in &SYSTEM_BLOCKS {
+            fill_block(&mut image, lba * block0, &system);
+        }
+        let mut id_sector = vec![0u8; 0xE8];
+        id_sector[..4].copy_from_slice(id);
+        for &lba in &DISK_ID_BLOCKS {
+            fill_block(&mut image, lba * block0, &id_sector);
+        }
+        image
+    }
+}
