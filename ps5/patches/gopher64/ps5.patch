+        command(&mut device, command::GET_RTC_DAY_HOUR, 0);
+        assert_eq!(read(&mut device, ASIC_DATA) >> 16, 0x0100);
+        command(&mut device, command::GET_RTC_YEAR_MONTH, 0);
+        assert_eq!(read(&mut device, ASIC_DATA) >> 16, 0x0001);
+        // leap years (two-digit), and an invalid time stops the clock
+        let mut rtc = [0x24, 0x02, 0x28, 0x23, 0x59, 0x59];
+        rtc_tick_second(&mut rtc);
+        assert_eq!(rtc, [0x24, 0x02, 0x29, 0, 0, 0]);
+        let mut rtc = [0x23, 0x02, 0x28, 0x23, 0x59, 0x59];
+        rtc_tick_second(&mut rtc);
+        assert_eq!(rtc, [0x23, 0x03, 0x01, 0, 0, 0]);
+        let mut rtc = [0x23, 0x13, 0x01, 0, 0, 0];
+        rtc_tick_second(&mut rtc);
+        assert_eq!(rtc, [0x23, 0x13, 0x01, 0, 0, 0]);
+    }
