+
+impl Dd {
+    /// A save state's copy and its restore (savestates.rs, Device::clone_state): the registers and
+    /// the medium's writes; the IPL and the image are not part of a state, like the cartridge ROM
+    /// True when the medium's writes changed (a restore): Device::clone_state then schedules
+    /// the writes file (after_restore)
+    pub fn clone_state_from(&mut self, other: &Dd) -> bool {
+        let overlay_changed = self.attached && self.state.overlay != other.state.overlay;
+        self.state.clone_from(&other.state);
+        if self.attached {
+            self.state.regs.status.disk_present = self.disk.is_some();
+            if overlay_changed {
+                self.dirty = true;
+            }
+        }
+        overlay_changed
+    }
+}
