+/// The IPL's model, from its header's ID (ares: dd.cpp connect, cic.cpp)
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Default)]
+pub enum IplKind {
+    #[default]
+    Unknown,
+    Japan,       // NDDJ, CIC-NUS-8303
+    Usa,         // NDDE, CIC-NUS-DDUS
+    Development, // NDXJ, CIC-NUS-8401
+}
+
+impl IplKind {
+    fn from_id(id: &[u8]) -> IplKind {
+        match id {
+            b"NDDJ" => IplKind::Japan,
+            b"NDDE" => IplKind::Usa,
+            b"NDXJ" => IplKind::Development,
+            _ => IplKind::Unknown,
+        }
+    }
+    pub fn cic(self) -> &'static str {
+        match self {
+            IplKind::Japan | IplKind::Unknown => "CIC-NUS-8303",
+            IplKind::Usa => "CIC-NUS-DDUS",
+            IplKind::Development => "CIC-NUS-8401",
+        }
+    }
+    /// The seed the PIF passes to the IPL's boot code
+    pub fn seed(self) -> u8 {
+        match self {
+            IplKind::Usa => 0xDE,
+            _ => 0xDD,
+        }
+    }
+    pub fn region(self) -> &'static str {
+        match self {
+            IplKind::Japan => "NTSC-J",
+            IplKind::Usa => "NTSC-U",
+            IplKind::Development => "NTSC-DEV",
+            IplKind::Unknown => "unknown",
+        }
+    }
+    fn disk_region(self) -> Option<disk::Region> {
+        match self {
+            IplKind::Japan => Some(disk::Region::Japan),
+            IplKind::Usa => Some(disk::Region::Usa),
+            IplKind::Development => Some(disk::Region::Development),
+            IplKind::Unknown => None,
+        }
+    }
+}
