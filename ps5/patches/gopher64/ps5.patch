+#ifdef PSGOPHER
+// PSGopher (PS5): parallel-rdp's command processing on its own thread (psgopher.ini: rdp_threaded,
+// PSGOPHER_RDP_THREADED; src/ui/video.rs). The snapshot filter above cannot run there: the worker
+// would copy the texture's RDRAM later than the command was enqueued, after the CPU may have
+// written it. So every texture load's RDRAM is marked as an RDP read as it is enqueued, as the
+// filter does for the loads it turns down (and as Gopher64 did before it had the filter): the GPU
+// reads it in place, and an emulated write to it waits for the GPU first. The range is the one
+// Renderer::load_tile_iteration and prepare_tmem_upload read, taken from the commands here
+// (texture_image mirrors CommandProcessor::op_set_texture_image; it is not in the save state:
+// rdp_load_state takes it from the render state it restores). Off (single-threaded) none of this
+// runs.
+static bool rdp_threaded;
+static struct {
+  uint32_t addr, width, size;
+} rdp_texture_image;
+
+static void mark_rdram_read_wrapped(uint64_t address, uint64_t length) {
+  const uint64_t size = gfx_info.RDRAM_SIZE;
+  address &= size - 1;
+  length = std::min<uint64_t>(length, size);
+  const uint64_t first = std::min(length, size - address);
+  rdram_tracker.mark(address, first, RdramTracker::Access::Read, mark_stamp());
+  if (length > first)
+    rdram_tracker.mark(0, length - first, RdramTracker::Access::Read, mark_stamp());
+}
+
+static void mark_texture_load(RDP::Op op, uint32_t w1, uint32_t w2) {
+  const uint32_t size = rdp_texture_image.size; // 0 4-bit (parallel-rdp refuses the load), 1 8, 2 16, 3 32
+  if (size == 0)
+    return;
+  const uint32_t slo = (w1 >> 12) & 0xfff, tlo = w1 & 0xfff;
+  const uint32_t shi = (w2 >> 12) & 0xfff, thi = w2 & 0xfff;
+  const uint32_t bytes_per_texel = 1u << (size - 1);
+  const bool tlut = op == RDP::Op::LoadTLut;
+  uint32_t upload_x, upload_y, width, height;
+  if (op == RDP::Op::LoadBlock) {
+    width = (shi - slo + 1) & 0xfff;
+    if (!width || width > 2048)
+      return;
+    upload_x = slo, upload_y = tlo, height = 1;
+  } else {
+    if ((thi >> 2) < (tlo >> 2))
+      return;
+    width = (((shi >> 2) - (slo >> 2)) + 1) & 0xfff;
+    if (!width)
+      return;
+    upload_x = slo >> 2, upload_y = tlo >> 2;
+    height = (thi >> 2) - (tlo >> 2) + 1;
+  }
+  uint32_t effective_width = width;
+  if (size == 1)
+    effective_width = (width + 7) & ~7u;
+  else if (size == 2 && !tlut)
+    effective_width = (width + 3) & ~3u;
+  else if (size == 3)
+    effective_width = (width + 1) & ~1u;
+  // LoadBlock is one row of effective_width; the others step rows by the image's width
+  const uint64_t row_stride = uint64_t(op == RDP::Op::LoadBlock ? effective_width : rdp_texture_image.width) * bytes_per_texel;
+  const uint64_t addr = rdp_texture_image.addr + ((uint64_t(rdp_texture_image.width) * upload_y + upload_x) << (size - 1));
+  uint64_t row_bytes = uint64_t(effective_width) * bytes_per_texel;
+  if (tlut) {
+    row_bytes = uint64_t(effective_width - 1) * bytes_per_texel + 2;
+    if (bytes_per_texel == 1 || (addr & 1))
+      row_bytes += 6;
+  }
+  const uint64_t src = addr & ~uint64_t(63);
+  const uint64_t end = addr + uint64_t(height - 1) * row_stride + row_bytes;
+  mark_rdram_read_wrapped(src, ((end + 63) & ~uint64_t(63)) - src);
+}
+#endif
