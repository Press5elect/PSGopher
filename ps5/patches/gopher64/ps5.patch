+fn identify_ipl(mut data: Vec<u8>) -> Result<(Vec<u8>, IplKind, &'static str), String> {
+    if data.len() < 0x1000 || data.len() > IPL_SIZE {
+        return Err(format!(
+            "not a 64DD IPL ROM ({} bytes; the IPL is {IPL_SIZE})",
+            data.len()
+        ));
+    }
+    data.resize(data.len().div_ceil(4) * 4, 0);
+    let id = |d: &[u8]| IplKind::from_id(&d[0x3B..0x3F]);
+    let kind = id(&data);
+    if kind != IplKind::Unknown {
+        return Ok((data, kind, "big-endian"));
+    }
+    let mut v64 = data.clone();
+    for pair in v64.chunks_exact_mut(2) {
+        pair.swap(0, 1);
+    }
+    let kind = id(&v64);
+    if kind != IplKind::Unknown {
+        return Ok((v64, kind, "byte-swapped, converted"));
+    }
+    let mut n64 = data.clone();
+    for word in n64.chunks_exact_mut(4) {
+        word.reverse();
+    }
+    let kind = id(&n64);
+    if kind != IplKind::Unknown {
+        return Ok((n64, kind, "little-endian, converted"));
+    }
+    Ok((data, IplKind::Unknown, "big-endian"))
+}
+
+/// An IPL in the search folder (every file of 4 MB there), the disk's region first
+fn find_ipl(dir: &std::path::Path, region: Option<disk::Region>) -> Option<std::path::PathBuf> {
+    let mut found: Vec<(std::path::PathBuf, IplKind)> = Vec::new();
+    let mut entries: Vec<_> = std::fs::read_dir(dir)
+        .ok()?
+        .flatten()
+        .map(|e| e.path())
+        .collect();
+    entries.sort();
+    for path in entries {
+        if std::fs::metadata(&path).map(|m| m.len()).ok() != Some(IPL_SIZE as u64) {
+            continue;
+        }
+        // (only a file whose header has a known IPL ID: NDDJ, NDDE, NDXJ)
+        if let Ok(data) = std::fs::read(&path)
+            && let Ok((_, kind, _)) = identify_ipl(data)
+            && kind != IplKind::Unknown
+        {
+            found.push((path, kind));
+        }
+    }
+    found
+        .iter()
+        .find(|(_, kind)| kind.disk_region() == region && region.is_some())
+        .or(found.first())
+        .map(|(path, _)| path.clone())
+}
+
+/// The 64DD for this run (put in Device::dd): the IPL (given, or the first 4 MB IPL in `ipl_dir`
+/// that fits the disk's region), the disk image (optional), and the disk's writes file in
+/// `saves_dir`. Not attached when neither an IPL nor a disk is given.
+pub fn attach(
+    ipl_path: Option<&std::path::Path>,
+    disk_path: Option<&std::path::Path>,
+    ipl_dir: &std::path::Path,
+    saves_dir: &std::path::Path,
+    cart_present: bool,
+) -> std::io::Result<Dd> {
+    let error = |text: String| std::io::Error::other(format!("64dd: {text}"));
+    if ipl_path.is_none() && disk_path.is_none() {
+        return Ok(Dd::default());
+    }
+    let disk = if let Some(path) = disk_path {
+        let image = std::fs::read(path)
+            .map_err(|e| error(format!("could not read the disk {}: {e}", path.display())))?;
+        Some(disk::Disk::parse(image).map_err(|e| error(format!("{}: {e}", path.display())))?)
+    } else {
+        None
+    };
+    let ipl_path = match ipl_path {
+        Some(path) => path.to_path_buf(),
+        None => find_ipl(ipl_dir, disk.as_ref().map(|d| d.region)).ok_or_else(|| {
+            error(format!(
+                "a disk needs the 64DD IPL ROM (the drive's BIOS, not included): --dd-ipl <file>, or a 4 MB IPL file (ID NDDJ, NDDE or NDXJ) in {}",
+                ipl_dir.display()
+            ))
+        })?,
+    };
+    let data = std::fs::read(&ipl_path).map_err(|e| {
+        error(format!(
+            "could not read the IPL {}: {e}",
+            ipl_path.display()
+        ))
+    })?;
+    let size = data.len();
+    let (ipl, ipl_kind, order) =
+        identify_ipl(data).map_err(|e| error(format!("{}: {e}", ipl_path.display())))?;
+
+    let mut text = format!(
+        "64dd: IPL {} ({size} bytes, {order}, {}, {})",
+        ipl_path.display(),
+        ipl_kind.region(),
+        ipl_kind.cic()
+    );
+    if ipl_kind == IplKind::Unknown {
+        log("64dd: the IPL's header has no known ID (NDDJ, NDDE, NDXJ): taken as CIC-NUS-8303");
+    }
+    let mut writes_path = None;
+    let mut state = DdState::default();
+    if let Some(disk) = &disk {
+        let path = saves_dir.join(format!("64DD-{}-{}.ddw", disk.id, disk.hash));
+        text += &format!(
+            ", disk {} ({}, {}, {}, type {}), writes kept in {}",
+            disk_path.unwrap().display(),
+            disk.format.name(),
+            disk.id,
+            disk.region.name(),
+            disk.disk_type,
+            path.display()
+        );
+        match std::fs::read(&path) {
+            Ok(data) => match disk::decode_writes(&data, &disk.hash) {
+                Ok(overlay) => {
+                    text += &format!(" ({} blocks written before)", overlay.len());
+                    state.overlay = overlay;
+                }
+                Err(e) => {
+                    let aside = path.with_extension("ddw.bad");
+                    let moved = std::fs::rename(&path, &aside).is_ok();
+                    log(&format!(
+                        "64dd: {}: {e}; {}",
+                        path.display(),
+                        if moved {
+                            format!(
+                                "kept aside as {}, the disk starts as dumped",
+                                aside.display()
+                            )
+                        } else {
+                            "the disk starts as dumped".to_string()
+                        }
+                    ));
+                }
+            },
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+            Err(e) => return Err(error(format!("could not read {}: {e}", path.display()))),
+        }
+        if let Some(region) = ipl_kind.disk_region()
+            && region != disk.region
+        {
+            log(&format!(
+                "64dd: the disk is {} and the IPL {}: the IPL is likely to refuse it",
+                disk.region.name(),
+                ipl_kind.region()
+            ));
+        }
+        state.disk_hash = disk.hash.clone();
+        writes_path = Some(path);
+    } else {
+        text += ", no disk";
+    }
+    text += if cart_present {
+        ", with a cartridge (it boots)"
+    } else {
+        ", no cartridge (the IPL boots)"
+    };
+    log(&text);
+
+    Ok(Dd {
+        attached: true,
+        cart_absent: !cart_present,
+        ipl,
+        ipl_kind,
+        disk,
+        writes_path,
+        dirty: false,
+        state,
+    })
+}
+
+fn hash_prefix(hash: &str) -> [u8; 8] {
+    std::array::from_fn(|i| {
+        hash.get(i * 2..i * 2 + 2)
+            .and_then(|hex| u8::from_str_radix(hex, 16).ok())
+            .unwrap_or(0)
+    })
+}
+
+/// The header Gopher64 names a run by when there is no cartridge (the game ID, the save and
+/// state names, the cheats' key): the disk's ID and hash, or the IPL's. Only its identity is used:
+/// with no cartridge the cartridge space is open bus (start clears the ROM before the CPU runs).
+pub fn placeholder_rom(dd: &Dd) -> Vec<u8> {
+    let mut rom = vec![0u8; 0x1000];
+    rom[0..4].copy_from_slice(&0x80371240u32.to_be_bytes());
+    let (id, hash, region) = match &dd.disk {
+        Some(disk) => (disk.id.clone(), disk.hash.clone(), disk.region),
+        None => (
+            String::from_utf8_lossy(&dd.ipl[0x3B..0x3F]).into_owned(),
+            device::cart::rom::calculate_hash(&dd.ipl),
+            dd.ipl_kind.disk_region().unwrap_or(disk::Region::Japan),
+        ),
+    };
+    rom[0x10..0x18].copy_from_slice(&hash_prefix(&hash));
+    let name = format!("64DD {id}");
+    for (i, c) in name
+        .bytes()
+        .chain(std::iter::repeat(b' '))
+        .take(0x14)
+        .enumerate()
+    {
+        rom[0x20 + i] = if c.is_ascii_alphanumeric() || c == b' ' {
+            c
+        } else {
+            b'_'
+        };
+    }
+    for (i, c) in id.bytes().take(3).enumerate() {
+        rom[0x3B + i] = if c.is_ascii_alphanumeric() { c } else { b'_' };
+    }
+    rom[0x3E] = if region == disk::Region::Usa {
+        b'E'
+    } else {
+        b'J'
+    };
+    rom
+}
+
+/// run_game, after the cartridge: 8 MB of RDRAM (64DD software needs the Expansion Pak, sold with
+/// the drive), and with no cartridge the IPL's CIC seed and an NTSC console.
+pub fn init(device: &mut device::Device) {
+    if !device.dd.attached {
+        return;
+    }
+    if device.rdram.size != 0x800000 {
+        log("64dd: the Expansion Pak is on (64DD software needs 8 MB)");
+        device.rdram.size = 0x800000;
+    }
+    if device.dd.cart_absent {
+        device.cart.cic_seed = device.dd.ipl_kind.seed();
+        device.cart.pal = false;
+    }
+}
+
+/// run_game, just before the CPU starts: the drive's power-on, the clock from the run's start time
+/// (the cartridge RTC's), and with no cartridge no cartridge: its ROM and save types are dropped
+/// (the placeholder only named the run).
+pub fn start(device: &mut device::Device) {
+    if !device.dd.attached {
+        return;
+    }
+    if device.dd.cart_absent {
+        // (the placeholder header stays in cart.rom for what reads it, e.g. the VRU's region
+        // check; the CPU and PI see open bus there: map, pi_handlers)
+        device.ui.storage.save_type.clear();
+    }
+    let utc = time::OffsetDateTime::from_unix_timestamp(device.cart.rtc_timestamp)
+        .unwrap_or(time::OffsetDateTime::UNIX_EPOCH);
+    let now = utc.to_offset(time::UtcOffset::local_offset_at(utc).unwrap_or(time::UtcOffset::UTC));
+    let bcd = |n: u32| (((n % 100) / 10) << 4 | (n % 10)) as u8;
+    device.dd.state.rtc = [
+        bcd(now.year().rem_euclid(100) as u32),
+        bcd(now.month() as u32),
+        bcd(now.day() as u32),
+        bcd(now.hour() as u32),
+        bcd(now.minute() as u32),
+        bcd(now.second() as u32),
+    ];
+    power(device);
+}
+
+/// The console's reset (exceptions.rs reset_event, the NMI): the drive's power-on, as ares'
+/// System::power(reset) calls DD::power (the clock and the disk's writes are kept)
+pub fn reset(device: &mut device::Device) {
+    if device.dd.attached {
+        power(device);
+    }
+}
+
+/// The end of run_game: the writes file, if the disk was written
+pub fn save(device: &mut device::Device) {
+    flush_writes(device);
+}
+
+fn flush_writes(device: &mut device::Device) {
+    let dd = &mut device.dd;
+    if !dd.dirty {
+        return;
+    }
+    let (Some(disk), Some(path)) = (&dd.disk, &dd.writes_path) else {
+        return;
+    };
+    let data = disk::encode_writes(&disk.hash, &dd.state.overlay);
+    let temp = path.with_extension("ddw.new");
+    let result = std::fs::write(&temp, &data).and_then(|_| std::fs::rename(&temp, path));
+    match result {
+        Ok(()) => dd.dirty = false,
+        Err(e) => log(&format!("64dd: could not write {}: {e}", path.display())),
+    }
+}
+
+/// Take the disk out (ares: DD::disconnect). For a front end's eject; not called yet.
+#[allow(dead_code)]
+pub fn eject(device: &mut device::Device) {
+    if !device.dd.attached {
+        return;
+    }
+    flush_writes(device);
+    device.dd.disk = None;
+    device.dd.writes_path = None;
+    let regs = &mut device.dd.state.regs;
+    regs.status.disk_present = false;
+    if regs.status.busy_state {
+        regs.status.mecha_error = true;
+    }
+    if regs.bm.start {
+        regs.bm.start = false;
+        regs.bm.error = true;
+    }
+    motor_stop(device);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Interrupts (ares: DD::raise, lower, poll)
+
+#[derive(Clone, Copy)]
+enum Irq {
+    Mecha,
+    Bm,
+}
+
+fn raise(device: &mut device::Device, irq: Irq) {
+    match irq {
+        Irq::Mecha => device.dd.state.regs.mecha_line = true,
+        Irq::Bm => device.dd.state.regs.bm_line = true,
+    }
+    poll(device);
+}
+
+fn lower(device: &mut device::Device, irq: Irq) {
+    match irq {
+        Irq::Mecha => device.dd.state.regs.mecha_line = false,
+        Irq::Bm => device.dd.state.regs.bm_line = false,
+    }
+    poll(device);
+}
+
+fn poll(device: &mut device::Device) {
+    let regs = &device.dd.state.regs;
+    let line = (regs.mecha_line && regs.mecha_mask) || (regs.bm_line && regs.bm_mask);
+    if line {
+        device.cpu.cop0.regs[device::cop0::COP0_CAUSE_REG] |= COP0_CAUSE_IP3;
+        device::exceptions::check_pending_interrupts(device);
+    } else {
+        device.cpu.cop0.regs[device::cop0::COP0_CAUSE_REG] &= !COP0_CAUSE_IP3;
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Power (ares: DD::power)
+
+fn power(device: &mut device::Device) {
+    let present = has_disk(device);
+    let dev = device.dd.ipl_kind == IplKind::Development;
+    let regs = &mut device.dd.state.regs;
+    *regs = Regs {
+        mecha_mask: true,
+        bm_mask: true,
+        ctl: Ctl {
+            standby_delay: 3 * 0x17,
+            sleep_delay: 0x17,
+            led_on_time: 4,
+            led_off_time: 4,
+            ..Default::default()
+        },
+        c2s: vec![0; C2S_SIZE],
+        ds: vec![0; DS_SIZE],
+        ms: vec![0; MS_SIZE],
+        ..Default::default()
+    };
+    regs.status.reset_state = true;
+    regs.status.disk_changed = true;
+    regs.status.disk_present = present;
+    regs.id = if dev { 4 } else { 3 };
+    motor_stop(device);
+    let second = device.cpu.clock_rate;
+    device::events::create_event(device, device::events::EVENT_TYPE_DD_CLOCK, second);
+    device::events::remove_event(device, device::events::EVENT_TYPE_DD_MECHA);
+    device::events::remove_event(device, device::events::EVENT_TYPE_DD_BM);
+    lower(device, Irq::Mecha);
+    lower(device, Irq::Bm);
+}
+
+// ---------------------------------------------------------------------------------------------
+// The controller (ares: controller.cpp)
+
+mod command {
+    pub const NOP: u16 = 0x0;
+    pub const READ_SEEK: u16 = 0x1;
+    pub const WRITE_SEEK: u16 = 0x2;
+    pub const RECALIBRATION: u16 = 0x3;
+    pub const SLEEP: u16 = 0x4;
+    pub const START: u16 = 0x5;
+    pub const SET_STANDBY: u16 = 0x6;
+    pub const SET_SLEEP: u16 = 0x7;
+    pub const CLEAR_CHANGE_FLAG: u16 = 0x8;
+    pub const CLEAR_RESET_FLAG: u16 = 0x9;
+    pub const READ_VERSION: u16 = 0xa;
+    pub const SET_DISK_TYPE: u16 = 0xb;
+    pub const REQUEST_STATUS: u16 = 0xc;
+    pub const STANDBY: u16 = 0xd;
+    pub const INDEX_LOCK_RETRY: u16 = 0xe;
+    pub const SET_RTC_YEAR_MONTH: u16 = 0xf;
+    pub const SET_RTC_DAY_HOUR: u16 = 0x10;
+    pub const SET_RTC_MINUTE_SECOND: u16 = 0x11;
+    pub const GET_RTC_YEAR_MONTH: u16 = 0x12;
+    pub const GET_RTC_DAY_HOUR: u16 = 0x13;
+    pub const GET_RTC_MINUTE_SECOND: u16 = 0x14;
+    pub const SET_LED_BLINK_RATE: u16 = 0x15;
+    pub const READ_PROGRAM_VERSION: u16 = 0x1b;
+}
+
+/// A seek (read, write, recalibration/start): its time, and the head moved there
+fn seek(device: &mut device::Device, target: u16, for_write: bool) -> u64 {
+    let regs = &mut device.dd.state.regs;
+    // (ares: "TODO: proper research into seek and access times")
+    let mut count: u64 = 993_000;
+    if regs.status.head_retracted || regs.status.spindle_motor_stopped {
+        count += 200_700_000;
+    }
+    count += 19300 * (target as i64 & 0xFFF).abs_diff(regs.current_track as i64 & 0xFFF);
+    regs.current_track = target | 0x6000;
+    let rom = seek_track(device);
+    if for_write {
+        device.dd.state.regs.status.write_protect = rom;
+    }
+    device::events::remove_event(device, device::events::EVENT_TYPE_DD_MOTOR);
+    let regs = &mut device.dd.state.regs;
+    regs.status.head_retracted = false;
+    regs.status.spindle_motor_stopped = false;
+    regs.seek = true;
+    count
+}
+
+fn run_command(device: &mut device::Device, command: u16) {
+    {
+        let regs = &mut device.dd.state.regs;
+        let ctl = &mut regs.ctl;
+        ctl.err_self_diagnostic = false;
+        ctl.err_servo_ng = false;
+        ctl.err_index_gap_ng = false;
+        ctl.err_timeout = false;
+        ctl.err_undefined_command = false;
+        ctl.err_invalid_param = false;
+        regs.status.mecha_error = false;
+        regs.status.write_protect = false;
+        if regs.status.busy_state {
+            return;
+        }
+        regs.status.busy_state = true;
+    }
+
+    // the simplest command's time, ReadProgramVersion's
+    let mut count: u64 = 8000;
+    let disk = has_disk(device);
+    let data = device.dd.state.regs.data;
+    match command {
+        command::NOP => {}
+        command::READ_SEEK | command::WRITE_SEEK => {
+            if disk {
+                if (data >> 12) > 1 || (data & 0xFFF) > 0x5D7 {
+                    device.dd.state.regs.ctl.err_invalid_param = true;
+                } else {
+                    count = seek(device, data, command == command::WRITE_SEEK);
+                }
+            } else {
+                device.dd.state.regs.ctl.err_self_diagnostic = true;
+            }
+        }
+        command::RECALIBRATION | command::START => {
+            if disk {
+                // to head 0, track 0
+                count = seek(device, 0, false);
+            } else {
+                device.dd.state.regs.ctl.err_self_diagnostic = true;
+            }
+        }
+        command::SLEEP => {
+            let status = &device.dd.state.regs.status;
+            if !status.head_retracted || !status.spindle_motor_stopped {
+                count = 83_000_000;
+            }
+            motor_stop(device);
+        }
+        command::SET_STANDBY => {
+            // ares tests bit 24 and takes bits 16-23 of its 16-bit data latch, which always read
+            // as 0 there, so the command disables the automatic standby. (Mupen64Plus reads the
+            // 32-bit register the other way round: bit 24 set disables.) ares' effect is kept.
+            device.dd.state.regs.ctl.standby_delay_disable = true;
+        }
+        command::SET_SLEEP => {
+            // as SET_STANDBY
+            device.dd.state.regs.ctl.sleep_delay_disable = true;
+        }
+        command::CLEAR_CHANGE_FLAG => device.dd.state.regs.status.disk_changed = false,
+        command::CLEAR_RESET_FLAG => {
+            // "that's how it works" (ares)
+            device.dd.state.regs.status.disk_changed = false;
+            device.dd.state.regs.status.reset_state = false;
+        }
+        command::READ_VERSION => {
+            device.dd.state.regs.data = if data & 1 == 0 { 0x0114 } else { 0x5300 };
+        }
+        command::SET_DISK_TYPE => device.dd.state.regs.ctl.disk_type = (data & 0xF) as u8,
+        command::REQUEST_STATUS => {
+            let regs = &mut device.dd.state.regs;
+            let ctl = &regs.ctl;
+            let flags = [
+                ctl.err_self_diagnostic,
+                ctl.err_servo_ng,
+                ctl.err_index_gap_ng,
+                ctl.err_timeout,
+                ctl.err_undefined_command,
+                ctl.err_invalid_param,
+                ctl.err_unknown,
+            ];
+            for (bit, flag) in flags.iter().enumerate() {
+                regs.data = (regs.data & !(1 << bit)) | (u16::from(*flag) << bit);
+            }
+        }
+        command::STANDBY => {
+            if !disk {
+                device.dd.state.regs.ctl.err_self_diagnostic = true;
+            } else {
+                let status = &device.dd.state.regs.status;
+                if !status.head_retracted || !status.spindle_motor_stopped {
+                    count = 64_000_000;
+                }
+                motor_standby(device);
+            }
+        }
+        command::INDEX_LOCK_RETRY => {
+            if !disk {
+                device.dd.state.regs.ctl.err_self_diagnostic = true;
+            }
+        }
+        command::SET_RTC_YEAR_MONTH
+        | command::SET_RTC_DAY_HOUR
+        | command::SET_RTC_MINUTE_SECOND => {
+            let at = ((command - command::SET_RTC_YEAR_MONTH) * 2) as usize;
+            device.dd.state.rtc[at..at + 2].copy_from_slice(&data.to_be_bytes());
+        }
+        command::GET_RTC_YEAR_MONTH
+        | command::GET_RTC_DAY_HOUR
+        | command::GET_RTC_MINUTE_SECOND => {
+            let at = ((command - command::GET_RTC_YEAR_MONTH) * 2) as usize;
+            let rtc = &device.dd.state.rtc;
+            device.dd.state.regs.data = u16::from_be_bytes([rtc[at], rtc[at + 1]]);
+        }
+        command::SET_LED_BLINK_RATE => {
+            // ares reads bits 24-31 and 16-23 of the 16-bit latch (always 0): no change
+        }
+        command::READ_PROGRAM_VERSION => device.dd.state.regs.data = 0x0003,
+        _ => device.dd.state.regs.ctl.err_undefined_command = true,
+    }
+
+    let regs = &mut device.dd.state.regs;
+    let ctl = &regs.ctl;
+    if ctl.err_self_diagnostic
+        || ctl.err_servo_ng
+        || ctl.err_index_gap_ng
+        || ctl.err_timeout
+        || ctl.err_undefined_command
+        || ctl.err_invalid_param
+        || regs.status.write_protect
+    {
+        regs.status.mecha_error = true;
+    }
+    device::events::create_event(
+        device,
+        device::events::EVENT_TYPE_DD_MECHA,
+        ares_clocks(count),
+    );
+}
+
+pub fn mecha_event(device: &mut device::Device) {
+    if device.dd.state.regs.seek {
+        device.dd.state.regs.seek = false;
+        if device.dd.state.regs.status.disk_present {
+            motor_active(device);
+        } else {
+            motor_stop(device);
+        }
+    }
+    device.dd.state.regs.status.busy_state = false;
+    raise(device, Irq::Mecha);
+}
+
+// ---------------------------------------------------------------------------------------------
+// The drive (ares: drive.cpp)
+
+/// Whether the current track is in the disk type's ROM area (write protected)
+fn seek_track(device: &device::Device) -> bool {
+    let regs = &device.dd.state.regs;
+    disk::is_rom_area(
+        regs.ctl.disk_type,
+        u32::from((regs.current_track >> 12) & 1),
+        u32::from(regs.current_track & 0xFFF),
+    )
+}
+
+/// The physical block and the offset in it of a sector of the current track (seekSector)
+fn seek_sector(device: &device::Device, sector: u8) -> Option<(usize, u32)> {
+    let regs = &device.dd.state.regs;
+    let block = u32::from(sector >= 0x5A);
+    let sector = u32::from(sector % 0x5A);
+    let track = u32::from(regs.current_track & 0xFFF);
+    let head = u32::from((regs.current_track >> 12) & 1);
+    if track >= disk::TRACKS {
+        return None; // past the last track: no data
+    }
+    Some((
+        disk::block_index(head, track, block),
+        sector * (u32::from(regs.sector_size_buf) + 1),
+    ))
+}
+
+pub fn bm_event(device: &mut device::Device) {
+    // not started: nothing
+    if !device.dd.state.regs.bm.start {
+        device::events::remove_event(device, device::events::EVENT_TYPE_DD_BM);
+        lower(device, Irq::Bm);
+        return;
+    }
+
+    let regs = &mut device.dd.state.regs;
+    regs.status.request_user_sector = false;
+    regs.status.request_c2_sector = false;
+    regs.micro_error = false;
+    regs.bm.error = false;
+    regs.bm.c1_single = false;
+    regs.bm.c1_double = false;
+    regs.error = ErrorFlags::default();
+
+    let mut block = u8::from(regs.current_sector >= 0x5A);
+    let mut sector = regs.current_sector.wrapping_sub(block * 0x5A);
+    let track = u32::from(regs.current_track & 0xFFF);
+    let head = u32::from((regs.current_track >> 12) & 1);
+    let size = u32::from(regs.sector_size_buf) + 1;
+
+    if regs.bm.read_mode {
+        let error_index = (head * disk::TRACKS * 2 + track * 2) as usize + block as usize;
+        let protected = device
+            .dd
+            .disk
+            .as_ref()
+            .and_then(|d| d.error.get(error_index))
+            .is_some_and(|e| *e != 0);
+        let regs = &mut device.dd.state.regs;
+        if protected {
+            // the copy protection (C1 errors all over; retail disks only)
+            regs.bm.c1_single = true;
+            regs.bm.c1_double = true;
+        }
+        if sector < 0x55 {
+            // a user sector
+            let place = seek_sector(device, device.dd.state.regs.current_sector);
+            let dd = &mut device.dd;
+            if let Some((index, offset)) = place
+                && let Some(disk) = &dd.disk
+            {
+                let out = &mut dd.state.regs.ds[..size as usize];
+                disk.read_into(&dd.state.overlay, index, offset, out);
+            } else {
+                dd.state.regs.ds[..size as usize].fill(0);
+            }
+            let regs = &mut device.dd.state.regs;
+            regs.status.request_user_sector = true;
+            regs.current_sector = regs.current_sector.wrapping_add(1);
+        } else if sector < 0x58 {
+            // a C2 sector
+            regs.current_sector = regs.current_sector.wrapping_add(1);
+        } else if sector == 0x58 {
+            // the last C2 sector
+            regs.status.request_c2_sector = true;
+            if regs.bm.block_transfer {
+                // on to the other block
+                regs.bm.block_transfer = false;
+                block = 1 - block;
+                regs.current_sector = block * 0x5A;
+            } else {
+                regs.bm.start = false;
+            }
+        }
+    } else {
+        // writing: the first interrupt asks for the data and writes nothing; each next one writes
+        // the sector the buffer holds and asks for the next (the drive makes C1 and C2 itself)
+        if sector <= 0x55 {
+            if sector > 0 {
+                let previous = device.dd.state.regs.current_sector.wrapping_sub(1);
+                let place = seek_sector(device, previous);
+                let dd = &mut device.dd;
+                if let Some((index, offset)) = place
+                    && let Some(disk) = &dd.disk
+                {
+                    let data = &dd.state.regs.ds[..size as usize];
+                    disk.write_from(&mut dd.state.overlay, index, offset, data);
+                    dd.dirty = true;
+                    let second = device.cpu.clock_rate;
+                    device::events::create_event(
+                        device,
+                        device::events::EVENT_TYPE_DD_SAVE,
+                        second,
+                    );
+                }
+            }
+            device.dd.state.regs.status.request_user_sector = true;
+        }
+        let regs = &mut device.dd.state.regs;
+        if sector >= 0x55 {
+            if regs.bm.block_transfer {
+                // the next sector is in the other block
+                regs.bm.block_transfer = false;
+                sector = 0;
+                block = 1 - block;
+                regs.current_sector = sector + block * 0x5A;
+            } else {
+                // the last interrupt acknowledges the write: no data asked for, and stop
+                regs.status.request_user_sector = false;
+                regs.bm.start = false;
+            }
+        }
+        regs.current_sector = regs.current_sector.wrapping_add(1);
+    }
+
+    raise(device, Irq::Bm);
+}
+
+fn motor_active(device: &mut device::Device) {
+    device::events::remove_event(device, device::events::EVENT_TYPE_DD_MOTOR);
+    let regs = &mut device.dd.state.regs;
+    regs.status.head_retracted = false;
+    regs.status.spindle_motor_stopped = false;
+    if !regs.ctl.standby_delay_disable {
+        let when = device.cpu.clock_rate / 0x17 * u64::from(regs.ctl.standby_delay);
+        device::events::create_event(device, device::events::EVENT_TYPE_DD_MOTOR, when);
+    }
+}
+
+fn motor_standby(device: &mut device::Device) {
+    device::events::remove_event(device, device::events::EVENT_TYPE_DD_MOTOR);
+    let regs = &mut device.dd.state.regs;
+    regs.status.head_retracted = true;
+    regs.status.spindle_motor_stopped = false;
+    if !regs.ctl.sleep_delay_disable {
+        let when = device.cpu.clock_rate / 0x17 * u64::from(regs.ctl.sleep_delay);
+        device::events::create_event(device, device::events::EVENT_TYPE_DD_MOTOR, when);
+    }
+}
+
+fn motor_stop(device: &mut device::Device) {
+    device::events::remove_event(device, device::events::EVENT_TYPE_DD_MOTOR);
+    let regs = &mut device.dd.state.regs;
+    regs.status.head_retracted = true;
+    regs.status.spindle_motor_stopped = true;
+}
+
+pub fn motor_event(device: &mut device::Device) {
+    let status = &device.dd.state.regs.status;
+    let (retracted, stopped) = (status.head_retracted, status.spindle_motor_stopped);
+    if retracted && !stopped {
+        // to sleep
+        motor_stop(device);
+    }
+    let status = &device.dd.state.regs.status;
+    if !status.head_retracted && !status.spindle_motor_stopped {
+        // to standby
+        motor_standby(device);
+    }
+}
+
+pub fn save_event(device: &mut device::Device) {
+    flush_writes(device);
+}
+
+// ---------------------------------------------------------------------------------------------
+// The clock (ares: rtc.cpp)
+
+fn bcd_decode(n: u8) -> u32 {
+    u32::from(n >> 4) * 10 + u32::from(n & 0xF)
+}
+
+fn days_in_month(month: u32, year: u32) -> u32 {
+    match month {
+        2 if year.is_multiple_of(4) => 29,
+        2 => 28,
+        4 | 6 | 9 | 11 => 30,
+        _ => 31,
+    }
+}
+
+fn bcd_days_in_month(rtc: &[u8; 6]) -> u8 {
+    let days = days_in_month(bcd_decode(rtc[1]), bcd_decode(rtc[0]));
+    ((days / 10) << 4 | (days % 10)) as u8
+}
+
+fn rtc_valid(rtc: &[u8; 6]) -> bool {
+    if rtc.iter().any(|b| b & 0x0F >= 0x0A) {
+        return false;
+    }
+    !(rtc[0] >= 0xA0
+        || rtc[5] >= 0x60
+        || rtc[4] >= 0x60
+        || rtc[3] >= 0x24
+        || rtc[1] > 0x12
+        || rtc[1] < 1
+        || rtc[2] < 1
+        || rtc[2] > bcd_days_in_month(rtc))
+}
+
+fn rtc_tick(rtc: &mut [u8; 6], offset: usize) {
+    let mut n = rtc[offset].wrapping_add(1);
+    if n & 0xF > 9 {
+        n = (n & 0xF0).wrapping_add(0x10);
+    }
+    if n & 0xF0 > 0x90 {
+        n = 0;
+    }
+    rtc[offset] = n;
+}
+
+fn rtc_tick_second(rtc: &mut [u8; 6]) {
+    if !rtc_valid(rtc) {
+        return;
+    }
+    rtc_tick(rtc, 5);
+    if rtc[5] < 0x60 {
+        return;
+    }
+    rtc[5] = 0;
+    rtc_tick(rtc, 4);
+    if rtc[4] < 0x60 {
+        return;
+    }
+    rtc[4] = 0;
+    rtc_tick(rtc, 3);
+    if rtc[3] < 0x24 {
+        return;
+    }
+    rtc[3] = 0;
+    rtc_tick(rtc, 2);
+    if rtc[2] <= bcd_days_in_month(rtc) {
+        return;
+    }
+    rtc[2] = 1;
+    rtc_tick(rtc, 1);
+    if rtc[1] <= 0x12 {
+        return;
+    }
+    rtc[1] = 1;
+    rtc_tick(rtc, 0);
+}
+
+pub fn clock_event(device: &mut device::Device) {
+    rtc_tick_second(&mut device.dd.state.rtc);
+    let second = device.cpu.clock_rate;
+    device::events::create_event(device, device::events::EVENT_TYPE_DD_CLOCK, second);
+}
+
+// ---------------------------------------------------------------------------------------------
+// The ASIC's registers (ares: io.cpp; each 32-bit register is two halves, the high one first)
+
+fn read_asic_half(device: &mut device::Device, address: u32) -> u16 {
+    let regs = &device.dd.state.regs;
+    let b = |flag: bool, bit: u32| u16::from(flag) << bit;
+    match (address & 0x7F) >> 1 {
+        0 => regs.data,
+        4 => {
+            // ASIC_STATUS
+            let s = &regs.status;
+            let data = b(s.disk_changed, 0)
+                | b(s.mecha_error, 1)
+                | b(s.write_protect, 2)
+                | b(s.head_retracted, 3)
+                | b(s.spindle_motor_stopped, 4)
+                | b(s.reset_state, 6)
+                | b(s.busy_state, 7)
+                | b(s.disk_present, 8)
+                | b(regs.mecha_line, 9)
+                | b(regs.bm_line, 10)
+                | b(regs.bm.error, 11)
+                | b(s.request_c2_sector, 12)
+                | b(s.request_user_sector, 14);
+            // reading the status acknowledges the BM interrupt (tested on hardware, ares)
+            if regs.bm_line {
+                let track = u64::from(regs.current_track & 0xFFF);
+                device::events::create_event(
+                    device,
+                    device::events::EVENT_TYPE_DD_BM,
+                    ares_clocks(38_000 + track / 15),
+                );
+                lower(device, Irq::Bm);
+            }
+            data
+        }
+        6 => regs.current_track,
+        8 => {
+            // ASIC_BM_STATUS
+            let bm = &regs.bm;
+            b(bm.c1_error, 0)
+                | b(bm.c1_single, 5)
+                | b(bm.c1_double, 6)
+                | b(bm.c1_correct, 7)
+                | b(bm.block_transfer, 8)
+                | b(regs.micro_error, 9)
+                | b(bm.error, 10)
+                | b(bm.start, 15)
+        }
+        10 => {
+            // ASIC_ERR_SECTOR
+            let e = &regs.error;
+            u16::from(e.sector)
+                | b(e.self_stop, 8)
+                | b(e.clock_unlock, 9)
+                | b(!regs.status.disk_present, 10)
+                | b(e.off_track, 11)
+                | b(e.overrun, 12)
+                | b(e.spindle, 13)
+                | b(regs.micro_error, 14)
+                | b(e.am, 15)
+        }
+        14 => (u16::from(regs.current_sector) << 8) | 0xC3, // ASIC_CUR_SECTOR
+        20 => u16::from(regs.sector_size_buf),              // ASIC_HOST_SECBYTE
+        24 => u16::from(regs.sector_size) | (u16::from(regs.sector_block) << 8), // ASIC_SEC_BYTE
+        32 => regs.id,                                      // ASIC_ID_REG
+        _ => 0,
+    }
+}
+
+fn write_asic_half(device: &mut device::Device, address: u32, data: u16) {
+    let bit = |n: u32| data & (1 << n) != 0;
+    match (address & 0x7F) >> 1 {
+        0 => device.dd.state.regs.data = data,
+        4 => run_command(device, data),
+        8 => {
+            // ASIC_BM_CTL
+            let regs = &mut device.dd.state.regs;
+            regs.bm.reset |= bit(12);
+            regs.bm.read_mode = bit(14);
+            regs.bm.disable_or_check = bit(11);
+            regs.bm.disable_c1_correction = bit(10);
+            regs.bm.block_transfer = bit(9);
+            if bit(8) {
+                lower(device, Irq::Mecha);
+            }
+            let regs = &mut device.dd.state.regs;
+            regs.current_sector = data as u8;
+            if !bit(12) && regs.bm.reset {
+                regs.bm.start = false;
+                regs.bm.error = false;
+                regs.status.request_user_sector = false;
+                regs.status.request_c2_sector = false;
+                regs.bm.reset = false;
+                lower(device, Irq::Bm);
+            }
+            if bit(15) && has_disk(device) {
+                device.dd.state.regs.bm.start = true;
+                let track = u64::from(device.dd.state.regs.current_track & 0xFFF);
+                device::events::create_event(
+                    device,
+                    device::events::EVENT_TYPE_DD_BM,
+                    ares_clocks(50_000 + track / 15),
+                );
+            }
+        }
+        12 => device.dd.state.regs.micro_enable = bit(14), // ASIC_SEQ_CTL
+        16 => {
+            // ASIC_HARD_RESET
+            if data == 0xAAAA {
+                power(device);
+            }
+        }
+        20 => device.dd.state.regs.sector_size_buf = data as u8, // ASIC_HOST_SECBYTE
+        22 => {
+            // ASIC_C1_S2 (ares: the sector size and block size)
+            device.dd.state.regs.sector_size = data as u8;
+            device.dd.state.regs.sector_block = (data >> 8) as u8;
+        }
+        _ => {}
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// The bus: CPU reads and writes, PI DMA
+
+fn buffer_half(buffer: &[u8], offset: usize) -> u16 {
+    u16::from_be_bytes([
+        *buffer.get(offset).unwrap_or(&0),
+        *buffer.get(offset + 1).unwrap_or(&0),
+    ])
+}
+
+fn set_buffer_half(buffer: &mut [u8], offset: usize, value: u16) {
+    if offset + 1 < buffer.len() {
+        buffer[offset..offset + 2].copy_from_slice(&value.to_be_bytes());
+    }
+}
+
+/// A halfword of the 64DD's registers for a CPU read (0 where no device answers: read_regs
+/// answers those addresses with open bus before)
+fn read_half(device: &mut device::Device, address: u32) -> u16 {
+    let (view, offset) = view_at(address);
+    view_read(device, view, offset).unwrap_or(0)
+}
+
+fn in_dd_registers(address: u64) -> bool {
+    (address as u32 & 0xFFFF) < 0x05C0
+}
+
+pub fn read_regs(
+    device: &mut device::Device,
+    address: u64,
+    access_size: device::memory::AccessSize,
+) -> u32 {
+    let cycles = device::pi::calculate_cycles(device, 2, 4);
+    device::cop0::add_cycles(device, cycles);
+    if !in_dd_registers(address) {
+        return device::unmapped::read_mem_fast(device, address, access_size);
+    }
+    let address = address as u32 & !3;
+    let high = read_half(device, address);
+    let low = read_half(device, address + 2);
+    (u32::from(high) << 16) | u32::from(low)
+}
+
+pub fn write_regs(device: &mut device::Device, address: u64, value: u32, mask: u32) {
+    // (a PI write: the CPU waits for it, no PI interrupt follows, as ares' PI_BUS_Write)
+    let cycles = device::pi::calculate_cycles(device, 2, 4);
+    device::cop0::add_cycles(device, cycles);
+    if !in_dd_registers(address) {
+        return;
+    }
+    let address = address as u32 & !3;
+    let regs = &mut device.dd.state.regs;
+    if address < 0x0500_0500 || address >= 0x0500_0580 {
+        // the buffers: a masked write of the word
+        let buffer = match address {
+            0x0500_0000..=0x0500_03FF => &mut regs.c2s,
+            0x0500_0400..=0x0500_04FF => &mut regs.ds,
+            _ => &mut regs.ms,
+        };
+        let offset = (address as usize) & (buffer.len() - 1);
+        if offset + 4 <= buffer.len() {
+            let mut word = u32::from_be_bytes(buffer[offset..offset + 4].try_into().unwrap());
+            device::memory::masked_write_32(&mut word, value, mask);
+            buffer[offset..offset + 4].copy_from_slice(&word.to_be_bytes());
+        }
+        return;
+    }
+    if mask & 0xFFFF_0000 != 0 {
+        write_asic_half(device, address, (value >> 16) as u16);
+    }
+    if mask & 0x0000_FFFF != 0 {
+        write_asic_half(device, address + 2, value as u16);
+    }
+}
+
+fn ipl_word(device: &device::Device, address: u64) -> u32 {
+    let offset = (address as usize) & (IPL_SIZE - 1) & !3;
+    match device.dd.ipl.get(offset..offset + 4) {
+        Some(word) => u32::from_be_bytes(word.try_into().unwrap()),
+        None => 0,
+    }
+}
+
+pub fn read_ipl_fast(
+    device: &device::Device,
+    address: u64,
+    _access_size: device::memory::AccessSize,
+) -> u32 {
+    ipl_word(device, address)
+}
+
+pub fn read_ipl(
+    device: &mut device::Device,
+    address: u64,
+    _access_size: device::memory::AccessSize,
+) -> u32 {
+    let cycles = device::pi::calculate_cycles(device, 1, 4);
+    device::cop0::add_cycles(device, cycles);
+    ipl_word(device, address)
+}
+
+pub fn write_ipl(device: &mut device::Device, _address: u64, _value: u32, _mask: u32) {
+    let cycles = device::pi::calculate_cycles(device, 1, 4);
+    device::cop0::add_cycles(device, cycles);
+}
+
+fn domain(address: u32) -> i32 {
+    if address >> 24 == 0x05 { 2 } else { 1 }
+}
+
+/// What a PI DMA reaches, fixed at its start address (ares: DD::piAddress): a buffer or the IPL
+/// (to its end, then nothing: the bus keeps its last value), the ASIC's registers (the offset
+/// wraps in them, as ares' readAsicHalf/writeAsicHalf mask it), or no device
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum View {
+    C2s,
+    Ds,
+    Asic,
+    Ms,
+    Ipl,
+    None,
+}
+
+fn view_at(address: u32) -> (View, usize) {
+    let address = address & !1;
+    match address {
+        0x0500_0000..=0x0500_03FF => (View::C2s, (address & 0x3FF) as usize),
+        0x0500_0400..=0x0500_04FF => (View::Ds, (address & 0xFF) as usize),
+        0x0500_0500..=0x0500_057F => (View::Asic, (address & 0x7F) as usize),
+        0x0500_0580..=0x0500_05BF => (View::Ms, (address & 0x3F) as usize),
+        0x0600_0000..=0x063F_FFFF => (View::Ipl, (address - 0x0600_0000) as usize),
+        _ => (View::None, 0),
+    }
+}
+
+fn view_buffer(dd: &mut Dd, view: View) -> Option<&mut Vec<u8>> {
+    match view {
+        View::C2s => Some(&mut dd.state.regs.c2s),
+        View::Ds => Some(&mut dd.state.regs.ds),
+        View::Ms => Some(&mut dd.state.regs.ms),
+        View::Ipl => Some(&mut dd.ipl),
+        View::Asic | View::None => None,
+    }
+}
+
+/// The next halfword of a DMA's view at `offset`; None past its end (or no device)
+fn view_read(device: &mut device::Device, view: View, offset: usize) -> Option<u16> {
+    if view == View::Asic {
+        return Some(read_asic_half(device, 0x0500_0500 | (offset & 0x7F) as u32));
+    }
+    let buffer = view_buffer(&mut device.dd, view)?;
+    (offset + 1 < buffer.len()).then(|| buffer_half(buffer, offset))
+}
+
+fn view_write(device: &mut device::Device, view: View, offset: usize, value: u16) {
+    match view {
+        View::Asic => write_asic_half(device, 0x0500_0500 | (offset & 0x7F) as u32, value),
+        View::Ipl | View::None => {} // a ROM; no device
+        _ => {
+            if let Some(buffer) = view_buffer(&mut device.dd, view) {
+                set_buffer_half(buffer, offset, value);
+            }
+        }
+    }
+}
+
+/// PI DMA from RDRAM to the 64DD (PI_RD_LEN)
+pub fn dma_read(device: &mut device::Device, cart_addr: u32, dram_addr: u32, length: u32) -> u64 {
+    let dram_addr = dram_addr & device::rdram::RDRAM_MASK as u32;
+    let byte = |device: &device::Device, i: u32| {
+        *device
+            .rdram
+            .mem
+            .get((dram_addr + i) as usize ^ device.byte_swap)
+            .unwrap_or(&0)
+    };
+    let (view, start) = view_at(cart_addr);
+    for i in (0..length).step_by(2) {
+        let value = u16::from_be_bytes([byte(device, i), byte(device, i + 1)]);
+        view_write(device, view, start + i as usize, value);
+    }
+    device::pi::calculate_cycles(device, domain(cart_addr), length)
+}
+
+/// PI DMA from the 64DD to RDRAM (PI_WR_LEN)
+pub fn dma_write(device: &mut device::Device, cart_addr: u32, dram_addr: u32, length: u32) -> u64 {
+    let dram_addr = dram_addr & device::rdram::RDRAM_MASK as u32;
+    let (view, start) = view_at(cart_addr);
+    // the bus latch: the address at the start (ares: PI::busAddress), then the last data read
+    let mut latch = cart_addr as u16 & !1;
+    for i in (0..length).step_by(2) {
+        if let Some(value) = view_read(device, view, start + i as usize) {
+            latch = value;
+        }
+        let [high, low] = latch.to_be_bytes();
+        for (j, value) in [(i, high), (i + 1, low)] {
+            if j < length
+                && let Some(target) = device
+                    .rdram
+                    .mem
+                    .get_mut((dram_addr + j) as usize ^ device.byte_swap)
+            {
+                *target = value;
+            }
+        }
+    }
+    device::pi::calculate_cycles(device, domain(cart_addr), length)
+}
+
+pub type PiDma = fn(&mut device::Device, u32, u32, u32) -> u64;
+
+/// pi.rs get_handler: the 64DD's DMA ranges, and with no cartridge the cartridge's (open bus, as
+/// an unknown address). None: Gopher64's own handler.
+pub fn pi_handlers(device: &device::Device, address: u32) -> Option<(PiDma, PiDma)> {
+    if !device.dd.attached {
+        return None;
+    }
+    match address {
+        0x0500_0000..=0x0500_05FF | 0x0600_0000..=0x063F_FFFF => Some((dma_read, dma_write)),
+        _ if device.dd.cart_absent
+            && ((device::memory::MM_DOM2_ADDR2 as u32..device::memory::MM_PIF_MEM as u32)
+                .contains(&address)
+                || address >= device::memory::MM_SC64_BUFFER as u32) =>
+        {
+            Some((device::pi::unknown_dma_read, device::pi::unknown_dma_write))
+        }
+        _ => None,
+    }
+}
+
+/// memory.rs init, at its end: the 64DD's pages, and with no cartridge the cartridge's pages
+/// (SRAM/FlashRAM, ROM, IS-Viewer, SC64) back to open bus
+pub fn map(device: &mut device::Device) {
+    if !device.dd.attached {
+        return;
+    }
+    let memory = &mut device.memory;
+    if device.dd.cart_absent {
+        let pif = device::memory::MM_PIF_MEM >> 16;
+        let pages = (device::memory::MM_DOM2_ADDR2 >> 16..pif)
+            .chain(device::memory::MM_SC64_BUFFER >> 16..0x2000);
+        for i in pages {
+            memory.fast_read[i] = device::unmapped::read_mem_fast;
+            memory.memory_map_read[i] = device::unmapped::read_mem;
+            memory.memory_map_write[i] = device::unmapped::write_mem;
+        }
+    }
+    memory.memory_map_read[DD_PAGE] = read_regs;
+    memory.memory_map_write[DD_PAGE] = write_regs;
+    for i in IPL_PAGE..IPL_PAGE + (IPL_SIZE >> 16) {
+        memory.fast_read[i] = read_ipl_fast;
+        memory.memory_map_read[i] = read_ipl;
+        memory.memory_map_write[i] = write_ipl;
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Save states: the "dd" entry of a state file (the CPU's events past Gopher64's own are kept in
+// it, so that Gopher64's own entries stay as they were: events.rs serialize_events)
+
+#[derive(serde::Serialize, serde::Deserialize)]
+struct StateEntry {
+    state: DdState,
+    events: Vec<device::events::Event>,
+}
+
+/// The entry for `snapshot`, a state of the running device whose 64DD is `live` (None without
+/// one: nothing is added to the file)
+pub fn state_entry(live: &Dd, snapshot: &device::Device) -> Option<Vec<u8>> {
+    if !live.attached {
+        return None;
+    }
+    let entry = StateEntry {
+        state: snapshot.dd.state.clone(),
+        events: snapshot.cpu.events[device::events::EVENT_TYPE_SAVED_COUNT..].to_vec(),
+    };
+    postcard::to_stdvec(&entry).ok()
+}
+
+/// A state file's entries, and the 64DD's after them when there is one
+pub fn with_entry<'a>(
+    entries: &[(&'a [u8], &'a str)],
+    dd: Option<&'a [u8]>,
+) -> Vec<(&'a [u8], &'a str)> {
+    let mut all = entries.to_vec();
+    if let Some(dd) = dd {
+        all.push((dd, "dd"));
+    }
+    all
+}
+
+/// Put a state file's entry into the loaded `state`. With a 64DD the entry must be there and be for
+/// the same disk; without one the state is taken as it is.
+pub fn restore_entry(
+    current: &Dd,
+    mut state: Box<device::Device>,
+    entry: Option<Vec<u8>>,
+) -> Option<Box<device::Device>> {
+    if !current.attached {
+        if entry.is_some() {
+            // its next event or Cause IP3 may be the 64DD's
+            log("64dd: the state was made with the 64DD, this run has none: not loaded");
+            return None;
+        }
+        return Some(state);
+    }
+    let Some(entry) = entry else {
+        log("64dd: the state was made without the 64DD: not loaded");
+        return None;
+    };
+    let Ok(entry) = postcard::from_bytes::<StateEntry>(&entry) else {
+        log("64dd: the state's 64DD entry is unreadable: not loaded");
+        return None;
+    };
+    if entry.state.disk_hash != current.state.disk_hash {
+        log("64dd: the state is for another disk (or none): not loaded");
+        return None;
+    }
+    let regs = &entry.state.regs;
+    let valid = regs.c2s.len() == C2S_SIZE
+        && regs.ds.len() == DS_SIZE
+        && regs.ms.len() == MS_SIZE
+        && entry.state.overlay.iter().all(|(index, block)| {
+            (*index as usize) < disk::BLOCKS
+                && block.len() == disk::block_size_of_index(*index as usize) as usize
+        });
+    let extra = &mut state.cpu.events[device::events::EVENT_TYPE_SAVED_COUNT..];
+    if !valid || entry.events.len() != extra.len() {
+        log("64dd: the state's 64DD entry is malformed: not loaded");
+        return None;
+    }
+    extra.copy_from_slice(&entry.events);
+    state.dd.state = entry.state;
+    Some(state)
+}
