+// The handler of a COP1 instruction (opcode >> 26 == 17), as cop1.instrs and execute_cop1_* give it
+#[inline(always)]
+pub fn decode_opcode(device: &device::Device, opcode: u32) -> fn(&mut device::Device, u32) {
+    let funct = (opcode & 0x3F) as usize;
+    match (opcode >> 21) & 0x1F {
+        8 => B_DIRECT[((opcode >> 16) & 0x1F) as usize],
+        16 => S_DIRECT[funct],
+        17 => D_DIRECT[funct],
+        20 => W_DIRECT[funct],
+        21 => L_DIRECT[funct],
+        fmt => device.cpu.cop1.instrs[fmt as usize],
+    }
+}
