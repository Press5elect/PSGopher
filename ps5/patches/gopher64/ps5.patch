+/// The 64DD as configured for this run. Not attached: nothing of it exists.
+#[derive(Default)]
+pub struct Dd {
+    pub attached: bool,
+    /// no cartridge: the console boots the IPL (the PIF's ROM type bit), cartridge space is open bus
+    pub cart_absent: bool,
+    pub ipl: Vec<u8>,
+    pub ipl_kind: IplKind,
+    pub disk: Option<disk::Disk>,
+    pub writes_path: Option<std::path::PathBuf>,
