+// SPDX-License-Identifier: GPL-3.0-or-later
+// Additional term (GPL-3.0 section 7(b)): keep the attribution "PSGopher by Press5elect"; see PSGopher's NOTICE.
+//! PSGopher (PS5): HTTPS GET for the updater (ps5/host/update_net.cpp): to a buffer or to a file,
+//! with redirects. Added by PSGopher's ps5.patch.
+//!
+//! The same way `psgopher::https_get` reaches a server (Tokio's sockets are refused on the
+//! console, so this is rustls over a blocking IPv4 socket; the roots are webpki-roots', the console
+//! has no store), but streaming: a release's ZIP is tens of megabytes and goes to its file as it
+//! comes. GitHub serves a release's file from another host (objects.githubusercontent.com,
+//! release-assets.githubusercontent.com): a redirect is followed, to HTTPS only, at most
+//! `MAX_REDIRECTS` times, and nothing but the status, the location, the length and the way the
+//! body is framed is read from the head.
+
+use std::ffi::{c_char, c_void};
+use std::io::{Read, Write};
+use std::time::{Duration, Instant};
+
+const MAX_REDIRECTS: usize = 5;
+const MAX_HEAD: usize = 32 << 10;
+/// A transfer that brings nothing for this long is stopped.
+const STALL: Duration = Duration::from_secs(30);
+
+/// How a request ended without an answer.
+#[derive(Debug, PartialEq)]
+enum Failure {
+    Network,
+    /// The caller's callback said stop.
+    Stopped,
+    /// The body is longer than the caller allows.
+    TooLarge,
+}
+
+/// What the receiver of a body says after each piece.
+#[derive(PartialEq)]
+enum Next {
+    Go,
+    Stop,
+    TooLarge,
+}
+
+fn log(host: &str, what: &str, why: &str) {
+    crate::psgopher::log_line(&format!("update: net: {host}: {what}: {why}"));
+}
+
+fn tls_config() -> std::sync::Arc<rustls::ClientConfig> {
+    crate::ui::install_default_crypto_provider();
+    static CONFIG: std::sync::OnceLock<std::sync::Arc<rustls::ClientConfig>> = std::sync::OnceLock::new();
+    CONFIG
+        .get_or_init(|| {
+            let roots = rustls::RootCertStore { roots: webpki_roots::TLS_SERVER_ROOTS.to_vec() };
+            std::sync::Arc::new(rustls::ClientConfig::builder().with_root_certificates(roots).with_no_client_auth())
+        })
+        .clone()
+}
+
+/// "https://host[:port]/path" into its parts. None for any other scheme, an empty host, or a
+/// character that could end the request line early.
+fn split_url(url: &str) -> Option<(String, u16, String)> {
+    let rest = url.strip_prefix("https://")?;
+    if url.bytes().any(|b| b <= 0x20 || b == 0x7f) {
+        return None;
+    }
+    let (authority, path) = match rest.find(['/', '?', '#']) {
+        Some(at) if rest.as_bytes()[at] == b'/' => (&rest[..at], rest[at..].to_string()),
+        Some(at) => (&rest[..at], format!("/{}", &rest[at..])),
+        None => (rest, "/".to_string()),
+    };
+    let path = path.split('#').next().unwrap_or("/").to_string();
+    if authority.contains('@') {
+        return None;
+    }
+    let (host, port) = match authority.rsplit_once(':') {
+        Some((host, port)) => (host, port.parse::<u16>().ok()?),
+        None => (authority, 443),
+    };
+    if host.is_empty() || port == 0 {
+        return None;
+    }
+    Some((host.to_string(), port, path))
+}
+
+/// Where a redirect leads, from the address it came from. HTTPS only.
+fn resolve(from_host: &str, from_port: u16, location: &str) -> Option<String> {
+    if location.starts_with("https://") {
+        Some(location.to_string())
+    } else if location.starts_with('/') && !location.starts_with("//") {
+        Some(if from_port == 443 {
+            format!("https://{from_host}{location}")
+        } else {
+            format!("https://{from_host}:{from_port}{location}")
+        })
+    } else {
+        None
+    }
+}
+
+struct Head {
+    status: u16,
+    location: Option<String>,
+    length: Option<u64>,
+    chunked: bool,
+}
+
+fn parse_head(raw: &[u8]) -> Option<Head> {
+    let text = String::from_utf8_lossy(raw);
+    let mut lines = text.split("\r\n");
+    let status: u16 = lines.next()?.split_whitespace().nth(1)?.parse().ok()?;
+    let mut head = Head { status, location: None, length: None, chunked: false };
+    for line in lines {
+        let Some((name, value)) = line.split_once(':') else { continue };
+        let value = value.trim();
+        match name.trim().to_ascii_lowercase().as_str() {
+            "location" => head.location = Some(value.to_string()),
+            "content-length" => head.length = value.parse().ok(),
+            "transfer-encoding" => head.chunked = value.to_ascii_lowercase().contains("chunked"),
+            _ => {}
+        }
+    }
+    Some(head)
+}
+
+/// Chunked transfer coding, streamed.
+#[derive(Default)]
+struct Chunks {
+    line: Vec<u8>,
+    left: usize,
+    state: ChunkState,
+    done: bool,
+}
+
+#[derive(Default, PartialEq, Clone, Copy)]
+enum ChunkState {
+    #[default]
+    Size,
+    Data,
+    DataEnd,
+    Trailer,
+}
+
+impl Chunks {
+    /// Feeds raw bytes; the plain ones go to `out`. False: the framing is wrong or `out` refused.
+    fn feed(&mut self, mut raw: &[u8], out: &mut dyn FnMut(&[u8]) -> Next) -> Result<(), Failure> {
+        while !raw.is_empty() && !self.done {
+            match self.state {
+                ChunkState::Size | ChunkState::Trailer | ChunkState::DataEnd => {
+                    let b = raw[0];
+                    raw = &raw[1..];
+                    if b != b'\n' {
+                        if self.line.len() > 4096 {
+                            return Err(Failure::Network);
+                        }
+                        self.line.push(b);
+                        continue;
+                    }
+                    let line = std::mem::take(&mut self.line);
+                    let line = String::from_utf8_lossy(&line).trim().to_string();
+                    match self.state {
+                        ChunkState::Size => {
+                            let size = line.split(';').next().unwrap_or("").trim();
+                            let size = usize::from_str_radix(size, 16).map_err(|_| Failure::Network)?;
+                            if size == 0 {
+                                self.state = ChunkState::Trailer;
+                            } else {
+                                self.left = size;
+                                self.state = ChunkState::Data;
+                            }
+                        }
+                        ChunkState::DataEnd => self.state = ChunkState::Size,
+                        // (trailer lines are ignored; the empty line ends the body)
+                        _ => {
+                            if line.is_empty() {
+                                self.done = true;
+                            }
+                        }
+                    }
+                }
+                ChunkState::Data => {
+                    let n = self.left.min(raw.len());
+                    match out(&raw[..n]) {
+                        Next::Go => {}
+                        Next::Stop => return Err(Failure::Stopped),
+                        Next::TooLarge => return Err(Failure::TooLarge),
+                    }
+                    raw = &raw[n..];
+                    self.left -= n;
+                    if self.left == 0 {
+                        self.state = ChunkState::DataEnd;
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+/// How the final answer's body is framed, and how much of it came.
+struct Body {
+    chunked: bool,
+    length: Option<u64>,
+    got: u64,
+    chunks: Chunks,
+    empty: bool,
+}
+
+impl Body {
+    fn complete(&self) -> bool {
+        if self.chunked { self.chunks.done } else { self.length.is_some_and(|l| self.got >= l) }
+    }
+
+    fn feed(&mut self, raw: &[u8], sink: &mut dyn FnMut(&[u8]) -> Next) -> Result<(), Failure> {
+        if raw.is_empty() {
+            return Ok(());
+        }
+        self.empty = false;
+        if self.chunked {
+            return self.chunks.feed(raw, sink);
+        }
+        let take = match self.length {
+            Some(l) => l.saturating_sub(self.got).min(raw.len() as u64) as usize,
+            None => raw.len(),
+        };
+        self.got += take as u64;
+        match sink(&raw[..take]) {
+            Next::Go => Ok(()),
+            Next::Stop => Err(Failure::Stopped),
+            Next::TooLarge => Err(Failure::TooLarge),
+        }
+    }
+}
+
+/// GET `url`, redirects followed. For the final answer `receive(status, length, piece)` is called
+/// with each piece of its body (and once with an empty piece when the body is empty), whatever
+/// the status. Returns the status.
+fn fetch(
+    url: &str,
+    accept: &str,
+    total: Option<Duration>,
+    receive: &mut dyn FnMut(u16, Option<u64>, &[u8]) -> Next,
+) -> Result<u16, Failure> {
+    let started = Instant::now();
+    let mut address = url.to_string();
+    for _ in 0..=MAX_REDIRECTS {
+        let Some((host, port, path)) = split_url(&address) else {
+            log("-", "address", "not an https address");
+            return Err(Failure::Network);
+        };
+        let Ok(name) = rustls::pki_types::ServerName::try_from(host.clone()) else {
+            log(&host, "name", "not a host name");
+            return Err(Failure::Network);
+        };
+        let target = match std::net::ToSocketAddrs::to_socket_addrs(&(host.as_str(), port)) {
+            Ok(mut list) => match list.find(|a| a.is_ipv4()) {
+                Some(a) => a,
+                None => {
+                    log(&host, "address", "none for IPv4");
+                    return Err(Failure::Network);
+                }
+            },
+            Err(e) => {
+                log(&host, "address", &e.to_string());
+                return Err(Failure::Network);
+            }
+        };
+        let socket = match std::net::TcpStream::connect_timeout(&target, Duration::from_secs(10)) {
+            Ok(s) => s,
+            Err(e) => {
+                log(&host, "connect", &e.to_string());
+                return Err(Failure::Network);
+            }
+        };
+        let wait = total.map_or(STALL, |t| t.min(STALL));
+        let _ = socket.set_read_timeout(Some(wait));
+        let _ = socket.set_write_timeout(Some(wait));
+        let connection = match rustls::ClientConnection::new(tls_config(), name) {
+            Ok(c) => c,
+            Err(e) => {
+                log(&host, "TLS", &e.to_string());
+                return Err(Failure::Network);
+            }
+        };
+        let mut tls = rustls::StreamOwned::new(connection, socket);
+        let request = format!(
+            "GET {path} HTTP/1.1\r\nHost: {host}\r\nUser-Agent: PSGopher (PlayStation 5 homebrew)\r\nAccept: {accept}\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n"
+        );
+        if let Err(e) = tls.write_all(request.as_bytes()) {
+            log(&host, "request", &e.to_string());
+            return Err(Failure::Network);
+        }
+
+        // the head, and whatever of the body came with it
+        let mut data: Vec<u8> = Vec::new();
+        let mut chunk = vec![0u8; 64 << 10];
+        let end = loop {
+            if let Some(at) = data.windows(4).position(|w| w == b"\r\n\r\n") {
+                break at;
+            }
+            if data.len() > MAX_HEAD {
+                log(&host, "answer", "head too long");
+                return Err(Failure::Network);
+            }
+            match tls.read(&mut chunk) {
+                Ok(0) => {
+                    log(&host, "answer", "no HTTP head");
+                    return Err(Failure::Network);
+                }
+                Ok(n) => data.extend_from_slice(&chunk[..n]),
+                Err(e) => {
+                    log(&host, "answer", &e.to_string());
+                    return Err(Failure::Network);
+                }
+            }
+        };
+        let Some(head) = parse_head(&data[..end]) else {
+            log(&host, "answer", "no status");
+            return Err(Failure::Network);
+        };
+        let body_start = data[end + 4..].to_vec();
+        drop(data);
+
+        if matches!(head.status, 301 | 302 | 303 | 307 | 308) {
+            let Some(next) = head.location.as_deref().and_then(|l| resolve(&host, port, l)) else {
+                log(&host, "redirect", "to nowhere, or not to https");
+                return Err(Failure::Network);
+            };
+            address = next;
+            continue;
+        }
+
+        // the body
+        let status = head.status;
+        let mut body = Body { chunked: head.chunked, length: head.length, got: 0, chunks: Chunks::default(), empty: true };
+        let mut sink = |piece: &[u8]| receive(status, head.length, piece);
+        body.feed(&body_start, &mut sink)?;
+        while !body.complete() {
+            if total.is_some_and(|t| started.elapsed() > t) {
+                log(&host, "answer", "too slow");
+                return Err(Failure::Network);
+            }
+            match tls.read(&mut chunk) {
+                Ok(0) => break,
+                Ok(n) => body.feed(&chunk[..n], &mut sink)?,
+                // (a server closing without TLS's close_notify: what came is checked below)
+                Err(e) if e.kind() == std::io::ErrorKind::UnexpectedEof => break,
+                Err(e) => {
+                    log(&host, "answer", &e.to_string());
+                    return Err(Failure::Network);
+                }
+            }
+        }
+        if !body.complete() && (body.chunked || body.length.is_some()) {
+            log(&host, "answer", "cut short");
+            return Err(Failure::Network);
+        }
+        if body.empty && sink(&[]) != Next::Go {
+            return Err(Failure::Stopped);
+        }
+        return Ok(status);
+    }
+    log("-", "redirect", "too many");
+    Err(Failure::Network)
+}
+
+fn text(pointer: *const c_char) -> String {
+    if pointer.is_null() {
+        return String::new();
+    }
+    unsafe { std::ffi::CStr::from_ptr(pointer) }.to_string_lossy().into_owned()
+}
+
+/// GET `url` into `buffer` (`capacity` bytes) and its length into `length`. Returns the HTTP
+/// status (the body is kept whatever it is), -1 when the network failed, -3 when the body is
+/// longer than `capacity`. `seconds`: how long it may take in all.
+///
+/// # Safety
+/// `url` and `accept` are NUL-terminated; `buffer` holds `capacity` bytes; `length` is writable.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_http_get(
+    url: *const c_char,
+    accept: *const c_char,
+    seconds: u32,
+    buffer: *mut u8,
+    capacity: usize,
+    length: *mut usize,
+) -> i32 {
+    if buffer.is_null() || length.is_null() {
+        return -1;
+    }
+    unsafe { *length = 0 };
+    let mut filled = 0usize;
+    let result = fetch(&text(url), &text(accept), Some(Duration::from_secs(u64::from(seconds.max(1)))), &mut |_, _, piece| {
+        if filled + piece.len() > capacity {
+            return Next::TooLarge;
+        }
+        unsafe { std::ptr::copy_nonoverlapping(piece.as_ptr(), buffer.add(filled), piece.len()) };
+        filled += piece.len();
+        Next::Go
+    });
+    unsafe { *length = filled };
+    match result {
+        Ok(status) => i32::from(status),
+        Err(Failure::TooLarge) => -3,
+        Err(_) => -1,
+    }
+}
+
+/// Called as a download comes: bytes so far, the whole length (0 when unknown), the caller's own
+/// pointer. Returns 0 to stop.
+pub type Progress = Option<unsafe extern "C" fn(done: u64, total: u64, user: *mut c_void) -> i32>;
+
+/// GET `url` into the file `path` (created or truncated, only when the answer is 200; written in
+/// full and synced), no more than `limit` bytes. Returns the HTTP status, -1 when the network or
+/// the file failed, -2 when `progress` stopped it, -3 when it is longer than `limit`. A file of
+/// a failed or stopped download is removed.
+///
+/// # Safety
+/// `url` and `path` are NUL-terminated; `user` is whatever `progress` expects.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_http_download(
+    url: *const c_char,
+    path: *const c_char,
+    limit: u64,
+    progress: Progress,
+    user: *mut c_void,
+) -> i32 {
+    let path = text(path);
+    let mut file: Option<std::fs::File> = None;
+    let mut written: u64 = 0;
+    let mut file_failed = false;
+    let mut last_report = Instant::now() - Duration::from_secs(1);
+    let result = fetch(&text(url), "application/octet-stream", None, &mut |status, length, piece| {
+        if status != 200 {
+            return Next::Go; // (the body of an error is not kept)
+        }
+        if file.is_none() {
+            match std::fs::File::create(&path) {
+                Ok(f) => file = Some(f),
+                Err(e) => {
+                    log("-", "file", &e.to_string());
+                    file_failed = true;
+                    return Next::Stop;
+                }
+            }
+        }
+        if limit != 0 && written + piece.len() as u64 > limit {
+            return Next::TooLarge;
+        }
+        if let Some(f) = file.as_mut() {
+            if let Err(e) = f.write_all(piece) {
+                log("-", "file", &e.to_string());
+                file_failed = true;
+                return Next::Stop;
+            }
+        }
+        written += piece.len() as u64;
+        if let Some(report) = progress {
+            if last_report.elapsed() >= Duration::from_millis(100) {
+                last_report = Instant::now();
+                if unsafe { report(written, length.unwrap_or(0), user) } == 0 {
+                    return Next::Stop;
+                }
+            }
+        }
+        Next::Go
+    });
+    let mut synced = true;
+    if let Some(f) = file.as_ref() {
+        synced = f.sync_all().is_ok();
+    }
+    drop(file);
+    let code = match result {
+        Ok(200) if synced && !file_failed => {
+            if let Some(report) = progress {
+                unsafe { report(written, written, user) };
+            }
+            200
+        }
+        Ok(200) => -1,
+        Ok(status) => i32::from(status),
+        Err(Failure::Stopped) if !file_failed => -2,
+        Err(Failure::TooLarge) => -3,
+        Err(_) => -1,
+    };
+    if code != 200 {
+        let _ = std::fs::remove_file(&path);
+    }
+    code
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn urls() {
+        assert_eq!(split_url("https://a.example/x?y=1"), Some(("a.example".into(), 443, "/x?y=1".into())));
+        assert_eq!(split_url("https://a.example:8443"), Some(("a.example".into(), 8443, "/".into())));
+        assert_eq!(split_url("http://a.example/"), None);
+        assert_eq!(split_url("https://u@a.example/"), None);
+        assert_eq!(split_url("https://a.example/a b"), None);
+        assert_eq!(resolve("h", 443, "/p"), Some("https://h/p".into()));
+        assert_eq!(resolve("h", 443, "http://x/"), None);
+        assert_eq!(resolve("h", 443, "//x/"), None);
+    }
+
+    #[test]
+    fn chunks() {
+        let mut got = Vec::new();
+        let mut c = Chunks::default();
+        let body = b"4\r\nWiki\r\n5;x=1\r\npedia\r\n0\r\n\r\n";
+        for piece in body.chunks(3) {
+            c.feed(piece, &mut |p| {
+                got.extend_from_slice(p);
+                Next::Go
+            })
+            .unwrap();
+        }
+        assert!(c.done);
+        assert_eq!(got, b"Wikipedia");
+    }
+}
