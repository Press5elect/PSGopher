+// PSGopher: a cache line's words (N of them, from a line-aligned address), as N calls of
+// read_mem/write_mem give them: the same cycles (rdram_cycles_per_word is the same for each word of
+// the access), the same words and bytes, but one RDP check for the line instead of one per word.
+// The check only waits for RDP work that touches the range; a word it does not touch reads the same
+// before or after the wait, so the data is the same. The caller uses these only where the memory
+// map holds read_mem/write_mem itself (cache.rs).
+pub fn read_line<const N: usize>(
+    device: &mut device::Device,
+    address: u64,
+    access_size: device::memory::AccessSize,
+) -> [u32; N] {
+    let cycles = match access_size {
+        device::memory::AccessSize::Dcache => const { rdram_cycles_per_word(16) },
+        device::memory::AccessSize::Icache => const { rdram_cycles_per_word(32) },
+        _ => unreachable!(),
+    };
+    device::cop0::add_cycles(device, cycles * N as u64);
+    let masked_address = address as usize & RDRAM_MASK;
+
+    ui::video::check_rdram_read(masked_address as u32, 4 * N as u32);
+
+    let mut words = [0; N];
+    for (i, word) in words.iter_mut().enumerate() {
+        let at = masked_address + 4 * i;
+        *word = u32::from_ne_bytes(
+            device
+                .rdram
+                .mem
+                .get(at..at + 4)
+                .unwrap_or(&[0; 4])
+                .try_into()
+                .unwrap_or_default(),
+        );
+    }
+    words
+}
+
+pub fn write_line<const N: usize>(device: &mut device::Device, address: u64, words: &[u32; N]) {
+    let masked_address = address as usize & RDRAM_MASK;
+
+    ui::video::check_rdram_write(masked_address as u32, 4 * N as u32);
+
+    for (i, word) in words.iter().enumerate() {
+        let at = masked_address + 4 * i;
+        if let Some(dst) = device.rdram.mem.get_mut(at..at + 4) {
+            dst.copy_from_slice(&word.to_ne_bytes());
