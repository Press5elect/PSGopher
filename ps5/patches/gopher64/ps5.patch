+/// The console probe (`/data/psgopher/probe.txt`): what std, Tokio and the clocks do on the console,
+/// one `probe:` line each to klog (docs/dev/performance.md, "Timing facts to establish").
+#[unsafe(no_mangle)]
+pub extern "C" fn psgopher_probe() {
+    use std::time::{Duration, Instant};
+    let say = |what: &str, result: String| eprintln!("probe: {what}: {result}");
+
+    // std's Mutex and Condvar between two threads (FreeBSD's _umtx_op under both)
+    let pair = std::sync::Arc::new((std::sync::Mutex::new(0u32), std::sync::Condvar::new()));
+    let other = pair.clone();
+    let start = Instant::now();
+    let rounds = 10_000u32;
+    let spawned = std::thread::Builder::new()
+        .name("psgopher-probe".into())
+        .spawn(move || {
+            let (lock, cv) = &*other;
+            for i in 0..rounds {
+                let mut v = lock.lock().unwrap();
+                while *v != i * 2 + 1 {
+                    v = cv.wait(v).unwrap();
+                }
+                *v += 1;
+                cv.notify_one();
+            }
+        });
+    match spawned {
+        Ok(handle) => {
+            let (lock, cv) = &*pair;
+            for i in 0..rounds {
+                let mut v = lock.lock().unwrap();
+                while *v != i * 2 {
+                    v = cv.wait(v).unwrap();
+                }
+                *v += 1;
+                cv.notify_one();
+            }
+            let _ = handle.join();
+            say(
+                "mutex+condvar ping-pong",
+                format!("{rounds} rounds, {:.2} us a round", start.elapsed().as_secs_f64() * 1e6 / rounds as f64),
+            );
+        }
+        Err(e) => say("named thread", format!("FAILED {e}")),
+    }
+
+    // Instant::now: cost and the smallest step it shows
+    let n = 1_000_000;
+    let start = Instant::now();
+    let mut smallest = Duration::MAX;
+    let mut last = start;
+    for _ in 0..n {
+        let now = Instant::now();
+        let d = now - last;
+        if d > Duration::ZERO && d < smallest {
+            smallest = d;
+        }
+        last = now;
+    }
+    say(
+        "Instant::now",
+        format!("{:.1} ns a call, smallest step {} ns", start.elapsed().as_nanos() as f64 / n as f64, smallest.as_nanos()),
+    );
+
+    // sleeping 1 ms: std's (nanosleep) and spin_sleep's (Gopher64's speed limiter)
+    let histogram = |name: &str, sleep: &dyn Fn()| {
+        let mut taken: Vec<f64> = (0..200)
+            .map(|_| {
+                let t = Instant::now();
+                sleep();
+                t.elapsed().as_secs_f64() * 1e3
+            })
+            .collect();
+        taken.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        say(
+            name,
+            format!("1 ms asked: min {:.3} median {:.3} p99 {:.3} max {:.3} ms", taken[0], taken[100], taken[198], taken[199]),
+        );
+    };
+    histogram("std::thread::sleep", &|| std::thread::sleep(Duration::from_millis(1)));
+    histogram("spin_sleep::sleep", &|| spin_sleep::sleep(Duration::from_millis(1)));
+
+    // randomness (rand's SysRng, through getrandom)
+    let mut bytes = [0u8; 32];
+    use rand::TryRng;
+    let ok = rand::rngs::SysRng.try_fill_bytes(&mut bytes).is_ok() && bytes.iter().any(|b| *b != 0);
+    say("SysRng", if ok { "32 bytes".into() } else { "FAILED".into() });
+
+    // a file: 4 MiB written in one write() and read back
+    let path = dirs().cache_dir.join("probe.bin");
+    let data: Vec<u8> = (0..4u32 << 20).map(|i| (i * 2654435761u32 >> 24) as u8).collect();
+    let t = Instant::now();
+    let written = std::fs::write(&path, &data);
+    let write_ms = t.elapsed().as_secs_f64() * 1e3;
+    let t = Instant::now();
+    let read = std::fs::read(&path);
+    let read_ms = t.elapsed().as_secs_f64() * 1e3;
+    say(
+        "file 4 MiB",
+        match (written, read) {
+            (Ok(()), Ok(back)) if back == data => format!("write {write_ms:.1} ms, read {read_ms:.1} ms, same bytes"),
+            (w, r) => format!("FAILED write {:?} read {:?}", w.err(), r.err().map(|e| e.to_string())),
+        },
+    );
+    let _ = std::fs::remove_file(&path);
+
+    // Tokio: a runtime, a file written by tokio::fs, a reply over a oneshot (Gopher64's saves)
+    let t = Instant::now();
+    let (close_tx, handle) = crate::create_runtime();
+    let (tx, rx) = tokio::sync::oneshot::channel();
+    let path = dirs().cache_dir.join("probe-tokio.bin");
+    handle.spawn(async move {
+        let r = tokio::fs::write(&path, b"psgopher").await;
+        let _ = std::fs::remove_file(&path);
+        let _ = tx.send(r.is_ok());
+    });
+    say(
+        "tokio::fs::write",
+        match rx.blocking_recv() {
+            Ok(true) => format!("ok in {:.1} ms (with the runtime's start)", t.elapsed().as_secs_f64() * 1e3),
+            other => format!("FAILED {other:?}"),
+        },
+    );
+    let _ = close_tx.send(());
+    say(
+        "available_parallelism",
+        format!("{:?}", std::thread::available_parallelism().map(|n| n.get())),
+    );
+}
+
+/// GET https://host/path with rustls over a blocking socket (Tokio's sockets are refused on the
+/// console, so reqwest cannot be used; the roots are webpki-roots', the console has no store):
+/// the status (0 when the network or TLS failed) and the body.
+fn https_get(host: &str, path: &str, accept: &str, timeout: std::time::Duration) -> (u16, Vec<u8>) {
+    use std::io::{Read, Write};
+    crate::ui::install_default_crypto_provider();
+    static CONFIG: std::sync::OnceLock<std::sync::Arc<rustls::ClientConfig>> = std::sync::OnceLock::new();
+    let config = CONFIG
+        .get_or_init(|| {
+            let roots = rustls::RootCertStore { roots: webpki_roots::TLS_SERVER_ROOTS.to_vec() };
+            std::sync::Arc::new(rustls::ClientConfig::builder().with_root_certificates(roots).with_no_client_auth())
+        })
+        .clone();
+    let failed = |what: &str, why: String| {
+        log_line(&format!("web: {host}: {what}: {why}"));
+        (0u16, Vec::new())
+    };
+    let Ok(name) = rustls::pki_types::ServerName::try_from(host.to_string()) else {
+        return failed("name", "not a host name".into());
+    };
+    let address = match std::net::ToSocketAddrs::to_socket_addrs(&(host, 443)) {
+        Ok(mut list) => match list.find(|a| a.is_ipv4()) {
+            Some(a) => a,
+            None => return failed("address", "none for IPv4".into()),
+        },
+        Err(e) => return failed("address", e.to_string()),
+    };
+    let socket = match std::net::TcpStream::connect_timeout(&address, std::time::Duration::from_secs(10)) {
+        Ok(s) => s,
+        Err(e) => return failed("connect", e.to_string()),
+    };
+    let _ = socket.set_read_timeout(Some(timeout));
+    let _ = socket.set_write_timeout(Some(timeout));
+    let connection = match rustls::ClientConnection::new(config, name) {
+        Ok(c) => c,
+        Err(e) => return failed("TLS", e.to_string()),
+    };
+    let mut tls = rustls::StreamOwned::new(connection, socket);
+    let request = format!(
+        "GET {path} HTTP/1.1\r\nHost: {host}\r\nUser-Agent: PSGopher (PlayStation 5 homebrew)\r\nAccept: {accept}\r\nAccept-Encoding: identity\r\nConnection: close\r\n\r\n"
+    );
+    if let Err(e) = tls.write_all(request.as_bytes()) {
+        return failed("request", e.to_string());
+    }
+    let mut data = Vec::new();
+    let mut chunk = [0u8; 16384];
+    loop {
+        match tls.read(&mut chunk) {
+            Ok(0) => break,
+            Ok(n) => {
+                data.extend_from_slice(&chunk[..n]);
+                if data.len() > 16 << 20 {
+                    return failed("answer", "longer than 16 MiB".into());
+                }
+            }
+            // (a server closing without TLS's close_notify: what came is kept, its length checked below)
+            Err(e) if e.kind() == std::io::ErrorKind::UnexpectedEof => break,
+            Err(e) => return failed("answer", e.to_string()),
+        }
+    }
+    let Some(end) = data.windows(4).position(|w| w == b"\r\n\r\n") else {
+        return failed("answer", "no HTTP head".into());
+    };
+    let head = String::from_utf8_lossy(&data[..end]).to_ascii_lowercase();
+    let status: u16 = head.split_whitespace().nth(1).and_then(|s| s.parse().ok()).unwrap_or(0);
+    let raw = &data[end + 4..];
+    let body = if head.contains("\r\ntransfer-encoding: chunked") {
+        let mut plain = Vec::new();
+        let mut at = 0;
+        let mut whole = false;
+        while at < raw.len() {
+            let Some(le) = raw[at..].windows(2).position(|w| w == b"\r\n") else { break };
+            let line = String::from_utf8_lossy(&raw[at..at + le]);
+            let Ok(len) = usize::from_str_radix(line.split(';').next().unwrap_or("").trim(), 16) else { break };
+            if len == 0 {
+                whole = true;
+                break;
+            }
+            let start = at + le + 2;
+            if len > raw.len().saturating_sub(start) {
+                break;
+            }
+            plain.extend_from_slice(&raw[start..start + len]);
+            at = start + len + 2;
+        }
+        if !whole {
+            return failed("answer", "cut short".into());
+        }
+        plain
+    } else {
+        let mut body = raw.to_vec();
+        if let Some(at) = head.find("\r\ncontent-length:") {
+            let want: usize = head[at + 17..].split("\r\n").next().unwrap_or("").trim().parse().unwrap_or(0);
+            if body.len() < want {
+                return failed("answer", "cut short".into());
+            }
+            body.truncate(want);
+        }
+        body
+    };
+    (status, body)
+}
+
+fn url_encode(text: &str) -> String {
+    let mut out = String::new();
+    for b in text.bytes() {
+        if b.is_ascii_alphanumeric() || b"-_.~".contains(&b) {
+            out.push(b as char);
+        } else {
+            out.push_str(&format!("%{b:02X}"));
+        }
+    }
+    out
+}
