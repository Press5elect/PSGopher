+    #[test]
+    fn seek_and_read_a_sector() {
+        let mut device = with_disk();
+        command(&mut device, command::READ_SEEK, 20); // head 0, track 20: LBA 40 and 41
+        assert_eq!(read(&mut device, 0x0500_050C) >> 16, 0x6000 | 20);
+        write(&mut device, ASIC_HOST_SECBYTE, (0xE8 - 1) << 16);
+        // BM: start, read, sector 0 of block 0
+        write(&mut device, ASIC_BM_CTL, (1 << 31) | (1 << 30));
+        run_event(&mut device, EVENT_TYPE_DD_BM);
+        let s = status(&mut device); // acknowledges, and asks for the next sector
+        assert_ne!(s & STATUS_BM_INT, 0);
+        assert_ne!(s & (1 << 14), 0, "user sector ready");
+        assert_eq!(read(&mut device, DS), 40);
+        assert_eq!(read(&mut device, DS + 4), 0xA5A5_A5A5);
+        assert!(device.cpu.events[EVENT_TYPE_DD_BM].enabled);
+        assert_eq!(status(&mut device) & STATUS_BM_INT, 0);
+        run_event(&mut device, EVENT_TYPE_DD_BM);
+        assert_eq!(read(&mut device, DS), 0xA5A5_A5A5, "sector 1");
+        // PI DMA of the sector buffer
+        let (_, to_rdram) = pi_handlers(&device, 0x0500_0400).unwrap();
+        device.rdram.mem = vec![0; 0x800000];
+        to_rdram(&mut device, 0x0500_0400, 0x100, 8);
+        let byte = |d: &device::Device, i: usize| d.rdram.mem[i ^ d.byte_swap];
+        assert_eq!(
+            (0..4).map(|i| byte(&device, 0x100 + i)).collect::<Vec<_>>(),
+            vec![0xA5; 4]
+        );
+        // the retail copy protection: block 12 (track 6) reads with C1 errors
+        command(&mut device, command::READ_SEEK, 6);
+        write(&mut device, ASIC_BM_CTL, (1 << 31) | (1 << 30));
+        run_event(&mut device, EVENT_TYPE_DD_BM);
+        assert_ne!(read(&mut device, ASIC_BM_CTL) >> 16 & (1 << 6), 0);
+    }
