+++ b/src/psgopher.rs
@@ -0,0 +1,203 @@
+//! PSGopher (PS5): the entry point the title's `main` calls, and the PS5's folders.
+//!
+//! Everything else runs as on the desktop: `psgopher_main` parses the arguments the title passes
+//! and calls `run`, which plays the game named in them. Added by PSGopher's ps5.patch.
+
+use clap::Parser;
+
+/// The title's data folder on the console, which FTP also reaches (PSGopher's D8).
+pub const DATA_ROOT: &str = "/data/psgopher";
+
+pub fn dirs() -> crate::ui::Dirs {
+    let root = std::path::Path::new(DATA_ROOT);
+    crate::ui::Dirs {
+        config_dir: root.join("config"),
+        data_dir: root.join("data"),
+        cache_dir: root.join("cache"),
+    }
+}
+
+/// First boot: every pad the console has at start goes to the port of its player, with the
+/// default profile, through Gopher64's own assignment (D7). Ports keep what the owner set later.
+fn assign_pads() {
+    crate::ui::sdl_init(sdl3_sys::init::SDL_INIT_GAMEPAD);
+    let pads = crate::ui::input::get_joysticks().len();
+    let mut config = crate::ui::config::Config::new();
+    for port in 1..=pads.min(4) {
+        if config.input.controller_assignment[port - 1].is_none() {
+            crate::ui::input::assign_controller(&mut config, (port - 1) as i32, port);
+            config.input.controller_enabled[port - 1] = true;
+        }
+    }
+    // (Config is written when it is dropped)
+}
+
+/// # Safety
+/// `argv` holds `argc` NUL-terminated strings, as C's `main` receives them.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn psgopher_main(argc: i32, argv: *const *const std::ffi::c_char) -> i32 {
+    let args: Vec<String> = (0..argc.max(0) as usize)
+        .map(|i| {
+            unsafe { std::ffi::CStr::from_ptr(*argv.add(i)) }
+                .to_string_lossy()
+                .into_owned()
+        })
+        .collect();
+    // A panic must not unwind into C: it is reported and the title ends through the shell.
+    let result = std::panic::catch_unwind(move || {
+        let dirs = dirs();
+        for dir in [&dirs.config_dir, &dirs.cache_dir, &dirs.data_dir] {
+            let _ = std::fs::create_dir_all(dir);
+        }
+        assign_pads();
+        let (close_tx, handle) = crate::create_runtime();
+        let _guard = handle.enter();
+        let arg_count = args.len();
+        let result = match crate::Args::try_parse_from(args) {
+            Ok(args) => crate::run(args, arg_count),
+            Err(e) => Err(std::io::Error::other(e.to_string())),
+        };
+        let _ = close_tx.send(());
+        result
+    });
+    match result {
+        Ok(Ok(())) => 0,
+        Ok(Err(e)) => {
+            eprintln!("psgopher: {e}");
+            1
+        }
+        Err(_) => {
+            eprintln!("psgopher: the emulator panicked (above)");
+            101
+        }
+    }
+}
+
+/// The console probe (`/data/psgopher/probe.txt`): what std, Tokio and the clocks do on the console,
+/// one `probe:` line each to klog (PS5_PERFORMANCE.md, "Timing facts to establish").
+#[unsafe(no_mangle)]
+pub extern "C" fn psgopher_probe() {
+    use std::time::{Duration, Instant};
+    let say = |what: &str, result: String| eprintln!("probe: {what}: {result}");
+
+    // std's Mutex and Condvar between two threads (FreeBSD's _umtx_op under both)
+    let pair = std::sync::Arc::new((std::sync::Mutex::new(0u32), std::sync::Condvar::new()));
+    let other = pair.clone();
+    let start = Instant::now();
+    let rounds = 10_000u32;
+    let spawned = std::thread::Builder::new()
+        .name("psgopher-probe".into())
+        .spawn(move || {
+            let (lock, cv) = &*other;
+            for i in 0..rounds {
+                let mut v = lock.lock().unwrap();
+                while *v != i * 2 + 1 {
+                    v = cv.wait(v).unwrap();
+                }
+                *v += 1;
+                cv.notify_one();
+            }
+        });
+    match spawned {
+        Ok(handle) => {
+            let (lock, cv) = &*pair;
+            for i in 0..rounds {
+                let mut v = lock.lock().unwrap();
+                while *v != i * 2 {
+                    v = cv.wait(v).unwrap();
+                }
+                *v += 1;
+                cv.notify_one();
+            }
+            let _ = handle.join();
+            say(
+                "mutex+condvar ping-pong",
+                format!("{rounds} rounds, {:.2} us a round", start.elapsed().as_secs_f64() * 1e6 / rounds as f64),
+            );
+        }
+        Err(e) => say("named thread", format!("FAILED {e}")),
+    }
+
+    // Instant::now: cost and the smallest step it shows
+    let n = 1_000_000;
+    let start = Instant::now();
+    let mut smallest = Duration::MAX;
+    let mut last = start;
+    for _ in 0..n {
+        let now = Instant::now();
+        let d = now - last;
+        if d > Duration::ZERO && d < smallest {
+            smallest = d;
+        }
+        last = now;
+    }
+    say(
+        "Instant::now",
+        format!("{:.1} ns a call, smallest step {} ns", start.elapsed().as_nanos() as f64 / n as f64, smallest.as_nanos()),
+    );
+
+    // sleeping 1 ms: std's (nanosleep) and spin_sleep's (Gopher64's speed limiter)
+    let histogram = |name: &str, sleep: &dyn Fn()| {
+        let mut taken: Vec<f64> = (0..200)
+            .map(|_| {
+                let t = Instant::now();
+                sleep();
+                t.elapsed().as_secs_f64() * 1e3
+            })
+            .collect();
+        taken.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        say(
+            name,
+            format!("1 ms asked: min {:.3} median {:.3} p99 {:.3} max {:.3} ms", taken[0], taken[100], taken[198], taken[199]),
+        );
+    };
+    histogram("std::thread::sleep", &|| std::thread::sleep(Duration::from_millis(1)));
+    histogram("spin_sleep::sleep", &|| spin_sleep::sleep(Duration::from_millis(1)));
+
+    // randomness (rand's SysRng, through getrandom)
+    let mut bytes = [0u8; 32];
+    use rand::TryRng;
+    let ok = rand::rngs::SysRng.try_fill_bytes(&mut bytes).is_ok() && bytes.iter().any(|b| *b != 0);
+    say("SysRng", if ok { "32 bytes".into() } else { "FAILED".into() });
+
+    // a file: 4 MiB written in one write() and read back
+    let path = dirs().cache_dir.join("probe.bin");
+    let data: Vec<u8> = (0..4u32 << 20).map(|i| (i * 2654435761u32 >> 24) as u8).collect();
+    let t = Instant::now();
+    let written = std::fs::write(&path, &data);
+    let write_ms = t.elapsed().as_secs_f64() * 1e3;
+    let t = Instant::now();
+    let read = std::fs::read(&path);
+    let read_ms = t.elapsed().as_secs_f64() * 1e3;
+    say(
+        "file 4 MiB",
+        match (written, read) {
+            (Ok(()), Ok(back)) if back == data => format!("write {write_ms:.1} ms, read {read_ms:.1} ms, same bytes"),
+            (w, r) => format!("FAILED write {:?} read {:?}", w.err(), r.err().map(|e| e.to_string())),
+        },
+    );
+    let _ = std::fs::remove_file(&path);
+
+    // Tokio: a runtime, a file written by tokio::fs, a reply over a oneshot (Gopher64's saves)
+    let t = Instant::now();
+    let (close_tx, handle) = crate::create_runtime();
+    let (tx, rx) = tokio::sync::oneshot::channel();
+    let path = dirs().cache_dir.join("probe-tokio.bin");
+    handle.spawn(async move {
+        let r = tokio::fs::write(&path, b"psgopher").await;
+        let _ = std::fs::remove_file(&path);
+        let _ = tx.send(r.is_ok());
+    });
+    say(
+        "tokio::fs::write",
+        match rx.blocking_recv() {
+            Ok(true) => format!("ok in {:.1} ms (with the runtime's start)", t.elapsed().as_secs_f64() * 1e3),
+            other => format!("FAILED {other:?}"),
+        },
+    );
+    let _ = close_tx.send(());
+    say(
+        "available_parallelism",
+        format!("{:?}", std::thread::available_parallelism().map(|n| n.get())),
+    );
+}
