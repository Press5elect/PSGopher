+    #[test]
+    fn state_entry_round_trip() {
+        // (a Device is deserialized on the stack in a debug build: a thread with room for it)
+        std::thread::Builder::new()
+            .stack_size(256 << 20)
+            .spawn(state_entry_round_trip_body)
+            .unwrap()
+            .join()
+            .unwrap();
+    }
+
+    fn state_entry_round_trip_body() {
+        let mut device = with_disk();
+        command(&mut device, command::READ_SEEK, 33);
+        let mut snapshot = device::Device::new(false);
+        snapshot.clone_state(&device);
+        let entry = state_entry(&device.dd, &snapshot).unwrap();
+        let device_bytes = postcard::to_stdvec(&snapshot).unwrap();
+        let mut loaded = postcard::from_bytes::<Box<device::Device>>(&device_bytes).unwrap();
+        assert!(!loaded.cpu.events[EVENT_TYPE_DD_CLOCK].enabled);
+        loaded = restore_entry(&device.dd, loaded, Some(entry.clone())).unwrap();
+        assert!(loaded.cpu.events[EVENT_TYPE_DD_CLOCK] == device.cpu.events[EVENT_TYPE_DD_CLOCK]);
+        assert_eq!(loaded.dd.state.regs.current_track, 0x6000 | 33);
+        // a state without the entry, or for another disk, is refused with a 64DD
+        assert!(restore_entry(&device.dd, loaded, None).is_none());
+        let other = attached(None, None);
+        let loaded = postcard::from_bytes::<Box<device::Device>>(&device_bytes).unwrap();
+        assert!(restore_entry(&other.dd, loaded, Some(entry)).is_none());
+    }
