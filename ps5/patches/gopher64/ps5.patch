+//
+// Differences from ares, all in how the medium is held, none in what the drive reads:
+// - ares converts every image to its physical layout (0x435B0C0 bytes, the "MAME" layout) and
+//   writes the whole converted image back. Here the user's image is kept as it is and never
+//   written: a table maps each physical block to its bytes in the image (or to the system and ID
+//   blocks made for a .d64), and the blocks the game writes are kept in an overlay, saved in a
+//   file of its own (encode_writes / decode_writes).
+// - ares stamps the disk ID's manufacture line and time with the current time and a random byte
+//   each time an image is loaded (to tell copies apart when swapping). Not done here: the disk
+//   reads as dumped, every time, so a run is reproducible.
+
+use std::collections::BTreeMap;
+
+/// The retail dump format (Mupen64Plus, ares, converted MAME dumps): the 0x10DC logical blocks in
+/// LBA order.
+pub const NDD_SIZE: usize = 0x3DEC800;
+/// The physical layout (MAME's raw format, ares' own): every track of both heads in order.
+pub const PHYSICAL_SIZE: usize = 0x435B0C0;
+/// The development format (.d64): a 0x200 header, then the ROM and RAM areas' blocks.
+const D64_MIN: usize = 0x4F08;
+const D64_END: usize = 0x3D79140;
+
+pub const TRACKS: u32 = 1175; // per head
+/// Physical blocks: 2 heads x 1175 tracks x 2 blocks; the index of ares' error table
+pub const BLOCKS: usize = 2 * TRACKS as usize * 2;
+pub const LBAS: u32 = 0x10DC;
+const SYSTEM_BLOCKS: [usize; 4] = [0, 1, 8, 9];
+const DISK_ID_BLOCKS: [usize; 2] = [14, 15];
+const SECTORS_PER_BLOCK: usize = 85;
+
+const BLOCK_SIZE: [u32; 9] = [
+    0x4D08, 0x47B8, 0x4510, 0x3FC0, 0x3A70, 0x3520, 0x2FD0, 0x2A80, 0x2530,
+];
+/// Block size per physical zone (head 0: zones 0-7, head 1: zones 8-15), drive.cpp's table
+const ZONE_BLOCK_SIZE: [u32; 16] = [
+    0x4D08, 0x47B8, 0x4510, 0x3FC0, 0x3A70, 0x3520, 0x2FD0, 0x2A80, 0x47B8, 0x4510, 0x3FC0, 0x3A70,
+    0x3520, 0x2FD0, 0x2A80, 0x2530,
+];
+/// Where each physical zone starts in the physical layout
+const ZONE_START: [u32; 16] = [
+    0x0, 0x5F15E0, 0xB79D00, 0x10801A0, 0x1523720, 0x1963D80, 0x1D414C0, 0x20BBCE0, 0x23196E0,
+    0x28A1E00, 0x2DF5DC0, 0x3299340, 0x36D99A0, 0x3AB70E0, 0x3E31900, 0x4149200,
+];
+/// The first track of each zone (both heads), and for zones 8-15 the track a head-1 zone's
+/// logical blocks start from (head 1 is read from its outer track inwards)
+const TRACK_PHYSICAL: [u32; 16] = [
+    0x000, 0x09E, 0x13C, 0x1D1, 0x266, 0x2FB, 0x390, 0x425, 0x091, 0x12F, 0x1C4, 0x259, 0x2EE,
+    0x383, 0x418, 0x48A,
+];
+const VZONE_LBA: [[u16; 16]; 7] = [
+    [
+        0x0124, 0x0248, 0x035A, 0x047E, 0x05A2, 0x06B4, 0x07C6, 0x08D8, 0x09EA, 0x0AB6, 0x0B82,
+        0x0C94, 0x0DA6, 0x0EB8, 0x0FCA, 0x10DC,
+    ],
+    [
+        0x0124, 0x0248, 0x035A, 0x046C, 0x057E, 0x06A2, 0x07C6, 0x08D8, 0x09EA, 0x0AFC, 0x0BC8,
+        0x0C94, 0x0DA6, 0x0EB8, 0x0FCA, 0x10DC,
+    ],
+    [
+        0x0124, 0x0248, 0x035A, 0x046C, 0x057E, 0x0690, 0x07A2, 0x08C6, 0x09EA, 0x0AFC, 0x0C0E,
+        0x0CDA, 0x0DA6, 0x0EB8, 0x0FCA, 0x10DC,
+    ],
+    [
+        0x0124, 0x0248, 0x035A, 0x046C, 0x057E, 0x0690, 0x07A2, 0x08B4, 0x09C6, 0x0AEA, 0x0C0E,
+        0x0D20, 0x0DEC, 0x0EB8, 0x0FCA, 0x10DC,
+    ],
+    [
+        0x0124, 0x0248, 0x035A, 0x046C, 0x057E, 0x0690, 0x07A2, 0x08B4, 0x09C6, 0x0AD8, 0x0BEA,
+        0x0D0E, 0x0E32, 0x0EFE, 0x0FCA, 0x10DC,
+    ],
+    [
+        0x0124, 0x0248, 0x035A, 0x046C, 0x057E, 0x0690, 0x07A2, 0x086E, 0x0980, 0x0A92, 0x0BA4,
+        0x0CB6, 0x0DC8, 0x0EEC, 0x1010, 0x10DC,
+    ],
+    [
+        0x0124, 0x0248, 0x035A, 0x046C, 0x057E, 0x0690, 0x07A2, 0x086E, 0x093A, 0x0A4C, 0x0B5E,
+        0x0C70, 0x0D82, 0x0E94, 0x0FB8, 0x10DC,
+    ],
+];
+const VZONE_TO_PZONE: [[u8; 16]; 7] = [
+    [
+        0x0, 0x1, 0x2, 0x9, 0x8, 0x3, 0x4, 0x5, 0x6, 0x7, 0xF, 0xE, 0xD, 0xC, 0xB, 0xA,
+    ],
+    [
+        0x0, 0x1, 0x2, 0x3, 0xA, 0x9, 0x8, 0x4, 0x5, 0x6, 0x7, 0xF, 0xE, 0xD, 0xC, 0xB,
+    ],
+    [
+        0x0, 0x1, 0x2, 0x3, 0x4, 0xB, 0xA, 0x9, 0x8, 0x5, 0x6, 0x7, 0xF, 0xE, 0xD, 0xC,
+    ],
+    [
+        0x0, 0x1, 0x2, 0x3, 0x4, 0x5, 0xC, 0xB, 0xA, 0x9, 0x8, 0x6, 0x7, 0xF, 0xE, 0xD,
+    ],
+    [
+        0x0, 0x1, 0x2, 0x3, 0x4, 0x5, 0x6, 0xD, 0xC, 0xB, 0xA, 0x9, 0x8, 0x7, 0xF, 0xE,
+    ],
+    [
+        0x0, 0x1, 0x2, 0x3, 0x4, 0x5, 0x6, 0x7, 0xE, 0xD, 0xC, 0xB, 0xA, 0x9, 0x8, 0xF,
+    ],
+    [
+        0x0, 0x1, 0x2, 0x3, 0x4, 0x5, 0x6, 0x7, 0xF, 0xE, 0xD, 0xC, 0xB, 0xA, 0x9, 0x8,
+    ],
+];
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Format {
+    Ndd,
+    Physical,
+    D64,
+}
+
+impl Format {
+    pub fn name(self) -> &'static str {
+        match self {
+            Format::Ndd => "NDD",
+            Format::Physical => "physical (MAME raw)",
+            Format::D64 => "D64",
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Region {
+    Japan,
+    Usa,
+    Development,
+}
+
+impl Region {
+    pub fn name(self) -> &'static str {
+        match self {
+            Region::Japan => "NTSC-J",
+            Region::Usa => "NTSC-U",
+            Region::Development => "NTSC-DEV",
+        }
+    }
+}
+
+/// Where a physical block's bytes are
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Source {
+    None, // not on the medium: reads as zeros, as in ares' converted image
+    Image(u32),
+    Synth(u32),
+}
+
+/// The physical zone (0-7 head 0, 8-15 head 1) of a track (drive.cpp seekSector)
+pub fn physical_zone(head: u32, track: u32) -> usize {
+    let mut zone = 0;
+    for start in &TRACK_PHYSICAL[1..8] {
+        if track >= *start {
+            zone += 1;
+        }
+    }
+    zone + if head != 0 { 8 } else { 0 }
+}
+
+/// The size of the blocks of a track, in bytes (85 user sectors)
+pub fn block_size(head: u32, track: u32) -> u32 {
+    ZONE_BLOCK_SIZE[physical_zone(head, track)]
+}
+
+/// Where a block is in the physical layout (drive.cpp seekSector, without the sector)
+pub fn physical_offset(head: u32, track: u32, block: u32) -> u32 {
+    let zone = physical_zone(head, track);
+    let size = ZONE_BLOCK_SIZE[zone];
+    ZONE_START[zone] + size * 2 * (track - TRACK_PHYSICAL[zone % 8]) + size * block
+}
+
+/// A physical block's index (ares' error table index: head * 2350 + track * 2 + block)
+pub fn block_index(head: u32, track: u32, block: u32) -> usize {
+    (head * TRACKS * 2 + track * 2 + block) as usize
+}
+
+pub fn block_from_index(index: usize) -> (u32, u32, u32) {
+    let index = index as u32;
+    (index / (TRACKS * 2), (index % (TRACKS * 2)) / 2, index & 1)
+}
+
+pub fn block_size_of_index(index: usize) -> u32 {
+    let (head, track, _) = block_from_index(index);
+    block_size(head, track)
+}
+
+/// Whether a track is in the disk type's ROM (read-only) area (drive.cpp seekTrack)
+pub fn is_rom_area(disk_type: u8, head: u32, track: u32) -> bool {
+    let mut zone: u32 = 0;
+    for start in &TRACK_PHYSICAL[1..8] {
+        if track >= *start {
+            zone += 1;
+        }
+    }
+    zone += head;
+    zone <= disk_type as u32 + 2
+}
+
+/// Where a logical block is on the disk: (head, track, block), for a disk type (0-6) and the
+/// system area's format data (its zone defect counts at 0x08 and defect tracks at 0x20).
+/// The conversion loop of ares' Nintendo64DD::transform.
+pub fn lba_to_physical(disk_type: usize, lba: u32, format: &[u8]) -> (u32, u32, u32) {
+    let table = &VZONE_LBA[disk_type];
+    let vzone = table.iter().filter(|start| lba >= **start as u32).count();
+    let pzone = VZONE_TO_PZONE[disk_type][vzone] as usize;
+    let head = u32::from(pzone > 7);
+    let lba_vzone = if vzone > 0 {
+        lba - table[vzone - 1] as u32
+    } else {
+        lba
+    };
+    let track_start = TRACK_PHYSICAL[if head != 0 { pzone - 8 } else { pzone }];
+    let mut track = TRACK_PHYSICAL[pzone];
+    if head != 0 {
+        track -= lba_vzone >> 1;
+    } else {
+        track += lba_vzone >> 1;
+    }
+    let byte = |i: usize| u32::from(format.get(i).copied().unwrap_or(0));
+    let mut defect_offset = if pzone > 0 { byte(8 + pzone - 1) } else { 0 };
+    // (ares subtracts unsigned; a malformed table that would wrap is taken as no defects)
+    let mut defect_amount = byte(8 + pzone).saturating_sub(defect_offset);
+    while defect_amount != 0 {
+        let Some(defect) = format.get(0x20 + defect_offset as usize) else {
+            break;
+        };
+        if u32::from(*defect) + track_start > track {
+            break;
+        }
+        track += 1;
+        defect_offset += 1;
+        defect_amount -= 1;
+    }
+    let block = if lba & 3 == 0 || lba & 3 == 3 { 0 } else { 1 };
+    (head, track, block)
+}
+
+fn lba_size(disk_type: usize, lba: u32) -> u32 {
+    let table = &VZONE_LBA[disk_type];
+    let vzone = table.iter().filter(|start| lba >= **start as u32).count();
+    let pzone = VZONE_TO_PZONE[disk_type][vzone] as usize;
+    BLOCK_SIZE[if pzone > 7 { pzone - 7 } else { pzone }]
+}
+
+fn repeat_check(input: &[u8], repeat: usize, size: usize) -> bool {
+    (0..size).all(|i| (0..repeat).all(|j| input.get(i) == input.get(j * size + i)))
+}
+
+fn detect_format(size: usize) -> Option<Format> {
+    if size == NDD_SIZE {
+        Some(Format::Ndd)
+    } else if size == PHYSICAL_SIZE {
+        Some(Format::Physical)
+    } else if (D64_MIN..D64_END).contains(&size) {
+        Some(Format::D64)
+    } else {
+        None
+    }
+}
+
+/// The ROM and RAM areas' LBAs a .d64 holds (absolute, the system area's 24 included)
+fn d64_ranges(input: &[u8]) -> Option<(u32, u32, u32, u32)> {
+    let rom_start = 24;
+    let rom_end = ((input[0xE0] as u32) << 8) + input[0xE1] as u32 + 24;
+    let mut ram_start = ((input[0xE2] as u32) << 8) + input[0xE3] as u32;
+    let mut ram_end = ((input[0xE4] as u32) << 8) + input[0xE5] as u32;
+    if (ram_start == 0xFFFF) != (ram_end == 0xFFFF) {
+        return None;
+    }
+    if ram_start != 0xFFFF {
+        ram_start += 24;
+        ram_end += 24;
+    }
+    Some((rom_start, rom_end, ram_start, ram_end))
+}
+
+fn d64_copied(lba: u32, (rom_start, rom_end, ram_start, ram_end): (u32, u32, u32, u32)) -> bool {
+    !(lba < rom_start || (lba > rom_end && lba < ram_start) || lba > ram_end)
+}
+
+/// ares' sizeCheck for a .d64: the header's areas must account for the file exactly
+fn d64_size_check(input: &[u8]) -> bool {
+    let disk_type = input[0x05] as usize;
+    if disk_type >= 7 {
+        return false;
+    }
+    let Some(ranges) = d64_ranges(input) else {
+        return false;
+    };
+    let mut size: usize = 0x200;
+    for lba in 0..LBAS {
+        if d64_copied(lba, ranges) {
+            size += lba_size(disk_type, lba) as usize;
+        }
+    }
+    input.len() == size
+}
+
+/// ares' createErrorTable: which physical blocks read with errors. The system area's copies that
+/// fail the check are marked; a retail disk also has block 12 marked (its copy protection: the
+/// IPL expects that read to fail). Empty for an image that is not a 64DD disk.
+fn error_table(input: &[u8], format: Format) -> Option<Vec<u8>> {
+    let mut output = vec![0u8; BLOCKS];
+    let block0 = BLOCK_SIZE[0] as usize;
+    output[12] = 0;
+    if format == Format::Ndd || format == Format::Physical {
+        for &block in &SYSTEM_BLOCKS {
+            let offset = block * block0;
+            output[block] = 1;
+            let b = &input[offset..offset + block0];
+            if b[0] != 0xE8 && b[0] != 0x22 {
+                continue;
+            }
+            if b[1] != 0x48 && b[1] != 0x63 {
+                continue;
+            }
+            if b[2] != 0xD3 && b[2] != 0xEE {
+                continue;
+            }
+            if b[3] != 0x16 && b[3] != 0x56 {
+                continue;
+            }
+            if b[4] != 0x10 || b[5] < 0x10 || b[5] >= 0x17 {
+                continue;
+            }
+            if b[0x18..0x1C] != [0xFF; 4] || b[0x1C] != 0x80 {
+                continue;
+            }
+            if !repeat_check(&b[..0xE8 * 0x55], 0x55, 0xE8) {
+                continue;
+            }
+            output[block] = 0;
+            // confirmed retail: block 12 reads with an error
+            output[12] = 1;
+        }
+        if output[12] == 0 {
+            // not retail: a development disk?
+            for &block in &SYSTEM_BLOCKS {
+                let source = if format == Format::Ndd {
+                    (block + 2) ^ 1
+                } else {
+                    block + 2
+                };
+                let offset = source * block0;
+                output[block + 2] = 1;
+                let b = &input[offset..offset + block0];
+                if b[0..4] != [0; 4] {
+                    continue;
+                }
+                if b[4] != 0x10 || b[5] < 0x10 || b[5] >= 0x17 {
+                    continue;
+                }
+                if b[0x18..0x1C] != [0xFF; 4] || b[0x1C] != 0x80 {
+                    continue;
+                }
+                if !repeat_check(&b[..0xC0 * 0x55], 0x55, 0xC0) {
+                    continue;
+                }
+                output[block + 2] = 0;
+            }
+        }
+    } else {
+        // a .d64 is taken as a development disk
+        output[12] = 0;
+        for &block in &SYSTEM_BLOCKS {
+            output[block] = 1;
+            output[block + 2] = 0;
+        }
+        for (n, byte) in input[..0x200].iter().enumerate() {
+            let skipped = matches!(n, 0x005..=0x007 | 0x01C..=0x01F | 0x0E0..=0x0E5 | 0x1E8)
+                || (0x100..0x120).contains(&n);
+            if !skipped && *byte != 0 {
+                return None;
+            }
+        }
+        if input[0x005] >= 0x07
+            || input[0x006] >= 0x02
+            || input[0x01C] != 0x80
+            || input[0x01D] >= 0x80
+            || input[0x0E0] > 0x10
+            || (input[0x0E2] > 0x10 && input[0x0E2] < 0xFF)
+            || (input[0x0E4] > 0x10 && input[0x0E4] < 0xFF)
+        {
+            return None;
+        }
+    }
+
+    for &block in &DISK_ID_BLOCKS {
+        if format == Format::D64 {
+            output[block] = 0;
+        } else {
+            let offset = block * block0;
+            output[block] = u8::from(!repeat_check(
+                &input[offset..offset + 0xE8 * 0x55],
+                0x55,
+                0xE8,
+            ));
+        }
+    }
+    Some(output)
+}
+
+/// A 64DD disk: the user's image (never written) and how the drive sees it
+pub struct Disk {
+    pub format: Format,
+    pub region: Region,
+    /// the disk ID's game code (4 characters, as in the disk ID block; unprintable bytes as '_')
+    pub id: String,
+    /// the system area's disk type (0-6)
+    pub disk_type: u8,
+    /// SHA-256 of the image file, upper-case hex (names the writes file, checks a state)
+    pub hash: String,
+    image: Vec<u8>,
+    synth: Vec<u8>,
+    map: Vec<Source>,
+    /// per physical block: nonzero when it reads with C1 errors (ares' error table)
+    pub error: Vec<u8>,
+}
+
+impl Disk {
+    /// Recognise and map an image (NDD, physical or D64, by size, then by content)
+    pub fn parse(image: Vec<u8>) -> Result<Disk, String> {
+        let Some(format) = detect_format(image.len()) else {
+            return Err(format!(
+                "not a 64DD disk image ({} bytes; NDD is {NDD_SIZE}, the physical layout {PHYSICAL_SIZE}, D64 between {D64_MIN} and {D64_END})",
+                image.len()
+            ));
+        };
+        if format == Format::D64 && !d64_size_check(&image) {
+            return Err(
+                "not a 64DD disk image (a .d64 whose header does not match its size)".into(),
+            );
+        }
+        let Some(error) = error_table(&image, format) else {
+            return Err("not a 64DD disk image (a .d64 with an invalid header)".into());
+        };
+        let dev = error[12] == 0;
+        let block0 = BLOCK_SIZE[0] as usize;
+
+        // the system data used for the conversion (transform)
+        let mut system_offset = None;
+        match format {
+            Format::Ndd => {
+                for &block in [9usize, 8, 1, 0].iter() {
+                    if dev {
+                        if error[block + 2] == 0 {
+                            system_offset = Some(((block + 2) ^ 1) * block0);
+                        }
+                    } else if error[block] == 0 {
+                        system_offset = Some(block * block0);
+                    }
+                }
+                if system_offset.is_none() {
+                    return Err("not a usable 64DD disk image (no valid system area)".into());
+                }
+            }
+            Format::Physical => {
+                // copied as it is; the system data is only read for the log
+                for &block in [9usize, 8, 1, 0].iter() {
+                    let block = if dev { block + 2 } else { block };
+                    if error[block] == 0 {
+                        system_offset = Some(block * block0);
+                    }
+                }
+            }
+            Format::D64 => system_offset = Some(0),
+        }
+        let format_data: Vec<u8> = system_offset
+            .map(|offset| image[offset..offset + 0xE8].to_vec())
+            .unwrap_or_else(|| vec![0; 0xE8]);
+        let disk_type = format_data[5] & 0xF;
+        if format != Format::Physical && disk_type >= 7 {
+            return Err(format!(
+                "not a usable 64DD disk image (disk type {disk_type})"
+            ));
+        }
+
+        let mut map = vec![Source::None; BLOCKS];
+        let mut synth = Vec::new();
+        match format {
+            Format::Physical => {
+                for (index, source) in map.iter_mut().enumerate() {
+                    let (head, track, block) = block_from_index(index);
+                    *source = Source::Image(physical_offset(head, track, block));
+                }
+            }
+            Format::Ndd => {
+                let mut position: u32 = 0;
+                for lba in 0..LBAS {
+                    let (head, track, block) =
+                        lba_to_physical(disk_type as usize, lba, &format_data);
+                    if track < TRACKS {
+                        map[block_index(head, track, block)] = Source::Image(position);
+                    }
+                    position += lba_size(disk_type as usize, lba);
+                }
+            }
+            Format::D64 => {
+                // the system area and the disk ID, as ares makes them
+                let copy = if dev { 0xC0 } else { 0xE8 };
+                for &block in &SYSTEM_BLOCKS {
+                    let mut sector = format_data[..copy].to_vec();
+                    sector[0x004] = 0x10;
+                    sector[0x005] = sector[0x005].wrapping_add(0x10);
+                    let start = synth.len() as u32;
+                    for _ in 0..SECTORS_PER_BLOCK {
+                        synth.extend_from_slice(&sector);
+                    }
+                    synth.resize(start as usize + block0, 0);
+                    map[block + if dev { 2 } else { 0 }] = Source::Synth(start);
+                }
+                for &block in &DISK_ID_BLOCKS {
+                    let start = synth.len() as u32;
+                    let sector = &image[0x100..0x100 + block0 / SECTORS_PER_BLOCK];
+                    for _ in 0..SECTORS_PER_BLOCK {
+                        synth.extend_from_slice(sector);
+                    }
+                    map[block] = Source::Synth(start);
+                }
+                let ranges = d64_ranges(&image).expect("checked by d64_size_check");
+                let mut position: u32 = 0x200;
+                for lba in 0..LBAS {
+                    if !d64_copied(lba, ranges) {
+                        continue;
+                    }
+                    let (head, track, block) =
+                        lba_to_physical(disk_type as usize, lba, &format_data);
+                    if track < TRACKS {
+                        map[block_index(head, track, block)] = Source::Image(position);
+                    }
+                    position += lba_size(disk_type as usize, lba);
+                }
+            }
+        }
+
+        // analyze: the region and the disk ID
+        let mut region = Region::Japan;
+        for &block in &SYSTEM_BLOCKS {
+            if dev {
+                if error[block + 2] != 0 {
+                    continue;
+                }
+                region = Region::Development;
+            } else {
+                if error[block] != 0 {
+                    continue;
+                }
+                region = if image[block * block0] == 0xE8 {
+                    Region::Japan
+                } else {
+                    Region::Usa
+                };
+            }
+            break;
+        }
+        let mut id = String::new();
+        for &block in &DISK_ID_BLOCKS {
+            if error[block] != 0 {
+                continue;
+            }
+            let offset = if format == Format::D64 {
+                0x100
+            } else {
+                block * block0
+            };
+            id = image[offset..offset + 4]
+                .iter()
+                .map(|&c| {
+                    if c.is_ascii_alphanumeric() {
+                        c as char
+                    } else {
+                        '_'
+                    }
+                })
+                .collect();
+            break;
+        }
+        if id.is_empty() {
+            id = String::from("____");
+        }
+
+        let hash = crate::device::cart::rom::calculate_hash(&image);
+        Ok(Disk {
+            format,
+            region,
+            id,
+            disk_type,
+            hash,
+            image,
+            synth,
+            map,
+            error,
+        })
+    }
+
+    #[cfg(test)]
+    fn base(&self, index: usize, offset: u32) -> u8 {
+        let at = |data: &[u8], start: u32| *data.get((start + offset) as usize).unwrap_or(&0);
+        match self.map[index] {
+            Source::None => 0,
+            Source::Image(start) => at(&self.image, start),
+            Source::Synth(start) => at(&self.synth, start),
+        }
+    }
+
+    /// A byte of a physical block, the game's writes first
+    #[cfg(test)]
+    pub fn read(&self, overlay: &BTreeMap<u32, Vec<u8>>, index: usize, offset: u32) -> u8 {
+        if index >= BLOCKS || offset >= block_size_of_index(index) {
+            return 0;
+        }
+        if let Some(block) = overlay.get(&(index as u32)) {
+            return block[offset as usize];
+        }
+        self.base(index, offset)
+    }
+
+    /// Bytes of a physical block from `offset` on, into `out` (a sector; zeros past the block)
+    pub fn read_into(
+        &self,
+        overlay: &BTreeMap<u32, Vec<u8>>,
+        index: usize,
+        offset: u32,
+        out: &mut [u8],
+    ) {
+        out.fill(0);
+        if index >= BLOCKS {
+            return;
+        }
+        let size = block_size_of_index(index) as usize;
+        let start = (offset as usize).min(size);
+        let end = (start + out.len()).min(size);
+        let n = end - start;
+        if let Some(block) = overlay.get(&(index as u32)) {
+            out[..n].copy_from_slice(&block[start..end]);
+            return;
+        }
+        let (data, base) = match self.map[index] {
+            Source::None => return,
+            Source::Image(base) => (&self.image, base as usize),
+            Source::Synth(base) => (&self.synth, base as usize),
+        };
+        let from = (base + start).min(data.len());
+        let to = (base + end).min(data.len());
+        out[..to - from].copy_from_slice(&data[from..to]);
+    }
+
+    /// Write bytes of a physical block from `offset` on (a sector; what passes the block's end is
+    /// dropped): into the overlay, the image stays as it is
+    pub fn write_from(
+        &self,
+        overlay: &mut BTreeMap<u32, Vec<u8>>,
+        index: usize,
+        offset: u32,
+        data: &[u8],
+    ) {
+        if index >= BLOCKS {
+            return;
+        }
+        let size = block_size_of_index(index) as usize;
+        let start = (offset as usize).min(size);
+        let end = (start + data.len()).min(size);
+        if start == end {
+            return;
+        }
+        let block = overlay.entry(index as u32).or_insert_with(|| {
+            let mut block = vec![0; size];
+            self.read_into(&BTreeMap::new(), index, 0, &mut block);
+            block
+        });
+        block[start..end].copy_from_slice(&data[..end - start]);
+    }
+
+    /// Write a byte of a physical block: into the overlay, the image stays as it is
+    #[cfg(test)]
+    pub fn write(
+        &self,
+        overlay: &mut BTreeMap<u32, Vec<u8>>,
+        index: usize,
+        offset: u32,
+        value: u8,
+    ) {
+        if index >= BLOCKS || offset >= block_size_of_index(index) {
+            return;
+        }
+        let block = overlay.entry(index as u32).or_insert_with(|| {
+            (0..block_size_of_index(index))
+                .map(|i| self.base(index, i))
+                .collect()
+        });
+        block[offset as usize] = value;
+    }
+}
+
+/// The writes file (the blocks the game wrote; the image is never changed), little-endian:
+///
+/// | offset | size | contents |
+/// | --- | --- | --- |
+/// | 0 | 8 | `PSG64DDW` |
+/// | 8 | 4 | version, 1 |
+/// | 12 | 4 | number of blocks N |
+/// | 16 | 32 | SHA-256 of the disk image the writes belong to |
+/// | 48 | ... | N records: block index (u32: head * 2350 + track * 2 + block), length (u32, the block's size), the block's bytes |
+///
+/// A block's record is the whole block as the game left it; on start it replaces that block of
+/// the image.
+pub const WRITES_MAGIC: &[u8; 8] = b"PSG64DDW";
+const WRITES_VERSION: u32 = 1;
+
+fn hash_bytes(hash: &str) -> [u8; 32] {
+    let mut bytes = [0u8; 32];
+    for (i, byte) in bytes.iter_mut().enumerate() {
+        *byte = hash
+            .get(i * 2..i * 2 + 2)
+            .and_then(|hex| u8::from_str_radix(hex, 16).ok())
+            .unwrap_or(0);
+    }
+    bytes
+}
+
+pub fn encode_writes(hash: &str, overlay: &BTreeMap<u32, Vec<u8>>) -> Vec<u8> {
+    let mut out = Vec::with_capacity(48 + overlay.values().map(|b| b.len() + 8).sum::<usize>());
+    out.extend_from_slice(WRITES_MAGIC);
+    out.extend_from_slice(&WRITES_VERSION.to_le_bytes());
+    out.extend_from_slice(&(overlay.len() as u32).to_le_bytes());
+    out.extend_from_slice(&hash_bytes(hash));
+    for (index, block) in overlay {
+        out.extend_from_slice(&index.to_le_bytes());
+        out.extend_from_slice(&(block.len() as u32).to_le_bytes());
+        out.extend_from_slice(block);
+    }
+    out
+}
+
+pub fn decode_writes(data: &[u8], hash: &str) -> Result<BTreeMap<u32, Vec<u8>>, String> {
+    let word = |at: usize| -> Result<u32, String> {
+        data.get(at..at + 4)
+            .map(|b| u32::from_le_bytes(b.try_into().unwrap()))
+            .ok_or_else(|| "truncated".to_string())
+    };
+    if data.len() < 48 || &data[..8] != WRITES_MAGIC {
+        return Err("not a 64DD writes file".into());
+    }
+    let version = word(8)?;
+    if version != WRITES_VERSION {
+        return Err(format!(
+            "writes file version {version}, not {WRITES_VERSION}"
+        ));
+    }
+    if data[16..48] != hash_bytes(hash) {
+        return Err("the writes file belongs to another disk image".into());
+    }
+    let count = word(12)? as usize;
+    let mut overlay = BTreeMap::new();
+    let mut at = 48;
+    for _ in 0..count {
+        let index = word(at)?;
+        let length = word(at + 4)? as usize;
+        at += 8;
+        let Some(block) = data.get(at..at + length) else {
+            return Err("truncated".into());
+        };
+        at += length;
+        if (index as usize) < BLOCKS && length == block_size_of_index(index as usize) as usize {
+            overlay.insert(index, block.to_vec());
+        } else {
+            return Err(format!("a record for block {index} of {length} bytes"));
+        }
+    }
+    Ok(overlay)
+}
