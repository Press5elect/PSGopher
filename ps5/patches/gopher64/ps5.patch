+        let unmapped: Read = device::unmapped::read_mem;
+        for page in [0x0500, 0x0600, 0x063F] {
+            assert!(std::ptr::fn_addr_eq(
+                device.memory.memory_map_read[page],
+                unmapped
+            ));
+        }
+        assert!(pi_handlers(&device, 0x0500_0000).is_none());
+        init(&mut device);
+        start(&mut device);
+        assert!(!device.cpu.events[EVENT_TYPE_DD_CLOCK].enabled);
+        assert!(state_entry(&device.dd, &device).is_none());
