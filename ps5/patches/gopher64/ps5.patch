+/// The CPU's events in a save state's "device" entry: Gopher64's own (the first
+/// EVENT_TYPE_SAVED_COUNT), serialized as the array they were, so states stay as they were; the
+/// 64DD's are kept in the state's "dd" entry and read back as off here.
+pub fn serialize_events<S: serde::Serializer>(
+    events: &[Event; EVENT_TYPE_COUNT],
+    serializer: S,
+) -> Result<S::Ok, S::Error> {
+    use serde::ser::SerializeTuple;
+    let mut tuple = serializer.serialize_tuple(EVENT_TYPE_SAVED_COUNT)?;
+    for event in &events[..EVENT_TYPE_SAVED_COUNT] {
+        tuple.serialize_element(event)?;
+    }
+    tuple.end()
